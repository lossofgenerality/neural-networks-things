Cell["\<\
One decision of the controller, written out: the hidden layer multiplies the \
8 \[Times] 4 matrix W by the scaled state, adds the 8 biases and applies \
\[Sigma]; the output layer multiplies the 1 \[Times] 8 row W by these 8 \
values. The network's force is within 0.01 N of the teacher's.\
\>", "Text",ExpressionUUID->"45bbc54d-bba0-4ad9-b63e-b0daa3705777"],

Cell["\<\
Table 11b. The trained controller as matrix products, for the start state of \
Table 11 (stick tilted 17\[Degree]).\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"276dd99e-e20d-4c33-bbaa-eec12fbc19cf"],

Cell[CellGroupData[{

Cell["\<\
(*c.19c*)
(* one decision of the trained controller, in matrices: the start
   state of Table 11, tilted 17\[Degree]. W1 is 8\[Times]4 (8 hidden neurons \
\[Times] 4
   inputs), W2 is 1\[Times]8 *)
{{W1c, b1c}, {W2c, b2c}} = histC[[-1, 3]];
sIn = s0/scale;                       (* scaled input, 4\[Times]1 *)
z1c = W1c . sIn + b1c; h1c = LogisticSigmoid[z1c];
z2c = W2c . h1c + b2c;
mtable[{
   {\"scaled state s/scale = (x, v, \[Theta], \[Omega])/(1, 2, 0.5, 2)\", \
col[sIn]},
   {\"hidden layer:  z = W s + b\", Row[{mat[W1c], \" \", col[sIn], \" + \",
      col[b1c], \" = \", col[z1c]}]},
   {\"h = \[Sigma](z)\", Row[{\"\[Sigma]\", col[z1c], \" = \", col[h1c]}]},
   {\"output layer:  W h + b\", Row[{mat[W2c], \" \", col[h1c], \" + \",
      col[b2c], \" = \", col[z2c]}]},
   {\"force u = 10 \[Times] output\", Row[{NumberForm[10 First[z2c], 3],
      \" N   (the teacher would push \", NumberForm[teacher[s0], 3],
      \" N)\"}]}},
 \"Table 11b. One decision of the controller as matrix products\"]\
\>", "Input",ExpressionUUID->"a705ee65-045e-4411-8adb-5b661ddb932e"],

