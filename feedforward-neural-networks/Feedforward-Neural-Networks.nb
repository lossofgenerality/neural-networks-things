                GrayLevel[0], Background -> GrayLevel[1], StripOnInput -> 
                False], TraditionalForm], {1.08, -0.275}]}}}}, {{{
            EdgeForm[
             GrayLevel[0]], 
            GrayLevel[1], 
            RectangleBox[{-0.22, 0.28}, {0.22, 0.72}], 
            GrayLevel[0], 
            InsetBox[
             FormBox[
              StyleBox[
               SubscriptBox["\"x\"", "1"], 12, StripOnInput -> False], 
              TraditionalForm], {-0.45, 0.5}, 
             NCache[
              ImageScaled[{1, 
                Rational[1, 2]}], 
              ImageScaled[{1, 0.5}]]]}, {
            EdgeForm[
             GrayLevel[0]], 
            GrayLevel[1], 
            RectangleBox[{-0.22, -0.72}, {0.22, -0.28}], 
            GrayLevel[0], 
            InsetBox[
             FormBox[
              StyleBox[
               SubscriptBox["\"x\"", "2"], 12, StripOnInput -> False], 
              TraditionalForm], {-0.45, -0.5}, 
             NCache[
              ImageScaled[{1, 
                Rational[1, 2]}], 
              ImageScaled[{1, 0.5}]]]}}, {{
