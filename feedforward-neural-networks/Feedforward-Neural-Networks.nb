Cell[CellGroupData[{

Cell["0. Settings", "Section",ExpressionUUID->"6b8ad6c1-d3a0-483c-8112-5b8cda789adc"],

Cell["\<\
Font sizes and widths for every figure and table, so that the notebook also \
prints well on A4 paper.\
\>", "Text",ExpressionUUID->"1a0ab8ba-c571-4052-ac08-a4b54b10a9e0"],

Cell["\<\
(*c.0*)
figFont = 14;   (* font size in figures and diagrams *)
tabFont = 10;   (* font size in tables *)
wFull = 440;    (* full figure width in points; A4 text width is ~487 *)
wHalf = 215;    (* width of each panel in a two-column figure *)
figStyle = Directive[Black, FontSize -> figFont];
table[rows_, label_] := Labeled[
   Grid[rows, Frame -> All, Alignment -> Left,
    BaseStyle -> {FontSize -> tabFont}, Spacings -> {0.8, 0.5},
    Background -> {None, {1 -> GrayLevel[0.92]}}],
   Style[label, Bold, FontSize -> tabFont + 1], Top];
panel[opts___] :=
  Sequence[opts, LabelStyle -> figStyle, ImageSize -> wHalf];
figure[rows_, label_] := Labeled[Grid[rows], Style[label, figFont], Top];
sci[x_] := ScientificForm[x, 2];
(* reference lines and labels on log-log plots, given in plot units *)
logLine[pts_] := {Gray, Dashed, Line[Log[N[pts]]]};
logText[str_, pt_] := Text[Style[str, figFont - 2, Gray], Log[N[pt]]];
(* a diagram of any network: layer sizes, the weights (or None), labels
   for the inputs and outputs, and the symbol drawn in the output
   neurons. Red lines are positive weights, blue negative, and the
   thickness shows the size of the weight *)
netDiagram[sizes_, net_, inL_, outL_, outSym_, title_] := Module[
   {L = Length[sizes], pos, wmax, few, edges, nodes},
   pos[l_, i_] := {2.4 (l - 1), (sizes[[l]] + 1)/2. - i};
   wmax = If[net === None, 1, Max[10.^-9, Abs@Flatten[net[[All, 1]]]]];
   few = Total[Most[sizes] Rest[sizes]] <= 6 && net =!= None;
   edges = Table[With[{w = If[net === None, 1, net[[l, 1, j, i]]],
       p = pos[l, i], q = pos[l + 1, j]},
      {If[net === None, GrayLevel[0.55], If[w > 0,
         RGBColor[0.85, 0.2, 0.1], RGBColor[0.1, 0.35, 0.85]]],
       AbsoluteThickness[If[net === None, 1.2,
         0.5 + 4 Abs[w]/wmax]], Line[{p, q}],
       If[few, Text[Style[NumberForm[w, 3], figFont - 4, Black,
          Background -> White], 0.55 p + 0.45 q], {}]}],
     {l, L - 1}, {i, sizes[[l]]}, {j, sizes[[l + 1]]}];
   nodes = Table[With[{p = pos[l, i]}, If[l == 1,
       {EdgeForm[Black], White, Rectangle[p - 0.22, p + 0.22], Black,
        Text[Style[inL[[i]], figFont - 2], p - {0.45, 0}, {1, 0}]},
       {EdgeForm[Black], White, Disk[p, 0.3], Black,
        Text[Style[If[l == L, outSym, \"\[Sigma]\"], figFont - 2], p],
        If[l == L, Text[Style[outL[[i]], figFont - 2],
          p + {0.5, 0}, {-1, 0}], {}],
        If[few, Text[Style[Row[{\"b = \", NumberForm[net[[l - 1, 2, i]],
              3]}], figFont - 4, Gray], p - {0, 0.5}], {}]}]],
     {l, L}, {i, sizes[[l]]}];
   (* one scale for every diagram: 42 points per unit *)
   With[{xr = {-1.5, 2.4 (L - 1) + 1.7},
     yr = {-(Max[sizes] - 1)/2 - If[few, 0.85, 0.5],
       (Max[sizes] - 1)/2 + 0.5}},
    Graphics[{edges, nodes}, PlotLabel -> If[title === \"\", None,
       Style[title, figFont]],
     PlotRange -> {xr, yr}, ImageSize -> 42 (xr[[2]] - xr[[1]])]]];
(* matrices and column vectors as they are printed in the matrix-form
   tables: 3 significant digits *)
mat[m_] := MatrixForm[Map[If[NumberQ[#], NumberForm[#, 3], #] &, m,
    {-1}]];
col[v_] := mat[List /@ v];
(* a matrix-form table: each row is {what, formula}, the label printed
   above the formula so that wide matrices fit the page *)
mtable[rows_, label_] := table[Prepend[{Column[{Style[#[[1]], Italic],
        #[[2]]}, Spacings -> 0.6]} & /@ rows, {\"step and matrix form\"}],
   label];\
\>", "Input",ExpressionUUID->"7125b44b-08b3-4a48-a356-95a0d38b6d7a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A first look: one learning step, by hand", "Section",ExpressionUUID->"d06b17d7-6d50-40cc-a01a-182bf4a08c11"],

Cell[TextData[{
 "Before any theory, here is the whole story on the smallest network that has \
every part: one input x, a hidden neuron A, an output neuron B and a target \
y. Each neuron multiplies its input by a weight, adds a bias and applies the \
S-shaped function \[Sigma](z) = 1/(1 + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "z"}]], TraditionalForm]],ExpressionUUID->
  "aa6ddca7-ce9c-40cc-bead-29599783ed5b"],
 "). We take x = 1 and want the output to be y = 1, and we start from weights \
chosen by hand: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "A"], TraditionalForm]],ExpressionUUID->
  "4b194521-b0ac-462d-a994-6079cfa6cc20"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "B"], TraditionalForm]],ExpressionUUID->
  "a52498d1-8a1e-4a47-8b39-1d054ac24a78"],
 " = 0.5 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "A"], TraditionalForm]],ExpressionUUID->
  "44f800cb-58ff-4bd9-9a72-bbb48bdffcb8"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "B"], TraditionalForm]],ExpressionUUID->
  "67f66a88-e1bf-4744-8ebe-04e9ffbafb0e"],
 " = 0. Learning is three passes over this little chain, and every number is \
written out. Each weight here is a 1 \[Times] 1 matrix, so every matrix \
product of the later sections is an ordinary product in this example."
}], "Text",ExpressionUUID->"90378d42-1a88-4cf2-816c-04fa681dd4a2"],

Cell[CellGroupData[{

Cell["Forward: compute the output", "Subsection",ExpressionUUID->"7a4b4cee-50ac-463a-b43e-e0973f8277b0"],

Cell[TextData[{
 "Go from left to right. Each neuron computes its weighted sum z and its \
output a; the output of A is the input of B. The loss L measures how far the \
answer ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "B"], TraditionalForm]],ExpressionUUID->
  "89b89a6c-9ce9-4fda-b826-c9919d0357ce"],
 " is from the target:"
}], "Text",ExpressionUUID->"ce81eeec-d5e8-4099-ae37-1962bfad38eb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["z", "A"], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["w", "A"], " ", "x"}], "+", 
      SubscriptBox["b", "A"]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["a", "A"], "=", 
     RowBox[{"\[Sigma]", "(", 
      SubscriptBox["z", "A"], ")"}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["z", "B"], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["w", "B"], " ", 
       SubscriptBox["a", "A"]}], "+", 
      SubscriptBox["b", "B"]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["a", "B"], "=", 
     RowBox[{"\[Sigma]", "(", 
      SubscriptBox["z", "B"], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"63235d6e-5321-4397-a2b9-8b870b793462"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"L", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "B"], "-", "y"}], ")"}], "2"]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"6a6fc269-fe16-4041-83ce-fb554f0a56cc"],

Cell["\<\
Table 0.1. The forward pass: formula, the numbers put in, and the result.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"d5e917b5-e973-43c2-ad43-efe9c1fd9aa4"],

Cell[CellGroupData[{

Cell["\<\
(*c.0.1*)
(* the smallest network with every part: input x, a hidden neuron A,
   an output neuron B, a target y. All numbers are chosen by hand *)
xIn = 1.; yT = 1.; rate = 1.;          (* input, target, learning rate *)
{wA, bA, wB, bB} = {0.5, 0., 0.5, 0.};  (* starting weights and biases *)
fm[s_String] := Row[StringSplit[s, RegularExpression[\"(\\\\w)_(\\\\w)\"] :>
     Subscript[\"$1\", \"$2\"]]];          (* \"w_A\" -> w with subscript A \
*)
nf[v_] := With[{s = ToString[NumberForm[v, 4]]},
   If[v < 0, \"(\" <> s <> \")\", s]];
(* forward pass, Eqs. (0.1)-(0.2) *)
zA = wA xIn + bA;  aA = LogisticSigmoid[zA];
zB = wB aA + bB;   aB = LogisticSigmoid[zB];
lossAB = (aB - yT)^2/2;
(* each step: {formula, the numbers put in, value} *)
fwd = {
   {\"z_A = w_A x + b_A\", nf[wA] <> \" \[Times] \" <> nf[xIn] <> \" + \" <>
     nf[bA], zA},
   {\"a_A = \[Sigma](z_A)\", \"1/(1 + e^-\" <> nf[zA] <> \")\", aA},
   {\"z_B = w_B a_A + b_B\", nf[wB] <> \" \[Times] \" <> nf[aA] <> \" + \" <>
     nf[bB], zB},
   {\"a_B = \[Sigma](z_B)\", \"1/(1 + e^-\" <> nf[zB] <> \")\", aB},
   {\"L = (a_B - y)\.b2/2\", \"(\" <> nf[aB] <> \" - \" <> nf[yT] <> \
\")\.b2/2\",
    lossAB}};
table[Prepend[MapIndexed[{#2[[1]], fm[#1[[1]]], #1[[2]],
     NumberForm[#1[[3]], 4]} &, fwd],
  {\"step\", \"formula\", \"numbers\", \"value\"}], \"Table 0.1. Forward pass\
\"]\
\>", "Input",ExpressionUUID->"75322070-76f0-420a-bbfa-3084d9da8140"],

