          TagBox[
           GridBox[{{
              RowBox[{
                SubscriptBox["b", "1"], "+", 
                RowBox[{
                  SubscriptBox["x", "1"], " ", 
                  SubscriptBox["w", 
                   RowBox[{"1", ",", "1"}]]}], "+", 
                RowBox[{
                  SubscriptBox["x", "2"], " ", 
                  SubscriptBox["w", 
                   RowBox[{"1", ",", "2"}]]}]}]}, {
              RowBox[{
                SubscriptBox["b", "2"], "+", 
                RowBox[{
