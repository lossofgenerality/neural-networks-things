Cell["\<\
Diagram 3. The trained temperature neuron: weight 180 on C/100, that is 1.8 \
per degree, and bias 32.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"5f9c217d-c8de-47c2-82d3-679c1551ffa5"],

Cell[CellGroupData[{

Cell["\<\
(*c.16b*)
(* the temperature neuron after training: \[CapitalSigma] marks a linear \
output,
   no \[Sigma] is applied *)
figure[{{netDiagram[{1, 1}, histT[[-1, 3]], {\"C/100\"}, {\"F\"}, \"\
\[CapitalSigma]\", \"\"]}},
 \"Diagram 3. The Celsius-Fahrenheit neuron, F = w C/100 + b\"]\
\>", "Input",ExpressionUUID->"522c89ab-4db4-4b0f-8a1a-5cb862ad97cf"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
       GraphicsBox[{{{{{
             RGBColor[0.85, 0.2, 0.1], 
             AbsoluteThickness[4.5], 
             LineBox[{{0., 0.}, {2.4, 0.}}], 
             InsetBox[
              FormBox[
               StyleBox[
                TagBox[
                 InterpretationBox[
                  StyleBox["\"180.\"", ShowStringCharacters -> False], 
                  179.99999999999795`, AutoDelete -> True], 
                 NumberForm[#, 3]& ], 10, 
                GrayLevel[0], Background -> GrayLevel[1], StripOnInput -> 
                False], TraditionalForm], {1.08, 0.}]}}}}, {{{
            EdgeForm[
             GrayLevel[0]], 
            GrayLevel[1], 
            RectangleBox[{-0.22, -0.22}, {0.22, 0.22}], 
            GrayLevel[0], 
            InsetBox[
             FormBox[
              StyleBox["\"C/100\"", 12, StripOnInput -> False], 
              TraditionalForm], {-0.45, 0.}, 
             NCache[
              ImageScaled[{1, 
                Rational[1, 2]}], 
              ImageScaled[{1, 0.5}]]]}}, {{
            EdgeForm[
             GrayLevel[0]], 
            GrayLevel[1], 
            DiskBox[{2.4, 0.}, 0.3], 
            GrayLevel[0], 
            InsetBox[
             FormBox[
              StyleBox["\"\[CapitalSigma]\"", 12, StripOnInput -> False], 
              TraditionalForm], {2.4, 0.}], 
            InsetBox[
             FormBox[
              StyleBox["\"F\"", 12, StripOnInput -> False], 
              TraditionalForm], {2.9, 0.}, 
             NCache[
              ImageScaled[{0, 
                Rational[1, 2]}], 
              ImageScaled[{0, 0.5}]]], 
            InsetBox[
             FormBox[
              StyleBox[
               TemplateBox[{"\"b = \"", 
                 TagBox[
                  InterpretationBox[
                   StyleBox["\"32.\"", ShowStringCharacters -> False], 
                   32.00000000000047, AutoDelete -> True], 
                  NumberForm[#, 3]& ]}, "RowDefault"], 10, 
               GrayLevel[0.5], StripOnInput -> False], TraditionalForm], {
             2.4, -0.5}]}}}}, PlotLabel -> None, 
        PlotRange -> {{-1.5, 4.1}, {-0.85, 0.5}}, ImageSize -> 235.2]}}, 
     AutoDelete -> False, 
     GridBoxItemSize -> {
