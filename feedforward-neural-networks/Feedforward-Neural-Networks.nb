Cell[CellGroupData[{

Cell["10. The same with NetChain and NetTrain", "Section",ExpressionUUID->"76873e1c-03a0-45ac-8312-1dc96f34341c"],

Cell["\<\
Wolfram Language's neural network framework builds the same networks from \
layers. LinearLayer[m] is W x + b with m outputs, LogisticSigmoid is \
\[Sigma], and NetTrain does backpropagation and gradient descent, by default \
with Adam, Eq. (19).\
\>", "Text",ExpressionUUID->"93eeb436-1830-41a7-a955-b422e2ddb9d3"],

Cell["\<\
Table 13. The framework against our code on XOR and on the cart-pole. The \
numbers differ slightly because the starting weights and the optimizer \
differ, but both controllers balance the stick.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"6c02b9d9-2ea0-4a93-93fe-967b4a89fa60"],

Cell[CellGroupData[{

Cell["\<\
(*c.24*)
(* the same networks with the built-in framework: LinearLayer is
   W x + b, LogisticSigmoid is \[Sigma] *)
(* XOR: 2 inputs, 3 \[Sigma] neurons, 1 \[Sigma] output, as in Table 7 *)
xorChain = NetChain[{LinearLayer[3], LogisticSigmoid, LinearLayer[1],
    LogisticSigmoid}, \"Input\" -> 2];
xorTrained = NetTrain[xorChain, xorX -> xorT, LossFunction ->
    MeanSquaredLossLayer[], MaxTrainingRounds -> 2000,
   Method -> {\"ADAM\", \"LearningRate\" -> 0.05}, RandomSeeding -> 1,
   TrainingProgressReporting -> None];
(* cart-pole: 4 inputs, 8 \[Sigma] neurons, linear output *)
cpChain = NetChain[{LinearLayer[8], LogisticSigmoid, LinearLayer[1]},
   \"Input\" -> 4];
cpTrained = NetTrain[cpChain, cpX -> cpY, LossFunction ->
    MeanSquaredLossLayer[], MaxTrainingRounds -> 300,
   RandomSeeding -> 1, TrainingProgressReporting -> None];
(* the trained NetChain as a controller, same scaling as ctrl *)
ctrlChain[s_] := Clip[umax First@cpTrained[s/scale], {-umax, umax}];
table[{{\"network\", \"result\"},
  {\"XOR, NetTrain\", NumberForm[Flatten[xorTrained[xorX]], 3]},
  {\"XOR, our backprop (Table 7)\", NumberForm[Flatten@Last@forward[
      histX[[-1, 3]], xorX, sigma], 3]},
  {\"cart-pole, NetTrain controller\", fate@sim[ctrlChain, s0, 300]},
  {\"cart-pole, our controller (Table 11)\", fate@sim[ctrl[netC], s0,
     300]}}, \"Table 13\"]\
\>", "Input",ExpressionUUID->"975414bb-2ea0-408f-ae44-86f9a90c3ffa"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"network\"", "\"result\""}, {"\"XOR, NetTrain\"", 
       TagBox[
        RowBox[{"{", 
          RowBox[{
            InterpretationBox[
             StyleBox["\"0.00237\"", ShowStringCharacters -> False], 
             0.0023673861287534237`, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.991\"", ShowStringCharacters -> False], 
             0.9913336634635925, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.993\"", ShowStringCharacters -> False], 
             0.9927623867988586, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.0102\"", ShowStringCharacters -> False], 
             0.010212075896561146`, AutoDelete -> True]}], "}"}], 
        NumberForm[#, 3]& ]}, {"\"XOR, our backprop (Table 7)\"", 
       TagBox[
        RowBox[{"{", 
          RowBox[{
            InterpretationBox[
             StyleBox["\"0.0214\"", ShowStringCharacters -> False], 
             0.021395416030026045`, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.978\"", ShowStringCharacters -> False], 
             0.9781485061502957, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.978\"", ShowStringCharacters -> False], 
             0.9781168549325161, AutoDelete -> True], ",", 
            InterpretationBox[
             StyleBox["\"0.0272\"", ShowStringCharacters -> False], 
             0.027178887162352193`, AutoDelete -> True]}], "}"}], 
        NumberForm[#, 3]& ]}, {
      "\"cart-pole, NetTrain controller\"", "\"balances\""}, {
      "\"cart-pole, our controller (Table 11)\"", "\"balances\""}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 13\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"8cda299f-\
8583-4777-b665-d85b2a0c0fde"]
}, Open  ]],

Cell["\<\
To see that nothing more is hidden inside the framework, take the trained \
weights out of the cart-pole NetChain and run them through forward of cell \
c.9.\
\>", "Text",ExpressionUUID->"77bf58e7-91ac-4fe4-991a-fa88cfb1aaa1"],

Cell["\<\
Table 14. The NetChain and our forward pass, with the same weights, agree to \
single precision.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"28c4f8ad-0a32-4b9d-891f-86c6c6945578"],

Cell[CellGroupData[{

Cell["\<\
(*c.25*)
(* the framework does exactly our algebra: take the weights out of the
   trained NetChain and run them through forward of c.9 *)
netFromChain = Table[{Normal@NetExtract[cpTrained, {i, \"Weights\"}],
    Normal@NetExtract[cpTrained, {i, \"Biases\"}]}, {i, {1, 3}}];
(* the force for all 3000 states, by the NetChain and by us *)
uChain = Flatten[cpTrained[cpX]];
uOurs = Flatten@Last@forward[netFromChain, cpX, Identity];
table[{{\"quantity\", \"value\"},
  {\"shapes of W, b in the NetChain\",
   Dimensions /@ Flatten[netFromChain, 1]},
  {\"max |NetChain output - forward of c.9|\",
   sci@Max@Abs[uChain - uOurs]}}, \"Table 14\"]\
\>", "Input",ExpressionUUID->"4380c534-384a-4f57-99c6-beadd2015af3"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"quantity\"", "\"value\""}, {
      "\"shapes of W, b in the NetChain\"", 
       RowBox[{"{", 
         RowBox[{
           RowBox[{"{", 
             RowBox[{"8", ",", "4"}], "}"}], ",", 
           RowBox[{"{", "8", "}"}], ",", 
           RowBox[{"{", 
             RowBox[{"1", ",", "8"}], "}"}], ",", 
           RowBox[{"{", "1", "}"}]}], "}"}]}, {
      "\"max |NetChain output - forward of c.9|\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"3.8\"", "\[Times]", 
            SuperscriptBox["10", "\"-7\""]}], ShowStringCharacters -> False], 
         3.8469835983434564`*^-7, AutoDelete -> True], 
        ScientificForm[#, 2]& ]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
