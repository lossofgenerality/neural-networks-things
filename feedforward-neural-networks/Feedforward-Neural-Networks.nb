Cell["\<\
Table 12b. The trained pendulum model as matrix products at \[Theta] = 1: a 6 \
\[Times] 1 column of weights, then a 1 \[Times] 6 row. The result is within \
0.01 of -sin 1.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"5d229aa4-454e-4b7c-9f74-81005d305ef3"],

Cell[CellGroupData[{

Cell["\<\
(*c.22c*)
(* the trained pendulum model in matrices, at \[Theta] = 1: W1 is 6\[Times]1,
   W2 is 1\[Times]6 *)
{{W1p, b1p}, {W2p, b2p}} = histP[[-1, 3]];
z1p = W1p . {1/2.} + b1p; h1p = LogisticSigmoid[z1p];
z2p = W2p . h1p + b2p;
mtable[{
   {\"hidden layer:  z = W (\[Theta]/2) + b\", Row[{mat[W1p], \" \", \
col[{0.5}],
      \" + \", col[b1p], \" = \", col[z1p]}]},
   {\"h = \[Sigma](z)\", Row[{\"\[Sigma]\", col[z1p], \" = \", col[h1p]}]},
   {\"output layer:  a = W h + b\", Row[{mat[W2p], \" \", col[h1p], \" + \",
      col[b2p], \" = \", col[z2p]}]},
   {\"compare with the true force law\", Row[{\"a(1) = \",
      NumberForm[First[z2p], 4], \",   -sin 1 = \",
      NumberForm[-Sin[1.], 4]}]}},
 \"Table 12b. The pendulum model as matrix products\"]\
\>", "Input",ExpressionUUID->"4ee77b3c-a7f8-42f8-b0ff-5c7598aa5935"],

