               StyleBox[
                TagBox[
                 InterpretationBox[
                  StyleBox["\"20\"", ShowStringCharacters -> False], 20, 
                  Editable -> False], NumberForm[#, 3]& ], 10, 
                GrayLevel[0], Background -> GrayLevel[1], StripOnInput -> 
                False], TraditionalForm], {1.08, 0.275}]}}, {{
             RGBColor[0.85, 0.2, 0.1], 
             AbsoluteThickness[4.5], 
             LineBox[{{0., -0.5}, {2.4, 0.}}], 
             InsetBox[
              FormBox[
               StyleBox[
                TagBox[
