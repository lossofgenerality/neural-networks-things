        InterpretationBox[
         StyleBox["\"0.0914\"", ShowStringCharacters -> False], 0.091418, 
         AutoDelete -> True], NumberForm[#, 3]& ], "\"\""}, {
      "\"all inputs as one matrix\"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.00335\"", ShowStringCharacters -> False], 0.003352, 
         AutoDelete -> True], NumberForm[#, 3]& ], "True"}, {"\"speed-up\"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"27.3\"", ShowStringCharacters -> False], 
         27.27267303102625, AutoDelete -> True], NumberForm[#, 3]& ], 
       "\"\""}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> 
     False, GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 3\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"79b185ee-\
755a-4f40-9080-ad5b3a6adfd9"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Stacking layers: the network", "Section",ExpressionUUID->"ba081af0-c8e7-49fb-96e9-1e03684814c9"],

Cell[TextData[{
 "A network feeds the output of one layer into the next. Write the input as \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "0"], TraditionalForm]],ExpressionUUID->
  "c8ccf074-617f-4cfe-9d39-c7133e830711"],
 " and number the layers l = 1, \[Ellipsis], L; layer l has its own ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["W", "l"], TraditionalForm]],ExpressionUUID->
  "1414980f-df75-4202-967b-9250d88e3fcc"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "l"], TraditionalForm]],ExpressionUUID->
  "f5abdab3-e3c5-4f3a-a55d-e88586d4ba74"],
 " (superscripts number layers here, they are not powers):"
}], "Text",ExpressionUUID->"db51212c-3bff-45bc-b2c1-758f7d2f3196"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["a", "0"], "=", "x"}], 
        RowBox[{",", "    "}], 
        RowBox[{
         SuperscriptBox["z", "l"], "=", 
         RowBox[{
          RowBox[{
           SuperscriptBox["W", "l"], " ", 
           SuperscriptBox["a", 
            RowBox[{"l", "-", "1"}]]}], "+", 
          SuperscriptBox["b", "l"]}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         SuperscriptBox["a", "l"], "=", 
         RowBox[{"\[Sigma]", "(", 
          SuperscriptBox["z", "l"], ")"}]}], 
        RowBox[{",", "    "}], 
        RowBox[{"l", "=", "1", ",", "\[Ellipsis]", ",", "L"}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        RowBox[{"f", 
         RowBox[{"(", "x", ")"}]}], "=", 
        RowBox[{
         SuperscriptBox["a", "L"], "=", 
         RowBox[{"\[Sigma]", "(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["W", "L"], " ", 
            RowBox[{"\[Sigma]", "(", 
             RowBox[{
              RowBox[{
               SuperscriptBox["W", 
                RowBox[{"L", "-", "1"}]], " ", "\[Ellipsis]", 
               RowBox[{"\[Sigma]", "(", 
                RowBox[{
                 RowBox[{
                  SuperscriptBox["W", "1"], "x"}], "+", 
                 SuperscriptBox["b", "1"]}], ")"}], "\[Ellipsis]"}], "+", 
              SuperscriptBox["b", 
               RowBox[{"L", "-", "1"}]]}], ")"}]}], "+", 
           SuperscriptBox["b", "L"]}], ")"}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "6", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"a8087547-49dc-489d-8058-0345b963b2a8"],

Cell["\<\
The second line writes the whole network as one function: a composition of \
affine maps and \[Sigma]. Why is more than one layer needed? The classic \
answer is XOR [2].\
\>", "Text",ExpressionUUID->"c39c791e-e364-49a5-950a-45f1aed7d76c"],

Cell[TextData[{
 StyleBox["Theorem 1 (XOR is not linearly separable). ",
  FontWeight->"Bold"],
 "There are no w = (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "1"], TraditionalForm]],ExpressionUUID->
  "689d5435-e8ac-4aed-b1a5-8d84bd5cba10"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],ExpressionUUID->
  "40ead6c6-c229-4b88-85a2-5f12c9d86c8f"],
 ") and b with w\[CenterDot]x + b > 0 for x = (0,1) and (1,0) and w\
\[CenterDot]x + b \[LessEqual] 0 for x = (0,0) and (1,1). Hence no single \
neuron computes XOR."
}], "Text",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.98, 0.56, 0.17],
 Background->RGBColor[
  0.96, 0.95, 0.92],ExpressionUUID->"6076a704-96e0-479b-8e89-a530e5b0ab84"],

Cell[TextData[{
 StyleBox["Proof. ",
  FontWeight->"Bold"],
 "Adding the two strict inequalities ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],ExpressionUUID->
  "8f68b294-ff01-41eb-a9a3-4a73aaf3bcce"],
 " + b > 0 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "1"], TraditionalForm]],ExpressionUUID->
  "1f542ba8-2e6e-4e7f-a8f4-f407634fe78b"],
 " + b > 0 gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "1"], TraditionalForm]],ExpressionUUID->
  "1a6dc56f-655e-4841-b21b-2654466af46f"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],ExpressionUUID->
  "a7697c1d-726f-4272-b9bd-46d3a5a25175"],
 " + 2b > 0. Adding the other two, b \[LessEqual] 0 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "1"], TraditionalForm]],ExpressionUUID->
  "8f9bd64c-7433-4967-b960-12af8b394ede"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],ExpressionUUID->
  "12ec4dcf-f580-4dc5-8949-198c7f536d3e"],
 " + b \[LessEqual] 0, gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "1"], TraditionalForm]],ExpressionUUID->
  "b1e1d329-448b-44aa-91de-c98d5ff8468d"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],ExpressionUUID->
  "4a1dd876-6869-49aa-8a24-75404915d61c"],
 " + 2b \[LessEqual] 0, a contradiction. \:220e"
}], "Text",ExpressionUUID->"a10b53c4-5327-4f8b-a134-5bc6f6220a06"],

Cell["\<\
Table 4. The best a single neuron can do on XOR, by minimizing its squared \
error: it answers 0.5 everywhere.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"ace10904-04af-45f5-9267-c3e330c15a31"],

Cell[CellGroupData[{

Cell["\<\
(*c.5*)
(* XOR: 1 when exactly one input is 1. Try the best single neuron:
   minimize the squared error over its three parameters *)
xorY = BitXor @@@ inputs;
single = NMinimize[Total[(LogisticSigmoid[{p, q} . # + r] & /@ inputs
       - xorY)^2], {p, q, r}, Method -> \"DifferentialEvolution\"];
(* the outputs of the best neuron: 0.5 for every input *)
table[Prepend[Table[{inputs[[k, 1]], inputs[[k, 2]], xorY[[k]],
     NumberForm[LogisticSigmoid[{p, q} . inputs[[k]] + r] /.
       single[[2]], 3]}, {k, 4}],
  {Subscript[\"x\", 1], Subscript[\"x\", 2], \"XOR\", \"best single neuron\"}],
 \"Table 4\"]\
\>", "Input",ExpressionUUID->"c28d0e9f-569b-4a05-8ba0-20eebee72afd"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
       SubscriptBox["\"x\"", "1"], 
       SubscriptBox["\"x\"", "2"], "\"XOR\"", "\"best single neuron\""}, {
      "0", "0", "0", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 
         0.49999999999999994`, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "0", "1", "1", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 
         0.5000000000000001, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "1", "0", "1", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 
         0.49999999999999994`, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "1", "1", "0", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 0.5, AutoDelete -> 
         True], NumberForm[#, 3]& ]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 4\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
