           1, RowAlignments -> Baseline, ColumnAlignments -> Center], 
          "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]}, {"\"b\"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          TagBox[
           GridBox[{{"0.`"}, {
              RowBox[{"-", "0.5`"}]}, {"1.`"}}, ColumnAlignments -> Center, 
            RowSpacings -> 1, ColumnAlignments -> Left], Column], 
          "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]}, {"\"x\"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          TagBox[
           
           GridBox[{{"0.8`"}, {"0.3`"}}, ColumnAlignments -> Center, 
            RowSpacings -> 1, ColumnAlignments -> Left], Column], 
          "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]}, {"\"z = W x + b\"", 
       TagBox[
        RowBox[{"(", "\[NoBreak]", 
          TagBox[
           
           GridBox[{{"0.20000000000000007`"}, {"0.050000000000000044`"}, {
             "1.0999999999999999`"}}, ColumnAlignments -> Center, RowSpacings -> 
            1, ColumnAlignments -> Left], Column], "\[NoBreak]", ")"}], 
        Function[BoxForm`e$, 
         MatrixForm[BoxForm`e$]]]}, {"\"a = \[Sigma](z)\"", 
