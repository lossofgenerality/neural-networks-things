              TagBox[{
                TagBox[
                 DiskBox[{5., 0.}, 0.25], "DynamicName", BoxID -> 
                 "VertexID$5"], 
                InsetBox[
                 FormBox[
                  StyleBox[
                   TemplateBox[{"\"AND,  b = \"", 
                    StyleBox[
                    RowBox[{"-", "30"}], 
                    RGBColor[0, 0, 1], StripOnInput -> False]}, "RowDefault"], 
                   Directive[
                    GrayLevel[0], 13], StripOnInput -> False], 
                  TraditionalForm], 
                 Offset[{0, 2}, 
                  DynamicLocation["VertexID$5", Automatic, Top]], 
                 ImageScaled[{0.5, 0}], BaseStyle -> "Graphics"]}, 
               "DynamicName", BoxID -> "VertexLabelID$5"]}}], 
           MouseAppearanceTag["NetworkGraphics"]], AllowKernelInitialization -> 
          False]], {
        FormatType -> TraditionalForm, FrameTicks -> None, 
         ImagePadding -> {{40, 20}, {35, 35}}, ImageSize -> 440, 
         DefaultBaseStyle -> "NetworkGraphics"}]}}, AutoDelete -> False, 
     GridBoxItemSize -> {
      "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"], 
   StyleBox[
   "\"Figure 2. A 2-2-1 network that computes XOR\"", 14, StripOnInput -> 
    False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"99e06610-\
092e-4669-bd82-3f9b63998196"]
}, Open  ]],

Cell["\<\
The hidden layer does not answer the question; it changes the question. It \
moves the four inputs to new points h = \[Sigma](W x + b). The two inputs \
whose answer is 1 both land on (1, 1), and the other two on (0, 1) and (1, \
0). In these new coordinates one straight line separates the classes, and a \
single output neuron can finish the job. This is what hidden layers do in \
general: they transform the data until a simple rule works.\
\>", "Text",ExpressionUUID->"087fedd9-54c5-4086-b0d5-7603fd3aae0b"],

Cell[TextData[{
 "Figure 3. Left: the XOR inputs, which no line separates. Right: the same \
points after the hidden layer, separated by the dashed line ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "1"], TraditionalForm]],ExpressionUUID->
  "71603199-590c-4ce1-8598-b6af6e6ed6fd"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "2"], TraditionalForm]],ExpressionUUID->
  "baa854e1-289f-4f09-8856-647dbfd1c888"],
 " = 1.5."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"6d535095-2bea-4c14-a256-833579c8c413"],

Cell[CellGroupData[{

Cell["\<\
(*c.8*)
(* why the hidden layer helps: it moves the four inputs to new points
   h = \[Sigma](W x + b). In the input plane no line separates the XOR
   classes; in the hidden plane one line does *)
hid = layer[Wh, bh] /@ inputs;
(* labels: (0,1) and (1,0) land on the same hidden point, so one
   label goes above it and one below *)
offs = {{0, 0.13}, {0, 0.13}, {0, -0.13}, {0, 0.13}};
pts[ps_] := Table[{If[xorY[[k]] == 1, Red, Blue], PointSize[0.06],
    Point[ps[[k]]], Black, Text[Style[ToString[inputs[[k]]],
      figFont - 3], ps[[k]] + offs[[k]]]}, {k, 4}];
figure[{{
   Graphics[pts[N@inputs], Frame -> True, PlotRange -> {{-0.3, 1.3},
      {-0.3, 1.4}}, PlotRangeClipping -> True,
    FrameLabel -> {Subscript[\"x\", 1], Subscript[\"x\", 2]},
    Evaluate@panel[PlotLabel -> \"3a. inputs\"]],
   Graphics[{pts[hid], Dashed, Line[{{-0.2, 1.7}, {1.7, -0.2}}]},
    Frame -> True, PlotRange -> {{-0.3, 1.3}, {-0.3, 1.4}},
    PlotRangeClipping -> True,
    FrameLabel -> {Subscript[\"h\", 1], Subscript[\"h\", 2]},
    Evaluate@panel[PlotLabel -> \"3b. hidden layer\"]]}},
 \"Figure 3. Red = XOR 1, blue = XOR 0\"]\
\>", "Input",ExpressionUUID->"7705a5c4-53ab-4bc0-9bcb-26daa342fc2f"],

