Cell[CellGroupData[{

Cell["7. A neuron learns Celsius to Fahrenheit", "Section",ExpressionUUID->"60d9ee14-b108-4239-8677-38e28b006471"],

Cell["\<\
The simplest learning problem everyone knows the answer to: temperatures in \
Celsius and in Fahrenheit. The rule is F = 1.8 C + 32, but the network is not \
told; it only sees eight pairs.\
\>", "Text",ExpressionUUID->"06fa25e0-9473-40f0-ba30-7849caf57933"],

Cell["Table 8. Eight familiar temperatures.", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"f2e4535c-6771-4bea-a08b-553ff5d7e733"],

Cell[CellGroupData[{

Cell["\<\
(*c.15*)
(* temperatures everybody knows, in \[Degree]C and \[Degree]F *)
temps = {{\"cold winter day\", -40}, {\"freezer\", -18},
   {\"water freezes\", 0}, {\"spring day\", 10}, {\"room\", 21},
   {\"body\", 37}, {\"hot summer day\", 45}, {\"water boils\", 100}};
(* the exact rule, which the neuron is not told *)
fahr[c_] := 9/5 c + 32;
table[Prepend[{#1, #2, N@fahr[#2]} & @@@ temps,
  {\"\", \"\[Degree]C\", \"\[Degree]F\"}], \"Table 8\"]\
\>", "Input",ExpressionUUID->"e397f12e-6aa9-46fa-a80f-036ce72237c9"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"\"", "\"\[Degree]C\"", "\"\[Degree]F\""}, {
      "\"cold winter day\"", 
       RowBox[{"-", "40"}], 
       RowBox[{"-", "40.`"}]}, {"\"freezer\"", 
       RowBox[{"-", "18"}], 
       RowBox[{"-", "0.4`"}]}, {"\"water freezes\"", "0", "32.`"}, {
      "\"spring day\"", "10", "50.`"}, {"\"room\"", "21", "69.8`"}, {
      "\"body\"", "37", "98.6`"}, {"\"hot summer day\"", "45", "113.`"}, {
      "\"water boils\"", "100", "212.`"}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 8\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"b8cf37c8-\
7be1-49b1-bae8-0589abecddb0"]
}, Open  ]],

Cell["\<\
One neuron with no activation function, F = w u + b, is enough, because the \
rule is a straight line. The input is u = C/100 so that both parameters are \
of a similar size; the slope per degree is then w/100. The loss and its \
gradient are\
\>", "Text",ExpressionUUID->"86d94b4d-28e7-47a5-879e-a7e802a73a32"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{"L", 
         RowBox[{"(", 
          RowBox[{"w", ",", "b"}], ")"}]}], "=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "M"}]], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"m", "=", "1"}], "M"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"w", " ", 
              SubscriptBox["u", "m"]}], "+", "b", "-", 
             SubscriptBox["F", "m"]}], ")"}], "2"]}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         SubscriptBox["u", "m"], "=", 
         FractionBox[
          SubscriptBox["C", "m"], "100"]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", "w"}]], "=", 
         RowBox[{
          FractionBox["1", "M"], 
          RowBox[{
           UnderscriptBox["\[Sum]", "m"], 
           RowBox[{
            SubscriptBox["r", "m"], " ", 
            SubscriptBox["u", "m"]}]}]}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", "b"}]], "=", 
         RowBox[{
          FractionBox["1", "M"], 
          RowBox[{
           UnderscriptBox["\[Sum]", "m"], 
           SubscriptBox["r", "m"]}]}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         SubscriptBox["r", "m"], "=", 
         RowBox[{
          RowBox[{"w", " ", 
           SubscriptBox["u", "m"]}], "+", "b", "-", 
          SubscriptBox["F", "m"]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "15", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"b622f4da-8fdb-4871-9551-f3007630d452"],

Cell[TextData[{
 "which is Eq. (11) with a linear output: the error signal is just the \
residual ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "m"], TraditionalForm]],ExpressionUUID->
  "b31e98c1-be71-4427-b890-5204be08fa63"],
 "."
}], "Text",ExpressionUUID->"3a151b88-ece1-4347-8900-9e95bab65f35"],

Cell["\<\
Table 9. Learning the rule from w = 0, b = 0, with \[Eta] = 0.5. After 200 \
epochs the neuron has found F = 1.8 C + 32 to all digits shown.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"837fe4c6-2dcf-4b0b-a66d-ca3448b7692a"],

Cell[CellGroupData[{

Cell["\<\
(*c.16*)
(* one linear neuron, F = w (C/100) + b: no hidden layer, no \[Sigma]. The
   input is divided by 100 so that w and b are of similar size; then
   the slope per degree is w/100 and should come out as 9/5 = 1.8 *)
(* inputs u = C/100 and targets F, one example per row *)
cX = List /@ N[temps[[All, 2]]/100];
fY = List /@ N[fahr /@ temps[[All, 2]]];
SeedRandom[3];
(* start from w = b = 0; \[Eta] = 0.5, 400 epochs *)
histT = train[{{{{0.}}, {0.}}}, cX, fY, \"lin\", 0.5, 400, 2];
(* read w and b out of a snapshot *)
wb[h_] := {h[[3, 1, 1, 1, 1]], h[[3, 1, 2, 1]]};
table[Prepend[Table[With[{h = histT[[k]]}, {h[[1]], NumberForm[h[[2]], 4],
      NumberForm[wb[h][[1]]/100, 4], NumberForm[wb[h][[2]], 4]}],
    {k, {1, 2, 6, 11, 26, 51, 101, Length[histT]}}],
  {\"epoch\", \"loss\", \"slope w/100\", \"intercept b\"}], \"Table 9\"]\
\>", "Input",ExpressionUUID->"988b0436-af16-4045-a3f5-d7eb67b8a2cf"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"epoch\"", "\"loss\"", "\"slope w/100\"", "\"intercept b\""}, {"0", 
       TagBox[
