               10, 
               GrayLevel[0.5], StripOnInput -> False], TraditionalForm], {
             2.4, -0.5}]}}}}, PlotLabel -> FormBox[
          StyleBox["\"D1a. AND\"", 14, StripOnInput -> False], 
