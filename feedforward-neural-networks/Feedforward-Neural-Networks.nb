Cell[CellGroupData[{

Cell["Update: take a small step downhill", "Subsection",ExpressionUUID->"4c0a3804-9ca8-42f3-a681-6a7a93356234"],

Cell["\<\
Every weight and bias moves against its derivative, by the learning rate \
\[Eta] = 1 times the derivative:\
\>", "Text",ExpressionUUID->"c1be5e0d-1cb8-48dc-8cad-6cf04a6bee22"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["w", "A"], "\[LeftArrow]", 
     RowBox[{
      SubscriptBox["w", "A"], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["w", "A"]}]]}]}]}], 
    RowBox[{",", "  "}], 
    RowBox[{
     SubscriptBox["b", "A"], "\[LeftArrow]", 
     RowBox[{
      SubscriptBox["b", "A"], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["b", "A"]}]]}]}]}], 
    RowBox[{",", "  "}], 
    RowBox[{
     SubscriptBox["w", "B"], "\[LeftArrow]", 
     RowBox[{
      SubscriptBox["w", "B"], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["w", "B"]}]]}]}]}], 
    RowBox[{",", "  "}], 
    RowBox[{
     SubscriptBox["b", "B"], "\[LeftArrow]", 
     RowBox[{
      SubscriptBox["b", "B"], "-", 
      RowBox[{"\[Eta]", " ", 
       FractionBox[
        RowBox[{"\[PartialD]", "L"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["b", "B"]}]]}]}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.5", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"a31ca7a7-0ffc-4a64-930e-38d1a3984d17"],

Cell["\<\
Table 0.3. The update. The gradients of Table 0.2 agree with those computed \
by Wolfram Language's own derivative D, and after one step the loss has \
dropped from 0.0894 to 0.0751.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"d00d37c6-b44f-41ba-9126-a4821f292fe7"],

Cell[CellGroupData[{

Cell["\<\
(*c.0.3*)
(* one gradient-descent step, Eq. (0.5), and two checks: the gradients
   against Wolfram's own derivative D, and the loss before and after *)
newP = {wA, bA, wB, bB} - rate {gwA, gbA, gwB, gbB};
lossOf[{p_, q_, r_, s_}] := (LogisticSigmoid[r LogisticSigmoid[
        p xIn + q] + s] - yT)^2/2;
gradD = D[lossOf[{p, q, r, s}], {{p, q, r, s}}] /.
   Thread[{p, q, r, s} -> {wA, bA, wB, bB}];
table[{{\"parameter\", \"old\", \"gradient\", \"gradient by D\", \"new\"},
   Sequence @@ MapThread[{fm[#1], NumberForm[#2, 4], NumberForm[#3, 4],
       NumberForm[#4, 4], NumberForm[#5, 4]} &, {{\"w_A\", \"b_A\", \"w_B\",
       \"b_B\"}, {wA, bA, wB, bB}, {gwA, gbA, gwB, gbB}, gradD, newP}],
   {\"loss L\", NumberForm[lossAB, 4], \"\", \"\",
    NumberForm[lossOf[newP], 4]}}, \"Table 0.3. The update\"]\
\>", "Input",ExpressionUUID->"7f067425-756c-48c3-b7d3-41e744039007"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"parameter\"", "\"old\"", "\"gradient\"", "\"gradient by D\"", 
       "\"new\""}, {
       TemplateBox[{
         SubscriptBox["\"w\"", "\"A\""]}, "RowDefault"], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 0.5, AutoDelete -> 
         True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035364`, AutoDelete -> True], 
        NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035363`, AutoDelete -> True], 
        NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5121\"", ShowStringCharacters -> False], 
         0.5121243939840354, AutoDelete -> True], NumberForm[#, 4]& ]}, {
       TemplateBox[{
         SubscriptBox["\"b\"", "\"A\""]}, "RowDefault"], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.\"", ShowStringCharacters -> False], 0., AutoDelete -> 
         True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035364`, AutoDelete -> True], 
        NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035363`, AutoDelete -> True], 
        NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.01212\"", ShowStringCharacters -> False], 
         0.012124393984035364`, AutoDelete -> True], NumberForm[#, 4]& ]}, {
       TemplateBox[{
         SubscriptBox["\"w\"", "\"B\""]}, "RowDefault"], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5\"", ShowStringCharacters -> False], 0.5, AutoDelete -> 
         True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.06423\"", ShowStringCharacters -> False], -0.06422828047972629,
          AutoDelete -> True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.06423\"", ShowStringCharacters -> False], -0.06422828047972629,
          AutoDelete -> True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.5642\"", ShowStringCharacters -> False], 
         0.5642282804797263, AutoDelete -> True], NumberForm[#, 4]& ]}, {
       TemplateBox[{
         SubscriptBox["\"b\"", "\"B\""]}, "RowDefault"], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.\"", ShowStringCharacters -> False], 0., AutoDelete -> 
         True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.1032\"", ShowStringCharacters -> False], -0.10318470181130271`,
          AutoDelete -> True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.1032\"", ShowStringCharacters -> False], -0.1031847018113027, 
         AutoDelete -> True], NumberForm[#, 4]& ], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.1032\"", ShowStringCharacters -> False], 
         0.10318470181130271`, AutoDelete -> True], NumberForm[#, 4]& ]}, {
      "\"loss L\"", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.08939\"", ShowStringCharacters -> False], 
         0.0893861013817111, AutoDelete -> True], NumberForm[#, 4]& ], "\"\"",
        "\"\"", 
       TagBox[
