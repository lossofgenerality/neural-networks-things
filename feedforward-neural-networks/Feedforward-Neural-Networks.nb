Cell["\<\
Table 9b. The trained temperature neuron as a matrix product. All matrices \
are 1 \[Times] 1: the smallest case of Eq. (4).\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"e47a71b4-8159-4b0b-9e09-a73d8b5752f5"],

Cell[CellGroupData[{

Cell["\<\
(*c.16c*)
(* the trained temperature neuron in matrix form: here every matrix is
   1\[Times]1, so the product is an ordinary product *)
{{wT}, bT} = {histT[[-1, 3, 1, 1]], histT[[-1, 3, 1, 2]]};
table[Prepend[Table[{Row[{c, \" \[Degree]C\"}], Row[{mat[wT], \" \", \
col[{c/100.}],
       \" + \", col[bT], \" = \", col[wT . {c/100.} + bT]}]},
    {c, {37, 100}}], {\"C\", \"F = w u + b,  u = C/100\"}],
 \"Table 9b. The temperature neuron as a matrix product\"]\
\>", "Input",ExpressionUUID->"6e3889b1-e76c-4949-b193-7f9d727cf883"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"C\"", "\"F = w u + b,  u = C/100\""}, {
       TemplateBox[{"37", "\" \[Degree]C\""}, "RowDefault"], 
       TemplateBox[{
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            TagBox[
             GridBox[{{
                TagBox[
                 InterpretationBox[
                  StyleBox["\"180.\"", ShowStringCharacters -> False], 
                  179.99999999999795`, AutoDelete -> True], 
                 NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnAlignments -> 
              Center, ColumnAlignments -> Left], Column], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"0.37\"", ShowStringCharacters -> False], 0.37, 
                 AutoDelete -> True], NumberForm[#, 3]& ]}}, RowSpacings -> 1,
              ColumnSpacings -> 1, RowAlignments -> Baseline, 
             ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" + \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"32.\"", ShowStringCharacters -> False], 
                 32.00000000000047, AutoDelete -> True], 
                NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
             RowAlignments -> Baseline, ColumnAlignments -> Center], 
            "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" = \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"98.6\"", ShowStringCharacters -> False], 
                 98.59999999999971, AutoDelete -> True], 
                NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
             RowAlignments -> Baseline, ColumnAlignments -> Center], 
            "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]]}, "RowDefault"]}, {
       TemplateBox[{"100", "\" \[Degree]C\""}, "RowDefault"], 
       TemplateBox[{
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            TagBox[
             GridBox[{{
                TagBox[
                 InterpretationBox[
                  StyleBox["\"180.\"", ShowStringCharacters -> False], 
                  179.99999999999795`, AutoDelete -> True], 
                 NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnAlignments -> 
              Center, ColumnAlignments -> Left], Column], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"1.\"", ShowStringCharacters -> False], 1., 
                 AutoDelete -> True], NumberForm[#, 3]& ]}}, RowSpacings -> 1,
              ColumnSpacings -> 1, RowAlignments -> Baseline, 
             ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" + \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"32.\"", ShowStringCharacters -> False], 
                 32.00000000000047, AutoDelete -> True], 
                NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
             RowAlignments -> Baseline, ColumnAlignments -> Center], 
            "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" = \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"212.\"", ShowStringCharacters -> False], 
                 211.9999999999984, AutoDelete -> True], 
                NumberForm[#, 3]& ]}}, RowSpacings -> 1, ColumnSpacings -> 1, 
             RowAlignments -> Baseline, ColumnAlignments -> Center], 
