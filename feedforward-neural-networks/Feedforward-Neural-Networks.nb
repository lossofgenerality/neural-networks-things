Cell["\<\
The same network in matrix form. The hidden layer has 2 neurons reading 2 \
inputs, so its W is 2 \[Times] 2 (row i holds the weights of neuron i) and b \
has 2 entries; the output layer has 1 neuron reading 2 hidden values, so its \
W is 1 \[Times] 2. The second line of Eq. (7) writes the network with these \
matrices. With the four inputs as the rows of X, Eq. (5) computes all of them \
with one product per layer.\
\>", "Text",ExpressionUUID->"d1f2c29d-cb51-48f9-a41d-1aae9be6d07d"],

Cell["\<\
Table 5b. The XOR network as matrix products: first for the input (1, 0), \
then for all four inputs at once. Note the shapes: X is 4 \[Times] 2, W\:1d40 \
is 2 \[Times] 2, and Z is 4 \[Times] 2, one row per input and one column per \
hidden neuron.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"4d652c14-763e-4cba-9c18-a6f3d458fee8"],

Cell[CellGroupData[{

Cell["\<\
(*c.6b*)
(* the XOR network in matrices: one input, then all four at once.
   Hidden layer: W is 2\[Times]2 (2 neurons \[Times] 2 inputs), b is \
2\[Times]1. Output
   layer: W is 1\[Times]2 (1 neuron \[Times] 2 hidden values), b is \
1\[Times]1 *)
xEx = {1, 0};
zH = Wh . xEx + bh; hH = LogisticSigmoid[zH];
zO = Wo . hH + bo;
(* batch, Eq. (5): the 4 inputs are the rows of X (4\[Times]2) *)
ZH = N[inputs] . Transpose[Wh] + ConstantArray[bh, 4];
HH = LogisticSigmoid[ZH];
ZO = HH . Transpose[Wo] + ConstantArray[bo, 4];
mtable[{
   {\"hidden layer, x = (1, 0):  z = W x + b,  h = \[Sigma](z)\",
    Row[{mat[Wh], \" \", col[xEx], \" + \", col[bh], \" = \", col[zH],
      \",    \[Sigma]\", col[zH], \" = \", col[hH]}]},
   {\"output layer:  z = W h + b,  y = \[Sigma](z)\",
    Row[{mat[Wo], \" \", col[hH], \" + \", col[bo], \" = \", col[zO],
      \",    \[Sigma]\", col[zO], \" = \", col[LogisticSigmoid[zO]]}]},
   {\"hidden layer, all 4 inputs as rows:  Z = X W\:1d40 + B\",
    Row[{mat[N@inputs], \" \", mat[Transpose[Wh]], \" + \",
      mat[ConstantArray[bh, 4]], \" = \", mat[ZH]}]},
   {\"H = \[Sigma](Z), entry by entry\", Row[{\"\[Sigma]\", mat[ZH], \" = \", \
mat[HH]}]},
   {\"output layer, all 4 inputs:  Z = H W\:1d40 + B,  Y = \[Sigma](Z)\",
    Row[{mat[HH], \" \", mat[Transpose[Wo]], \" + \",
      mat[ConstantArray[bo, 4]], \" = \", mat[ZO], \",    \[Sigma]\", \
mat[ZO],
      \" = \", mat[LogisticSigmoid[ZO]]}]}},
 \"Table 5b. The XOR network as matrix products\"]\
\>", "Input",ExpressionUUID->"79c60f65-d1c7-490e-b68e-71538ef69148"],

