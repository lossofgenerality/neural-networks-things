Cell[CellGroupData[{

Cell["The computing: many inputs at once", "Subsection",ExpressionUUID->"8c605465-937e-4b08-bdc8-9a19017cc544"],

Cell["\<\
In practice a network is applied to many inputs, and a computer is much \
faster at one large matrix product than at many small ones. Put M inputs as \
the rows of an M \[Times] n matrix X. Then all M results come from one \
product, the bias is added to every row, and \[Sigma] is applied entrywise:\
\>", "Text",ExpressionUUID->"1e1c0fab-96a7-40c4-ba69-56f7a9d0a722"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"Z", "=", 
     RowBox[{
      RowBox[{"X", " ", 
       SuperscriptBox["W", "T"]}], "+", 
      RowBox[{"1", " ", 
       SuperscriptBox["b", "T"]}]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{"A", "=", 
     RowBox[{"\[Sigma]", "(", "Z", ")"}]}], 
    RowBox[{",", "    "}], 
    RowBox[{"X", "\[Element]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", 
      RowBox[{"M", "\[Times]", "n"}]]}], 
    RowBox[{",", "  "}], 
    RowBox[{"A", "\[Element]", 
     SuperscriptBox["\[DoubleStruckCapitalR]", 
      RowBox[{"M", "\[Times]", "m"}]]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "5", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"e23ec1b0-247a-4749-93b5-7de21a32540f"],

Cell[TextData[{
 "This row convention, one sample per row, is the one used in the code from \
now on; it is why the code writes X ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["W", "T"], TraditionalForm]],ExpressionUUID->
  "1c97566d-2def-47db-be8a-30f2f1a16a80"],
 " where the equations write W x."
}], "Text",ExpressionUUID->"883b4ec4-6916-4e09-9f22-7193d887bb86"],

Cell["\<\
Table 3. 100000 inputs through the same layer, one at a time and as one \
matrix.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"a3d5e133-434f-4bc3-b220-bd122bb2a940"],

Cell[CellGroupData[{

Cell["\<\
(*c.4*)
(* the computing: M inputs at once. Put them as the rows of a matrix
   X (M \[Times] n); the whole layer is then one matrix product, Eq. (5) *)
layerBatch[W_, b_][X_] :=
  LogisticSigmoid[X . Transpose[W] + ConstantArray[b, Length[X]]];
SeedRandom[1];
(* 100000 random inputs, one per row *)
Xbig = RandomReal[{0, 1}, {100000, 2}];
(* time both: Map over the rows, and one matrix product *)
{tLoop, r1} = AbsoluteTiming[layer[W1, b1] /@ Xbig];
{tBatch, r2} = AbsoluteTiming[layerBatch[W1, b1][Xbig]];
table[{{\"method\", \"time (s)\", \"same result?\"},
  {\"one input at a time (Map)\", NumberForm[tLoop, 3], \"\"},
  {\"all inputs as one matrix\", NumberForm[tBatch, 3],
   Max@Abs[r1 - r2] < 10^-12},
  {\"speed-up\", NumberForm[tLoop/tBatch, 3], \"\"}}, \"Table 3\"]\
\>", "Input",ExpressionUUID->"c710584f-7982-4768-be9e-7edad5b4282e"],

Cell[BoxData[
 TemplateBox[{
