Cell[CellGroupData[{

Cell["1. One neuron", "Section",ExpressionUUID->"ef7b18f8-fa3e-4088-9569-7370bbc99627"],

Cell[TextData[{
 "A neuron takes n numbers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "8871b209-e6e5-407e-812f-ffe167ba12fd"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "e987f661-2887-4e2f-bef5-6cfd1f803125"],
 ", multiplies each by a weight ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "i"], TraditionalForm]],ExpressionUUID->
  "5ff439f4-6031-4efe-81c6-99a1545337b9"],
 ", adds them and adds a bias b. The result z is then passed through an \
activation function, here the logistic sigmoid \[Sigma]:"
}], "Text",ExpressionUUID->"5f8b070e-c5a3-4f1d-a857-74cb78062a06"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{"z", "=", 
        RowBox[{
         RowBox[{"w", "\[CenterDot]", "x"}], "+", "b"}], "=", 
        RowBox[{
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"i", "=", "1"}], "n"], 
          RowBox[{
           SubscriptBox["w", "i"], " ", 
           SubscriptBox["x", "i"]}]}], "+", "b"}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        RowBox[{"w", "\[CenterDot]", "x"}], "=", 
        RowBox[{
         SuperscriptBox["w", "T"], "x"}], "=", 
        RowBox[{
         RowBox[{"(", GridBox[{
            {
             StyleBox[
              SubscriptBox["w", "1"],
              ScriptLevel->0], 
             StyleBox[
              SubscriptBox["w", "2"],
              ScriptLevel->0], 
             StyleBox["\[CenterEllipsis]",
              ScriptLevel->0], 
             StyleBox[
              SubscriptBox["w", "n"],
              ScriptLevel->0]}
           },
           GridBoxAlignment->{"Columns" -> {{Center}}},
           GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], ")"}], 
         RowBox[{"(", GridBox[{
            {
             StyleBox[
              SubscriptBox["x", "1"],
              ScriptLevel->0]},
            {
             StyleBox[
              SubscriptBox["x", "2"],
              ScriptLevel->0]},
            {
             StyleBox["\[VerticalEllipsis]",
              ScriptLevel->0]},
            {
             StyleBox[
              SubscriptBox["x", "n"],
              ScriptLevel->0]}
           },
           GridBoxAlignment->{"Columns" -> {{Center}}},
           GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], ")"}]}],
         "=", 
        RowBox[{
         RowBox[{
          SubscriptBox["w", "1"], 
          SubscriptBox["x", "1"]}], "+", 
         RowBox[{
          SubscriptBox["w", "2"], 
          SubscriptBox["x", "2"]}], "+", "\[CenterEllipsis]", "+", 
         RowBox[{
          SubscriptBox["w", "n"], 
          SubscriptBox["x", "n"]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"17fbeeb9-e2d4-41ab-beb7-ca5c3652ce3a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"a", "=", 
    RowBox[{"\[Sigma]", "(", "z", ")"}], "=", 
    FractionBox["1", 
     RowBox[{"1", "+", 
      SuperscriptBox["e", 
       RowBox[{"-", "z"}]]}]]}], "        ", 
   StyleBox[
    RowBox[{"(", "2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"954dbe98-8957-4932-ba8d-15ac5b7d7fbb"],

Cell["\<\
The dot product w\[CenterDot]x is the matrix product of the row of weights \
with the column of inputs, as the second line of Eq. (1) shows: a 1 \[Times] \
n matrix times an n \[Times] 1 matrix gives a 1 \[Times] 1 matrix, the number \
z. Every computation in this notebook is built from this one product.\
\>", "Text",ExpressionUUID->"3ae7fd09-c365-4a09-88a7-bbcd149f9230"],

Cell["\<\
\[Sigma] squeezes any real number into (0, 1): very negative z gives almost \
0, very positive z almost 1, and z = 0 gives exactly 1/2. Its derivative has \
a convenient form, which backpropagation will use in every layer:\
\>", "Text",ExpressionUUID->"5bd30849-244e-4b78-927f-642a7e0175d0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Sigma]", "\[Prime]",
      MultilineFunction->None], "(", "z", ")"}], "=", 
    RowBox[{
     RowBox[{"\[Sigma]", "(", "z", ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"\[Sigma]", "(", "z", ")"}]}], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"3d624e72-fe02-4722-aa64-6f24cbc655da"],

Cell["\<\
With two inputs that are 0 or 1, one neuron can compute logic. The weights \
20, 20 and the bias -30 give z > 0 only when both inputs are 1: that is AND. \
With bias -10, z > 0 as soon as one input is 1: that is OR. The large weights \
make \[Sigma] nearly a step.\
\>", "Text",ExpressionUUID->"351b8b7a-e659-41c6-acc3-d471881cee59"],

Cell["\<\
Table 1. AND and OR computed by one neuron: z and \[Sigma](z) for all four \
inputs.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"850ed96a-5edb-4741-a146-a550ac660630"],

Cell[CellGroupData[{

Cell["\<\
(*c.1*)
(* one neuron, Eqs. (1)-(2): weighted sum plus bias, then \[Sigma] *)
neuron[w_, b_][x_] := LogisticSigmoid[w . x + b];
(* hand-picked weights: AND fires only when both inputs are 1,
   OR fires when at least one is *)
andN = neuron[{20, 20}, -30];
orN = neuron[{20, 20}, -10];
(* the four inputs (0,0), (0,1), (1,0), (1,1) *)
inputs = Tuples[{0, 1}, 2];
(* z = w\[CenterDot]x + b and the output \[Sigma](z) for every input *)
table[Prepend[
  Table[{x[[1]], x[[2]], {20, 20} . x - 30, NumberForm[N@andN[x], 3],
    {20, 20} . x - 10, NumberForm[N@orN[x], 3]}, {x, inputs}],
  {Subscript[\"x\", 1], Subscript[\"x\", 2], \"z (AND)\", \"\[Sigma](z) \
AND\",
   \"z (OR)\", \"\[Sigma](z) OR\"}], \"Table 1\"]\
\>", "Input",ExpressionUUID->"13a43d9c-ef43-4988-af55-b52c58357a9b"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
       SubscriptBox["\"x\"", "1"], 
       SubscriptBox["\"x\"", "2"], "\"z (AND)\"", "\"\[Sigma](z) AND\"", 
       "\"z (OR)\"", "\"\[Sigma](z) OR\""}, {"0", "0", 
       RowBox[{"-", "30"}], 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"9.36\"", "\[Times]", 
            SuperscriptBox["10", "\"-14\""]}], ShowStringCharacters -> False],
          9.3576229688393*^-14, AutoDelete -> True], NumberForm[#, 3]& ], 
       RowBox[{"-", "10"}], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.0000454\"", ShowStringCharacters -> False], 
         0.000045397868702434395`, AutoDelete -> True], 
        NumberForm[#, 3]& ]}, {"0", "1", 
       RowBox[{"-", "10"}], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.0000454\"", ShowStringCharacters -> False], 
         0.000045397868702434395`, AutoDelete -> True], NumberForm[#, 3]& ], 
       "10", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.\"", ShowStringCharacters -> False], 
         0.9999546021312976, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "1", "0", 
       RowBox[{"-", "10"}], 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.0000454\"", ShowStringCharacters -> False], 
         0.000045397868702434395`, AutoDelete -> True], NumberForm[#, 3]& ], 
       "10", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.\"", ShowStringCharacters -> False], 
         0.9999546021312976, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "1", "1", "10", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.\"", ShowStringCharacters -> False], 
         0.9999546021312976, AutoDelete -> True], NumberForm[#, 3]& ], "30", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.\"", ShowStringCharacters -> False], 
         0.9999999999999065, AutoDelete -> True], NumberForm[#, 3]& ]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 1\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"b45ad1a7-\
1a77-4eec-879f-df726f88f36f"]
}, Open  ]],

Cell["\<\
Table 1b. The AND neuron written as matrices: the row (20 20) times the input \
column, plus the bias, for each of the four inputs.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"e44d3bfe-0f55-460d-97b7-196d088d4a64"],

Cell[CellGroupData[{

Cell["\<\
(*c.1b*)
(* the AND neuron in matrix form: w is a 1\[Times]2 row, x a 2\[Times]1 \
column, and
   w\[CenterDot]x is the row times the column *)
wAND = {{20, 20}}; bAND = {-30};
table[Prepend[Table[{Row[{mat[wAND], \" \", col[x], \" + \", col[bAND],
       \" = \", col[wAND . x + bAND]}],
     NumberForm[N@LogisticSigmoid[First[wAND . x + bAND]], 3]},
    {x, inputs}], {\"z = w x + b\", \"\[Sigma](z)\"}],
 \"Table 1b. The AND neuron as a matrix product\"]\
\>", "Input",ExpressionUUID->"fa600086-7610-4f6f-9665-ef85a100534a"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"z = w x + b\"", "\"\[Sigma](z)\""}, {
       TemplateBox[{
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"20\"", ShowStringCharacters -> False], 20, 
                 Editable -> False], NumberForm[#, 3]& ], 
               TagBox[
                InterpretationBox[
                 StyleBox["\"20\"", ShowStringCharacters -> False], 20, 
                 Editable -> False], NumberForm[#, 3]& ]}}, RowSpacings -> 1, 
             ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
             Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"0\"", ShowStringCharacters -> False], 0, 
                 Editable -> False], NumberForm[#, 3]& ]}, {
               TagBox[
                InterpretationBox[
                 StyleBox["\"0\"", ShowStringCharacters -> False], 0, 
                 Editable -> False], NumberForm[#, 3]& ]}}, RowSpacings -> 1, 
             ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
             Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" + \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"-30\"", ShowStringCharacters -> False], -30, 
                 Editable -> False], NumberForm[#, 3]& ]}}, RowSpacings -> 1, 
             ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
             Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]], "\" = \"", 
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
               TagBox[
                InterpretationBox[
                 StyleBox["\"-30\"", ShowStringCharacters -> False], -30, 
                 Editable -> False], NumberForm[#, 3]& ]}}, RowSpacings -> 1, 
             ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
             Center], "\[NoBreak]", ")"}], 
          Function[BoxForm`e$, 
           MatrixForm[BoxForm`e$]]]}, "RowDefault"], 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"9.36\"", "\[Times]", 
            SuperscriptBox["10", "\"-14\""]}], ShowStringCharacters -> False],
          9.3576229688393*^-14, AutoDelete -> True], NumberForm[#, 3]& ]}, {
       TemplateBox[{
         TagBox[
          RowBox[{"(", "\[NoBreak]", 
            GridBox[{{
