Cell[CellGroupData[{

Cell["Backward: who is to blame?", "Subsection",ExpressionUUID->"fbed9f24-042a-4bec-b93a-2739e3983071"],

Cell[TextData[{
 "Now go from right to left. To improve, each weight must know how much the \
loss changes when it changes: the derivative \[PartialD]L/\[PartialD]w. The \
chain rule gives it as a product of the local derivatives along the path from \
the weight to the loss. The only derivative needed is that of \[Sigma], which \
is simply \[Sigma]\[Prime](z) = a (1 - a) (Eq. (3) below). The number \
\[Delta] = \[PartialD]L/\[PartialD]z of a neuron collects everything to its \
right, so it is computed once, at B first, and then passed back to A through \
the weight ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "B"], TraditionalForm]],ExpressionUUID->
  "e4b8b761-d32b-4004-b700-e0bdd34385c9"],
 ":"
}], "Text",ExpressionUUID->"6860b416-3ed1-45c8-92d1-dbb2b38f04bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", "B"], "=", 
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["z", "B"]}]], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "B"], "-", "y"}], ")"}], " ", 
      SubscriptBox["a", "B"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SubscriptBox["a", "B"]}], ")"}]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["w", "B"]}]], "=", 
     RowBox[{
      SubscriptBox["\[Delta]", "B"], " ", 
      SubscriptBox["a", "A"]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", "L"}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["b", "B"]}]], "=", 
     SubscriptBox["\[Delta]", "B"]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"9e0e4e3d-8b1d-4f30-8669-8c69e365d43e"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{
         SubscriptBox["\[Delta]", "A"], "=", 
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["z", "A"]}]], "=", 
         RowBox[{
          SubscriptBox["w", "B"], " ", 
          SubscriptBox["\[Delta]", "B"], " ", 
          SubscriptBox["a", "A"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SubscriptBox["a", "A"]}], ")"}]}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["w", "A"]}]], "=", 
         RowBox[{
          SubscriptBox["\[Delta]", "A"], " ", "x"}]}], 
        RowBox[{",", "    "}], 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["b", "A"]}]], "=", 
         SubscriptBox["\[Delta]", "A"]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", "L"}], 
         RowBox[{"\[PartialD]", 
          SubscriptBox["w", "A"]}]], "=", 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "L"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["a", "B"]}]], "\[CenterDot]", 
         FractionBox[
          RowBox[{"d", 
           SubscriptBox["a", "B"]}], 
          RowBox[{"d", 
           SubscriptBox["z", "B"]}]], "\[CenterDot]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["z", "B"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["a", "A"]}]], "\[CenterDot]", 
         FractionBox[
          RowBox[{"d", 
           SubscriptBox["a", "A"]}], 
          RowBox[{"d", 
           SubscriptBox["z", "A"]}]], "\[CenterDot]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           SubscriptBox["z", "A"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["w", "A"]}]]}], "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["a", "B"], "-", "y"}], ")"}], "\[CenterDot]", 
         RowBox[{
          SuperscriptBox["\[Sigma]", "\[Prime]",
           MultilineFunction->None], "(", 
          SubscriptBox["z", "B"], ")"}], "\[CenterDot]", 
         SubscriptBox["w", "B"], "\[CenterDot]", 
         RowBox[{
          SuperscriptBox["\[Sigma]", "\[Prime]",
           MultilineFunction->None], "(", 
          SubscriptBox["z", "A"], ")"}], "\[CenterDot]", "x"}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "0.4", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"550dea95-db8a-4e34-96e8-bf03ef6c3f67"],

Cell[TextData[{
 "The second line of Eq. (0.4) is the chain rule written out in full: five \
factors, one for each link from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "A"], TraditionalForm]],ExpressionUUID->
  "b841402f-7465-4336-9ccc-4f3fb597b739"],
 " to L. Backpropagation is nothing more than computing these products from \
right to left, so that the common factors are computed only once."
}], "Text",ExpressionUUID->"0449e688-2e89-452e-9b55-4c8319e6921d"],

Cell[TextData[{
 "Table 0.2. The backward pass. All four derivatives are negative: increasing \
any weight or bias would bring ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "B"], TraditionalForm]],ExpressionUUID->
  "9cf9a805-4a2b-4b4d-864d-90ea90827971"],
 " closer to 1."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"1f6bd921-478b-4bae-b072-2391d7706950"],

Cell[CellGroupData[{

Cell["\<\
(*c.0.2*)
(* backward pass, Eqs. (0.3)-(0.4): the chain rule from the loss back
   to every weight. \[Sigma]\[Prime](z) = a (1 - a), Eq. (3) *)
dB = (aB - yT) aB (1 - aB);          (* \[Delta]_B = \
\[PartialD]L/\[PartialD]z_B *)
gwB = dB aA;  gbB = dB;
dA = wB dB aA (1 - aA);              (* \[Delta]_A = \
\[PartialD]L/\[PartialD]z_A *)
gwA = dA xIn; gbA = dA;
bwd = {
   {\"\[Delta]_B = (a_B - y) a_B (1 - a_B)\", \"(\" <> nf[aB] <> \" - \" <>
     nf[yT] <> \") \[Times] \" <> nf[aB] <> \" \[Times] \" <> nf[1 - aB],
    dB},
   {\"\[PartialD]L/\[PartialD]w_B = \[Delta]_B a_A\",
    nf[dB] <> \" \[Times] \" <> nf[aA], gwB},
   {\"\[PartialD]L/\[PartialD]b_B = \[Delta]_B\", nf[dB], gbB},
   {\"\[Delta]_A = w_B \[Delta]_B a_A (1 - a_A)\", nf[wB] <> \" \[Times] \" \
<>
     nf[dB] <> \" \[Times] \" <> nf[aA] <> \" \[Times] \" <> nf[1 - aA], dA},
   {\"\[PartialD]L/\[PartialD]w_A = \[Delta]_A x\",
    nf[dA] <> \" \[Times] \" <> nf[xIn], gwA},
   {\"\[PartialD]L/\[PartialD]b_A = \[Delta]_A\", nf[dA], gbA}};
table[Prepend[MapIndexed[{#2[[1]] + 5, fm[#1[[1]]], #1[[2]],
     NumberForm[#1[[3]], 4]} &, bwd],
  {\"step\", \"formula\", \"numbers\", \"value\"}], \"Table 0.2. Backward \
pass\"]\
\>", "Input",ExpressionUUID->"384968a5-5e0a-4f67-9e65-366894e6c7ae"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"step\"", "\"formula\"", "\"numbers\"", "\"value\""}, {"6", 
       TemplateBox[{
         SubscriptBox["\"\[Delta]\"", "\"B\""], "\" = (\"", 
         SubscriptBox["\"a\"", "\"B\""], "\" - y) \"", 
         SubscriptBox["\"a\"", "\"B\""], "\" (1 - \"", 
         SubscriptBox["\"a\"", "\"B\""], "\")\""}, "RowDefault"], 
       "\"(0.5772 - 1.) \[Times] 0.5772 \[Times] 0.4228\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.1032\"", ShowStringCharacters -> False], -0.10318470181130271`,
          AutoDelete -> True], NumberForm[#, 4]& ]}, {"7", 
       TemplateBox[{"\"\[PartialD]L/\[PartialD]\"", 
         SubscriptBox["\"w\"", "\"B\""], "\" = \"", 
         SubscriptBox["\"\[Delta]\"", "\"B\""], "\" \"", 
         SubscriptBox["\"a\"", "\"A\""]}, "RowDefault"], 
       "\"(-0.1032) \[Times] 0.6225\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.06423\"", ShowStringCharacters -> False], -0.06422828047972629,
          AutoDelete -> True], NumberForm[#, 4]& ]}, {"8", 
       TemplateBox[{"\"\[PartialD]L/\[PartialD]\"", 
         SubscriptBox["\"b\"", "\"B\""], "\" = \"", 
         SubscriptBox["\"\[Delta]\"", "\"B\""]}, "RowDefault"], 
       "\"(-0.1032)\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.1032\"", ShowStringCharacters -> False], -0.10318470181130271`,
          AutoDelete -> True], NumberForm[#, 4]& ]}, {"9", 
       TemplateBox[{
         SubscriptBox["\"\[Delta]\"", "\"A\""], "\" = \"", 
         SubscriptBox["\"w\"", "\"B\""], "\" \"", 
         SubscriptBox["\"\[Delta]\"", "\"B\""], "\" \"", 
         SubscriptBox["\"a\"", "\"A\""], "\" (1 - \"", 
         SubscriptBox["\"a\"", "\"A\""], "\")\""}, "RowDefault"], 
       "\"0.5 \[Times] (-0.1032) \[Times] 0.6225 \[Times] 0.3775\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035364`, AutoDelete -> True], 
        NumberForm[#, 4]& ]}, {"10", 
       TemplateBox[{"\"\[PartialD]L/\[PartialD]\"", 
         SubscriptBox["\"w\"", "\"A\""], "\" = \"", 
         SubscriptBox["\"\[Delta]\"", "\"A\""], "\" x\""}, "RowDefault"], 
       "\"(-0.01212) \[Times] 1.\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035364`, AutoDelete -> True], 
        NumberForm[#, 4]& ]}, {"11", 
       TemplateBox[{"\"\[PartialD]L/\[PartialD]\"", 
         SubscriptBox["\"b\"", "\"A\""], "\" = \"", 
         SubscriptBox["\"\[Delta]\"", "\"A\""]}, "RowDefault"], 
       "\"(-0.01212)\"", 
       TagBox[
        InterpretationBox[
         StyleBox[
         "\"-0.01212\"", ShowStringCharacters -> 
          False], -0.012124393984035364`, AutoDelete -> True], 
        NumberForm[#, 4]& ]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox[
   "\"Table 0.2. Backward pass\"", Bold, FontSize -> 11, StripOnInput -> 
    False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",ExpressionUUID->"b7fcf340-\
000d-4d69-98cb-2f6a175728b7"]
