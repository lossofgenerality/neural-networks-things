Cell["\<\
Geometrically, \[Sigma](w\[CenterDot]x + b) > 1/2 exactly where \
w\[CenterDot]x + b > 0, which is one side of the line w\[CenterDot]x + b = 0. \
A neuron therefore splits the plane into two half-planes, with a soft \
transition of width about 1/|w| across the line.\
\>", "Text",ExpressionUUID->"d9bf93c6-0ab1-417a-b8b2-d7dbbcf197b8"],

Cell["\<\
Figure 1. The output of the AND and OR neurons over the plane, from blue (0) \
to red (1). The dashed line is w\[CenterDot]x + b = 0; white dots are inputs \
whose answer is 1.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"a72ef3e5-1641-4413-a4eb-9f3bee6d7920"],

Cell[CellGroupData[{

Cell["\<\
(*c.2*)
(* each neuron is a soft half-plane: \[Sigma](w\[CenterDot]x + b) > 1/2 \
exactly where
   w\[CenterDot]x + b > 0. The dashed line is the boundary w\[CenterDot]x + b \
= 0 *)
(* nf: the neuron, b: its bias, truth: the logic rule for the dots *)
gatePlot[nf_, b_, lbl_, truth_] := DensityPlot[nf[{x1, x2}],
   {x1, -0.25, 1.25}, {x2, -0.25, 1.25}, PlotRange -> {0, 1},
   ColorFunction -> \"TemperatureMap\", PlotPoints -> 40,
   FrameLabel -> {Subscript[\"x\", 1], Subscript[\"x\", 2]},
   FrameTicks -> {{{0, 0.5, 1}, None}, {{0, 0.5, 1}, None}},
   Epilog -> {Dashed, Thick, Black,
     (* the line 20 x1 + 20 x2 + b = 0, solved for x2 *)
     Line[{{-0.25, (-b - 20 (-0.25))/20}, {1.25, (-b - 20 1.25)/20}}],
     PointSize[0.05], Table[{If[truth[x] == 1, White, Black],
       Point[x]}, {x, inputs}]},
   Evaluate@panel[PlotLabel -> lbl]];
figure[{{gatePlot[andN, -30, \"1a. AND\", BitAnd @@ # &],
   gatePlot[orN, -10, \"1b. OR\", BitOr @@ # &]}},
 \"Figure 1. One neuron computes AND or OR (white = output 1)\"]\
\>", "Input",ExpressionUUID->"5bcc4a8b-dcfa-4bf2-99a9-04e87fd4f843"],

