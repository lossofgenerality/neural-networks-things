Cell["\<\
The same two neurons drawn as networks, the way every network in this \
notebook is drawn: squares are inputs, circles are neurons with their \
activation written inside (\[Sigma], or \[CapitalSigma] for a plain weighted \
sum with no \[Sigma]). Red lines are positive weights, blue lines negative \
ones, and a thicker line is a larger weight; on small networks the weights \
and biases are written out.\
\>", "Text",ExpressionUUID->"6f182287-27e2-4ffb-80b9-27948eac20e1"],

Cell["Diagram 1. The AND and OR neurons of Table 1.", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"5c4207b6-52da-40e2-a680-48268cd148f3"],

Cell[CellGroupData[{

Cell["\<\
(*c.2b*)
(* the AND and OR neurons as diagrams: squares are inputs, the circle
   is the neuron; numbers on the lines are weights, b is the bias *)
figure[{{netDiagram[{2, 1}, {{{{20, 20}}, {-30}}}, {Subscript[\"x\", 1],
      Subscript[\"x\", 2]}, {\"AND\"}, \"\[Sigma]\", \"D1a. AND\"],
   netDiagram[{2, 1}, {{{{20, 20}}, {-10}}}, {Subscript[\"x\", 1],
      Subscript[\"x\", 2]}, {\"OR\"}, \"\[Sigma]\", \"D1b. OR\"]}},
 \"Diagram 1. The neurons of Table 1\"]\
\>", "Input",ExpressionUUID->"0f0c6070-159c-4054-ade6-a214550dc4f5"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
       GraphicsBox[{{{{{
             RGBColor[0.85, 0.2, 0.1], 
             AbsoluteThickness[4.5], 
             LineBox[{{0., 0.5}, {2.4, 0.}}], 
             InsetBox[
