Cell[CellGroupData[{

Cell["2. A layer is a matrix product", "Section",ExpressionUUID->"bb3f5b94-ccb4-4244-9896-098d0086ee10"],

Cell["\<\
Put m neurons side by side, all reading the same input x. Their weight \
vectors become the rows of an m \[Times] n matrix W, their biases a vector b, \
and the whole layer is one matrix-vector product followed by \[Sigma] applied \
to each component:\
\>", "Text",ExpressionUUID->"aea2c376-fedd-4269-b009-55d3ee4771b1"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{"(", GridBox[{
           {
            StyleBox[
             SubscriptBox["z", "1"],
             ScriptLevel->0]},
           {
            StyleBox[
             SubscriptBox["z", "2"],
             ScriptLevel->0]},
           {
            StyleBox["\[VerticalEllipsis]",
             ScriptLevel->0]},
           {
            StyleBox[
             SubscriptBox["z", "m"],
             ScriptLevel->0]}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}},
          GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], ")"}], "=", 
        RowBox[{"(", GridBox[{
           {
            StyleBox[
             SubscriptBox["w", "11"],
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", "12"],
             ScriptLevel->0], 
            StyleBox["\[CenterEllipsis]",
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", 
              RowBox[{"1", "n"}]],
             ScriptLevel->0]},
           {
            StyleBox[
             SubscriptBox["w", "21"],
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", "22"],
             ScriptLevel->0], 
            StyleBox["\[CenterEllipsis]",
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", 
              RowBox[{"2", "n"}]],
             ScriptLevel->0]},
           {
            StyleBox["\[VerticalEllipsis]",
             ScriptLevel->0], 
            StyleBox["\[VerticalEllipsis]",
             ScriptLevel->0], 
            StyleBox["\[DescendingEllipsis]",
             ScriptLevel->0], 
            StyleBox["\[VerticalEllipsis]",
             ScriptLevel->0]},
           {
            StyleBox[
             SubscriptBox["w", 
              RowBox[{"m", "1"}]],
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", 
              RowBox[{"m", "2"}]],
             ScriptLevel->0], 
            StyleBox["\[CenterEllipsis]",
             ScriptLevel->0], 
            StyleBox[
             SubscriptBox["w", 
              RowBox[{"m", "n"}]],
             ScriptLevel->0]}
          },
