Cell[TextData[{
 "Table 3. Sup-norm error of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "e83de12c-8f63-4444-b801-bce02c693f4c"],
 " for the five examples: A sin(2\[Pi]x) + x\.b2/2, B |x - 1/2|, C \[Sqrt]x, \
D narrow bump, E step at 0.3."
}], "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"a9b609d8-cd18-4b1e-aa56-b82e7bccfa0a"],

Cell[CellGroupData[{

Cell["(*c.11*)\nallExamples = Prepend[examples, \"A\" -> f];\ntable[Prepend[\n  KeyValueMap[\n   Prepend[Table[NumberForm[supErr[#2, n], 2], {n, {5, 10, 20, 40, 80}}],\n     #1] &,\n   allExamples],\n  {\"\", \"N = 5\", \"N = 10\", \"N = 20\", \"N = 40\", \"N = 80\"}], \"Table 3\"]", "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"ee849764-1e3e-4954-adb8-f95a97533417"],

