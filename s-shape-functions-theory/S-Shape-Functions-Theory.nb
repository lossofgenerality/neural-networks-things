Cell[CellGroupData[{

Cell["0.7 One shape, many mechanisms", "Subsection",ExpressionUUID->"e6d8a056-7ee6-4bde-90d8-ca6a1e0faffe"],

Cell["\<\
Table 0.1. The six examples written as \[Sigma](slope \[Times] (input - \
threshold)).\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"6636df41-b293-4bc8-96d9-358981f94797"],

Cell[BoxData[GridBox[{
   {
    StyleBox["system",
     FontWeight->"Bold"], 
    StyleBox["input",
     FontWeight->"Bold"], 
    StyleBox["output",
     FontWeight->"Bold"], 
    StyleBox["threshold",
     FontWeight->"Bold"], 
    StyleBox["slope",
     FontWeight->"Bold"]},
   {
    RowBox[{"ion", " ", "channel", " ", 
     RowBox[{"(", "0.1", ")"}]}], 
    RowBox[{"voltage", " ", "V"}], 
    RowBox[{"open", " ", "probability"}], 
    RowBox[{"V1", "/", "2"}], 
    RowBox[{"zF", "/", 
     RowBox[{"(", "RT", ")"}]}]},
   {
    RowBox[{"hemoglobin", " ", 
     RowBox[{"(", "0.2", ")"}]}], 
    RowBox[{"ln", " ", "P"}], 
    RowBox[{"O2", " ", "saturation"}], 
    RowBox[{"P50", " ", "=", " ", 
     RowBox[{"26.8", " ", "mmHg"}]}], 
    RowBox[{"n", " ", "=", " ", "2.7"}]},
   {
    RowBox[{"hunchback", " ", "gene", " ", 
     RowBox[{"(", "0.3", ")"}]}], 
    RowBox[{"position", " ", "x"}], "expression", 
    RowBox[{"x0", " ", "=", " ", 
     RowBox[{"mid", "-", "embryo"}]}], 
    RowBox[{
     RowBox[{"H", "/", "\[Lambda]"}], ",", " ", 
     RowBox[{"H", " ", "=", " ", "5"}]}]},
   {
    RowBox[{"diffusion", " ", "front", " ", 
     RowBox[{"(", "0.4", ")"}]}], 
    RowBox[{"position", " ", "x"}], "concentration", 
    RowBox[{"x", " ", "=", " ", "0"}], 
