Cell[TextData[{
 "For \[Sqrt]x, \[Omega](\[Delta]) = \[Sqrt]\[Delta], which explains the O(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["N", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "66bb0f8e-d390-4b6d-8787-4640367ad084"],
 ") rate of example C. For the step, \[Omega](\[Delta]) = 1 for every \
\[Delta] > 0, which explains why example E never converges. (c.18 uses \
allExamples from c.11, so run section 4 first.)"
}], "Text",ExpressionUUID->"c421a72f-2cc5-46f7-84d9-a7eebf77397a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A.3 Examples of continuous functions", "Subsection",ExpressionUUID->"ffc44703-d069-45b7-a1ad-ba3943da62cc"],

Cell["\<\
Polynomials, exp, sin, cos, and all the sigmoids of Figure 1 except the step.\
\
\>", "Item",ExpressionUUID->"d06fe9ba-e6ac-4197-a8d8-0cc5fd6bf197"],

Cell["\<\
|x|: continuous everywhere, not differentiable at 0. Continuity is much \
weaker than smoothness.\
\>", "Item",ExpressionUUID->"7d76188c-ae8d-475c-b734-9b04eee5198c"],

Cell["\<\
\[Sqrt]x on [0, 1]: continuous, and uniformly so, but not Lipschitz, because \
its slope is unbounded near 0.\
\>", "Item",ExpressionUUID->"66d9a7ed-1ede-4290-92ed-e896740f0a31"],

Cell["\<\
x sin(1/x), with value 0 at 0: continuous at 0, because |x sin(1/x)| \
\[LessEqual] |x|, but it oscillates infinitely often near 0 and is not \
differentiable there.\
\>", "Item",ExpressionUUID->"c9064926-4a79-4839-a961-4d7ae7e6fa05"],

Cell[TextData[{
 "The Weierstrass function W(x) = \[Sum] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "k"], TraditionalForm]],ExpressionUUID->
  "21b2a933-45bf-4f1a-88ef-a49e13af4a20"],
 " cos(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "k"], TraditionalForm]],ExpressionUUID->
  "75ec05c3-7200-491d-a3ce-3b3cb30d0d64"],
 " \[Pi] x), with 0 < a < 1, b an odd integer, and a b > 1 + 3\[Pi]/2: \
continuous everywhere and differentiable nowhere. Figure 9 plots a partial \
sum."
}], "Item",ExpressionUUID->"3159ffc0-b225-4a34-b443-80e4b92c52af"],

Cell["\<\
The Cantor staircase (devil's staircase): continuous and increasing from 0 to \
1, yet flat on intervals of total length 1. Kolmogorov's inner functions are \
built in this spirit.\
\>", "Item",ExpressionUUID->"00d95892-6de8-4801-9165-1ecf4beb1882"],

Cell["\<\
Wolfram Language can test continuity with FunctionContinuous, and limits show \
what happens at the critical point:\
\>", "Text",ExpressionUUID->"f1d72bea-cef9-41d7-9f8c-25bf76492c5d"],

Cell[CellGroupData[{

Cell["\<\
(*c.19*)
<|
 \"x sin(1/x) away from 0\" -> FunctionContinuous[{x Sin[1/x], x != 0}, x],
 \"\[Sqrt]x on [0,1]\" -> FunctionContinuous[{Sqrt[x], 0 <= x <= 1}, x],
 \"|x|\" -> FunctionContinuous[Abs[x], x],
 \"1/x on (0,1]\" -> FunctionContinuous[{1/x, 0 < x <= 1}, x],
 \"step on \[DoubleStruckCapitalR]\" -> FunctionContinuous[UnitStep[x], x]|>\
\>", "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"b65ee2ec-04e1-4520-b556-8bf6fcf5fab4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"x sin(1/x) away from 0\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"\[Sqrt]x on [0,1]\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"|x|\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"1/x on (0,1]\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"step on \[DoubleStruckCapitalR]\"\>", "\[Rule]", "False"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.00378957499433*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"5d7dca6f-1257-4cce-bde3-fe1717c83259"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(*c.20*)\n<|\n \"x sin(1/x), x \[Rule] 0\" -> Limit[x Sin[1/x], x -> 0],\n \"sin(1/x), x \[Rule] 0\" -> Limit[Sin[1/x], x -> 0],\n \"step, from the left\" ->\n  Limit[UnitStep[x], x -> 0, Direction -> \"FromBelow\"],\n \"step, from the right\" ->\n  Limit[UnitStep[x], x -> 0, Direction -> \"FromAbove\"]|>", "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"320ced35-4138-4765-b4fe-f12a6ef5fd70"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"x sin(1/x), x \[Rule] 0\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"sin(1/x), x \[Rule] 0\"\>", "\[Rule]", "Indeterminate"}], ",", 
   RowBox[{"\<\"step, from the left\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"step, from the right\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.003789575001071*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"822e05e4-7303-4fe5-8ddb-7bbd5d6cf3cb"]
}, Open  ]],

Cell["\<\
The limit of x sin(1/x) is 0, which matches its value, so it is continuous at \
0. sin(1/x) has no limit (Indeterminate), and the step has different \
one-sided limits, 0 and 1, so neither can be made continuous at 0.\
\>", "Text",ExpressionUUID->"13db78e0-8a0a-45c7-946e-0ccc4e6e9ece"],

Cell["\<\
Figure 9. Continuous functions. 9a and 9b are tame; 9c, 9d and 9e are \
continuous but strange.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"ee191de6-57a3-4fdf-9ead-51d59ca3e1ed"],

Cell[CellGroupData[{

Cell["(*c.21*)\n(* partial sum of the Weierstrass function, a = 1/2, b = 13 *)\nweierstrass[x_, m_ : 6] := Sum[0.5^k Cos[13^k Pi x], {k, 0, m}];\npanel[opts___] :=\n  Sequence[opts, LabelStyle -> figStyle, ImageSize -> wHalf];\nLabeled[\n Grid[{\n   {Plot[Abs[x], {x, -1, 1}, Evaluate@panel[PlotLabel -> \"9a. |x|\"]],\n    Plot[Sqrt[x], {x, 0, 1}, Evaluate@panel[PlotLabel -> \"9b. \[Sqrt]x\"]]},\n   {Plot[x Sin[1/x], {x, -0.5, 0.5},\n     Evaluate@panel[PlotPoints -> 800, PlotLabel -> \"9c. x sin(1/x)\"]],\n    Plot[weierstrass[x], {x, 0, 1},\n     Evaluate@panel[PlotPoints -> 3000, MaxRecursion -> 0,\n       PlotLabel -> \"9d. Weierstrass\"]]},\n   {Plot[CantorStaircase[x], {x, 0, 1},\n     Evaluate@panel[PlotLabel -> \"9e. Cantor staircase\"]], \"\"}}],\n Style[\"Figure 9\", figFont], Top]", "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"d7ecf627-d911-4354-960b-1b0fe9e870f8"],

