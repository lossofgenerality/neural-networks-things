Cell[TextData[{
 "In practice the inner weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "2a6ba3b4-278f-48f8-a980-ca22910a69e1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "a80293e2-0e26-43cf-94e6-bf69e1e2db6e"],
 " are not placed by hand. A quick experiment: choose them at random, then \
solve a linear least-squares problem for the outer weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "3f8f7016-bf1a-437a-98fa-a62ffc454352"],
 " of Eq. (3). This only finds the best \[Alpha] for random inner weights, so \
it is weaker than full training, yet the error still falls fast as N grows."
}], "Text",ExpressionUUID->"d3175b85-3a0c-478f-9904-f5e411e40591"],

Cell["(*c.13*)\nSeedRandom[3];\ntrainPts = RandomReal[{-1, 1}, {2000, 2}];\ntestPts = RandomReal[{-1, 1}, {2000, 2}];\nhidden[pts_, Yin_, th_] :=\n  LogisticSigmoid[pts . Transpose[Yin] + ConstantArray[th, Length[pts]]];\nfit[nh_] := Module[\n   {Yr = RandomReal[{-6, 6}, {nh, 2}], th = RandomReal[{-6, 6}, nh], a},\n   a = LeastSquares[hidden[trainPts, Yr, th], g @@@ trainPts];\n   {Yr, th, a}];", "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"c7c69859-8189-4a23-a2fa-e72c5ecc29a8"],

Cell["\<\
Table 4. Maximum error on 2000 test points, for N random hidden units.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"438392ce-2d0c-41c9-8b57-85cde337f7fb"],

Cell[CellGroupData[{

Cell["(*c.14*)\ntable[Prepend[\n  Table[With[{m = fit[nh]},\n    {nh, Max@Abs[\n       hidden[testPts, m[[1]], m[[2]]] . m[[3]] - g @@@ testPts]}],\n   {nh, {10, 50, 200}}],\n  {\"N\", \"max test error\"}], \"Table 4\"]", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"a51000ac-63a1-45af-839e-379cad91a803"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"N\"", "\"max test error\""}, {"10", "1.0325899101915295`"}, {
      "50", "0.09059271349638794`"}, {"200", "0.00012055595505800626`"}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 4\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.003789574752758*^9},
 CellLabel->"Out[89]=",ExpressionUUID->"a990bd72-d960-4c10-ae5e-16e37e957281"]
}, Open  ]],

Cell[TextData[{
 "In a test run the maximum error went from about 1 with N = 10, to under 0.1 \
with N = 50, to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "4"}]], TraditionalForm]],ExpressionUUID->
  "54a3a590-0a3f-4eb2-b0d6-462251b1e95d"],
 " with N = 200."
}], "Text",ExpressionUUID->"a3d19a1d-c426-4c33-9d0c-667769afefbb"],

Cell["\<\
Figure 7. Left: the fit by a sum of 100 sigmoids, to compare with Figure 6. \
Right: the error g - G, on a much smaller vertical scale.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"7c9040c7-a5f1-48c0-b3e5-053422d1bff9"],

Cell[CellGroupData[{

Cell["(*c.15*)\nWith[{m = fit[100]},\n Module[{G100},\n  G100[x_?NumericQ, y_?NumericQ] :=\n   First[hidden[{{x, y}}, m[[1]], m[[2]]] . m[[3]]];\n  Labeled[\n   Grid[{{\n      Plot3D[G100[x, y], {x, -1, 1}, {y, -1, 1},\n       ColorFunction -> \"TemperatureMap\",\n       PlotLabel -> \"7a. fit, N = 100\", LabelStyle -> figStyle,\n       ImageSize -> wHalf],\n      Plot3D[g[x, y] - G100[x, y], {x, -1, 1}, {y, -1, 1},\n       PlotRange -> All, PlotLabel -> \"7b. error g - G\",\n       LabelStyle -> figStyle, ImageSize -> wHalf]}}],\n   Style[\"Figure 7\", figFont], Top]]]", "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"3c1e2692-05b8-4d26-865b-63acbb24c65f"],

