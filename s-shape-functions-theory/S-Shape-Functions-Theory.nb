Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"B", "(", "x", ")"}], "=", 
    RowBox[{
     SubscriptBox["B", "A"], 
     SuperscriptBox["e", 
      RowBox[{"-", 
       RowBox[{"x", "/", "\[Lambda]"}]}]]}], ",", "   ", 
    RowBox[{
     RowBox[{"hb", "(", "x", ")"}], "=", 
     FractionBox[
      SuperscriptBox["B", "H"], 
      RowBox[{
       SuperscriptBox["B", "H"], "+", 
       SubsuperscriptBox["B", "0", "H"]}]], "=", 
     RowBox[{"\[Sigma]", "(", 
      RowBox[{"-", 
       FractionBox["H", "\[Lambda]"], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"23321e5d-d379-4615-9f50-fed297471d55"],

Cell[TextData[{
 "An exponential gradient fed into a Hill function gives exactly a logistic \
function of position, centred at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "816d3d41-cf9e-44aa-bb4f-0ce640cdf0a2"],
 " = \[Lambda] ln(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "A"], TraditionalForm]],ExpressionUUID->
  "2714d4c2-f7be-4519-b4c9-d28de76a6f2d"],
 "/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "0"], TraditionalForm]],ExpressionUUID->
  "b30b1260-7ccc-4516-a4ab-9272baf94e66"],
 ") with width \[Lambda]/H. A larger Hill coefficient H gives a sharper \
boundary. Figure 0.3 uses a decay length \[Lambda] of a fifth of the embryo \
length, of the order of the 120 \[Mu]m used in one recent model [0.10], and \
places the boundary at mid-embryo."
}], "Text",ExpressionUUID->"b182d6a8-5a05-4565-aec0-c9a3ee8c1cf5"],

Cell["\<\
Figure 0.3. The Bicoid gradient (dashed) and the hunchback response of Eq. \
(0.3) for H = 1, 3 and 5. Position is measured as a fraction of the embryo \
length, from head (0) to tail (1).\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"c3c8ea28-a5c0-437c-9975-3cf2095b3162"],

Cell[CellGroupData[{

Cell["(*c.0.3*)\nPrint[\"Hill of exponential = logistic: \",\n  FullSimplify[(b Exp[-x/l])^h/((b Exp[-x/l])^h + b0^h) ==\n    LogisticSigmoid[-(h/l) (x - l Log[b/b0])],\n   b > 0 && b0 > 0 && l > 0 && h > 0 && x \[Element] Reals]];\n(* decay length and boundary, as fractions of the embryo length *)\n\[Lambda]b = 0.2; x0 = 0.5;\nhb[x_, h_] := LogisticSigmoid[-(h/\[Lambda]b) (x - x0)];\nPlot[Evaluate@Join[{Exp[-x/\[Lambda]b]}, Table[hb[x, h], {h, {1, 3, 5}}]],\n {x, 0, 1},\n PlotStyle -> {Dashed, Automatic, Automatic, Automatic},\n AxesLabel -> {\"x/L\", \"level\"},\n PlotLabel -> \"Figure 0.3. Bicoid \[Rule] hunchback\",\n PlotLegends -> Placed[LineLegend[{\"Bicoid\", \"H = 1\", \"H = 3\", \"H = 5\"},\n    LabelStyle -> figStyle], Below],\n LabelStyle -> figStyle, ImageSize -> wFull]", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"560bba39-e2d8-47e8-a792-b4a5e52d4283"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Hill of exponential = logistic: \"\>", "\[InvisibleSpace]", 
   "True"}],
  SequenceForm["Hill of exponential = logistic: ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.0037895624771633`*^9},
 CellLabel->
  "During evaluation of \
In[24]:=",ExpressionUUID->"650f2de2-15dd-46e4-95fd-d9a81ed63793"],

