Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"S", "(", "P", ")"}], "=", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"P", "/", 
        SubscriptBox["P", "50"]}], ")"}], "n"], 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"P", "/", 
         SubscriptBox["P", "50"]}], ")"}], "n"]}]], "=", 
    RowBox[{"\[Sigma]", "(", 
     RowBox[{"n", " ", 
      RowBox[{"ln", "(", 
       RowBox[{"P", "/", 
        SubscriptBox["P", "50"]}], ")"}]}], ")"}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"dd21353f-e146-4436-92ad-1a07151dc108"],

Cell["\<\
The second form shows that the Hill curve is the logistic function of the \
logarithm of the pressure. On a linear pressure axis it is S-shaped only when \
n > 1; that is why the shape is the signature of cooperativity. The S-shape \
is what makes blood work: nearly full in the lungs (about 100 mmHg), yet \
giving up a quarter of its oxygen in resting tissue (about 40 mmHg).\
\>", "Text",ExpressionUUID->"411ba89a-ce57-49ae-846b-323b66873984"],

Cell[TextData[{
 "Figure 0.2. Oxygen saturation of hemoglobin (n = 2.7, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "50"], TraditionalForm]],ExpressionUUID->
  "45bfc652-8ed8-433e-b869-8fa675569cad"],
 " = 26.8 mmHg) and of myoglobin (n = 1, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "50"], TraditionalForm]],ExpressionUUID->
  "afefc567-8092-4491-874f-e17ffec2db51"],
 " = 2.8 mmHg, a typical textbook value). Grid lines mark venous (40 mmHg) \
and arterial (100 mmHg) pressure."
}], "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"8952a996-7250-40a2-b2fc-694be875fd72"],

Cell[CellGroupData[{

Cell["(*c.0.2*)\nhill[p_, p50_, n_] := (p/p50)^n/(1 + (p/p50)^n);\nPrint[\"Hill form = logistic of log P: \",\n  FullSimplify[hill[p, p50, n] == LogisticSigmoid[n Log[p/p50]],\n   p > 0 && p50 > 0 && n > 0]];\nPrint[\"hemoglobin saturation at 40 and 100 mmHg: \",\n  {hill[40., 26.8, 2.7], hill[100., 26.8, 2.7]}];\nPlot[{hill[p, 26.8, 2.7], hill[p, 2.8, 1]}, {p, 0, 120},\n PlotRange -> {0, 1.02}, GridLines -> {{40, 100}, None},\n AxesLabel -> {\"P (mmHg)\", \"S\"}, PlotLabel -> \"Figure 0.2. Oxygen binding\",\n PlotLegends -> Placed[\n   LineLegend[{\"hemoglobin, n = 2.7\", \"myoglobin, n = 1\"},\n    LabelStyle -> figStyle], Below],\n LabelStyle -> figStyle, ImageSize -> wFull]", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"8027b456-60b4-4b0c-8f07-73e473a2b0b6"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Hill form = logistic of log P: \"\>", "\[InvisibleSpace]", 
   "True"}],
  SequenceForm["Hill form = logistic of log P: ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.003789558678309*^9},
