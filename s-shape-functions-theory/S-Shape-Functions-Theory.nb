Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"d", "N"}], 
      RowBox[{"d", "t"}]], "=", 
     RowBox[{"r", " ", "N", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["N", "K"]}], ")"}]}]}], "   ", "\[DoubleLongRightArrow]", 
    "   ", 
    RowBox[{
     RowBox[{"N", "(", "t", ")"}], "=", 
     RowBox[{"K", " ", 
      RowBox[{"\[Sigma]", "(", 
       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"t", "-", 
          SubscriptBox["t", 
           RowBox[{"1", "/", "2"}]]}], ")"}]}], ")"}]}]}], ",", "   ", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"1", "/", "2"}]], "=", 
     FractionBox[
      RowBox[{"ln", "(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"K", "-", 
          SubscriptBox["N", "0"]}], ")"}], "/", 
        SubscriptBox["N", "0"]}], ")"}], "r"]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.5", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"e3655bbe-947f-4635-bdb3-afa9aefd2e49"],

Cell[TextData[{
 "Figure 0.5 uses values fitted to Gause's data for Paramecium aurelia grown \
alone: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "0"], TraditionalForm]],ExpressionUUID->
  "dc7dc527-ddad-465f-942b-c99498b362e0"],
 " = 0.6, r = 0.8 per day and K = 230, with population measured as a \
standardized volume [0.13]."
}], "Text",ExpressionUUID->"fcfcaf95-054e-4d6f-9734-8cf3d84a3aee"],

Cell["\<\
Figure 0.5. Logistic growth of Paramecium aurelia, Eq. (0.5). The dashed line \
is the carrying capacity K.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"898c1a9a-7bd2-4f1d-a52a-bd2d7aecf105"],

Cell[CellGroupData[{

Cell["(*c.0.5*)\nlogistic[t_, n0_, r_, k_] := k/(1 + (k - n0)/n0 Exp[-r t]);\nPrint[\"Eq. (0.5), logistic form: \",\n  FullSimplify[\n   logistic[t, n0, r, k] == k LogisticSigmoid[r (t - Log[(k - n0)/n0]/r)],\n   k > n0 > 0 && r > 0]];\nPlot[logistic[t, 0.6, 0.8, 230], {t, 0, 25}, GridLines -> {None, {230}},\n GridLinesStyle -> Dashed, AxesLabel -> {\"t (days)\", \"N\"},\n PlotLabel -> \"Figure 0.5. Paramecium aurelia\", LabelStyle -> figStyle,\n ImageSize -> wFull]", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"94d725f0-87ff-4c4d-9523-66e62ae8937d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Eq. (0.5), logistic form: \"\>", "\[InvisibleSpace]", "True"}],
  
  SequenceForm["Eq. (0.5), logistic form: ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.003789563014758*^9},
 CellLabel->
  "During evaluation of \
In[36]:=",ExpressionUUID->"26eef66d-379d-4fde-9453-e0b6a9fdbcbd"],

