     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", "Dt", ")"}]}]}], ")"}]}]},
   {
    RowBox[{"population", " ", 
     RowBox[{"(", "0.5", ")"}]}], 
