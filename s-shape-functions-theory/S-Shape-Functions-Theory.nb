Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "open"], "(", "V", ")"}], "=", 
    FractionBox["1", 
     RowBox[{"1", "+", 
      SuperscriptBox["e", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"z", " ", "F", 
          RowBox[{"(", 
           RowBox[{"V", "-", 
            SubscriptBox["V", 
             RowBox[{"1", "/", "2"}]]}], ")"}]}], 
         RowBox[{"R", " ", "T"}]]}]]}]], "=", 
    RowBox[{"\[Sigma]", "(", 
     FractionBox[
      RowBox[{"V", "-", 
       SubscriptBox["V", 
        RowBox[{"1", "/", "2"}]]}], "k"], ")"}], ",", "   ", 
    RowBox[{"k", "=", 
     FractionBox[
      RowBox[{"R", " ", "T"}], 
      RowBox[{"z", " ", "F"}]]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"c066863c-319b-4cc4-854b-75a8f9b5991e"],

Cell[TextData[{
 "At body temperature RT/F is about 26.7 mV, so a channel that moves z = 4 \
elementary charges has a slope k of about 6.7 mV: a change of a few \
millivolts switches it from mostly closed to mostly open. Figure 0.1 uses an \
illustrative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "61dce2ad-805f-4ae4-9a31-aa81a9e9b415"],
 " = -30 mV."
}], "Text",ExpressionUUID->"26ce28c3-4662-4bf9-b19f-a05c9915329f"],

Cell["\<\
Figure 0.1. Open probability of a voltage-gated channel, Eq. (0.1), for \
gating charges z = 1, 2, 4 and 6. More charge gives a steeper switch.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"3fe9d999-ad2d-48f4-b4c8-948d2b16be05"],

Cell[CellGroupData[{

Cell["(*c.0.1*)\nrtf = 26.7;   (* RT/F at 37 \[Degree]C, in mV *)\npOpen[v_, vHalf_, z_] := LogisticSigmoid[z (v - vHalf)/rtf];\nPlot[Evaluate@Table[pOpen[v, -30, z], {z, {1, 2, 4, 6}}], {v, -120, 60},\n AxesLabel -> {\"V (mV)\", \"P\"}, PlotLabel -> \"Figure 0.1. Voltage gating\",\n PlotLegends -> Placed[LineLegend[{\"z = 1\", \"z = 2\", \"z = 4\", \"z = 6\"},\n    LabelStyle -> figStyle], Below],\n LabelStyle -> figStyle, ImageSize -> wFull]", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"bcc751f3-6a84-471a-b5d2-1325193fead7"],

