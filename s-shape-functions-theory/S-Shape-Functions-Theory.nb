Cell["Table 7. The examples and counterexamples at a glance.", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"e2a3be7d-c454-44cf-bbe3-17af3fc0f000"],

Cell[BoxData[GridBox[{
   {
    StyleBox["function",
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{"continuous", "?"}],
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{"uniformly", " ", 
      RowBox[{"continuous", "?"}]}],
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{"differentiable", "?"}],
     FontWeight->"Bold"]},
   {
    RowBox[{"|", 
     RowBox[{"x", " ", "-", " ", 
      RowBox[{"1", "/", "2"}]}], "|", " ", 
     RowBox[{"on", " ", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], "yes", "yes", 
    RowBox[{"except", " ", "at", " ", 
     RowBox[{"1", "/", "2"}]}]},
   {
    RowBox[{
     RowBox[{"\[Sqrt]", "x"}], " ", 
     RowBox[{"on", " ", "[", 
      RowBox[{"0", ",", "1"}], "]"}]}], "yes", "yes", 
    RowBox[{"except", " ", "at", " ", "0"}]},
   {
    RowBox[{
     RowBox[{"x", " ", "sin", 
      RowBox[{"(", 
       RowBox[{"1", "/", "x"}], ")"}]}], ",", " ", 
     RowBox[{"0", " ", "at", " ", "0"}]}], "yes", 
    RowBox[{"yes", " ", 
     RowBox[{"on", " ", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "]"}]}], 
    RowBox[{"except", " ", "at", " ", "0"}]},
   {
    RowBox[{"Weierstrass", " ", "W"}], "yes", "yes", "nowhere"},
   {
    RowBox[{"Cantor", " ", "staircase"}], "yes", "yes", 
    RowBox[{"slope", " ", "0", " ", "almost", " ", "everywhere"}]},
   {
    RowBox[{"step", " ", "at", " ", "0.3"}], 
    RowBox[{"no", " ", 
     RowBox[{"(", "jump", ")"}]}], "no", 
    RowBox[{"except", " ", "at", " ", "0.3"}]},
   {
    RowBox[{"sin", 
     RowBox[{"(", 
      RowBox[{"1", "/", "x"}], ")"}]}], 
    RowBox[{"no", " ", 
     RowBox[{"(", 
      RowBox[{"at", " ", "0"}], ")"}]}], "no", 
    RowBox[{"except", " ", "at", " ", "0"}]},
   {
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "x"}], " ", "on", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", "1"}]}]}], "]"}], "yes", "no", "yes"},
   {"Dirichlet", "nowhere", "no", "nowhere"},
   {"Thomae", 
    RowBox[{"at", " ", "irrationals", " ", "only"}], "no", "nowhere"}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.5}}}]], "Text",
 AutoSpacing->False,
 ShowStringCharacters->False,
 FontFamily->"Source Sans Pro",
 FontSize->10,ExpressionUUID->"a0da0f72-7866-4474-9141-eecee184286d"]
