Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"R", "(", "c", ")"}], "=", 
    RowBox[{
     SubscriptBox["R", "max"], 
     FractionBox[
      SuperscriptBox["c", "n"], 
      RowBox[{
       SuperscriptBox["c", "n"], "+", 
       SubsuperscriptBox["c", "50", "n"]}]]}], "=", 
    RowBox[{
     SubscriptBox["R", "max"], " ", 
     RowBox[{"\[Sigma]", "(", 
      RowBox[{"n", " ", 
       RowBox[{"ln", "(", 
        RowBox[{"c", "/", 
         SubscriptBox["c", "50"]}], ")"}]}], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "0.6", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"9202b5ea-0452-4762-bcea-5726c7b599e2"],

Cell[TextData[{
 "This is the Hill equation (0.2) again, in a new place: biology reuses the \
same S-shape for very different mechanisms. It is also the closest biological \
relative of the artificial neuron of section 3: an input, a threshold ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "50"], TraditionalForm]],ExpressionUUID->
  "d1619df8-1d4e-4286-abac-d1cd636be33e"],
 ", a slope n, and a saturating output. Figure 0.6 uses the illustrative \
values n = 2 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "50"], TraditionalForm]],ExpressionUUID->
  "f30152ba-e5ff-45d3-9fdd-8f30a5e6e9e0"],
 " = 0.2."
}], "Text",ExpressionUUID->"8957be8e-745f-4a3e-b35c-2f8592dd74c2"],

Cell["\<\
Figure 0.6. Contrast response of a model visual neuron, Eq. (0.6), against \
log contrast, for n = 1, 2 and 4.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"3d3dcaaf-22eb-476d-b4d6-eb85bdf76022"],

Cell[CellGroupData[{

Cell["(*c.0.6*)\nnaka[c_, n_, c50_] := c^n/(c^n + c50^n);\nLogLinearPlot[Evaluate@Table[naka[c, n, 0.2], {n, {1, 2, 4}}],\n {c, 0.005, 1},\n Ticks -> {{0.01, 0.1, 1}, Automatic},\n AxesLabel -> {\"contrast c\", \"R/Rmax\"},\n PlotLabel -> \"Figure 0.6. Visual neuron\",\n PlotLegends -> Placed[LineLegend[{\"n = 1\", \"n = 2\", \"n = 4\"},\n    LabelStyle -> figStyle], Below],\n LabelStyle -> figStyle, ImageSize -> wFull]", "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"d44a1aa6-4d8b-4bf9-b15f-af8eceb209a3"],

