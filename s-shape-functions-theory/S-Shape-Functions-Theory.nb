          0.03023952191885318], InsetBox[
          StyleBox[
           SubscriptBox["\<\"\[CapitalPhi]\"\>", "3"],
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontSize->14,
           FontColor->GrayLevel[0]], 
          Offset[{0, 2}, {4.055555627008614, 1.6783302266658844}], 
          ImageScaled[{0.5, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{4.055555653803511, 1.8541020435304167`}, 
          0.03023952191885318], InsetBox[
          StyleBox[
           SubscriptBox["\<\"\[CapitalPhi]\"\>", "4"],
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontSize->14,
           FontColor->GrayLevel[0]], 
          Offset[{0, 2}, {4.055555653803511, 1.88434156544927}], ImageScaled[{0.5, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{5.055555600213717, 1.442079360443593}, 0.03023952191885318],
          InsetBox[
          StyleBox["\<\"f\"\>",
           StripOnInput->False,
           LineColor->GrayLevel[0],
           FrontFaceColor->GrayLevel[0],
           BackFaceColor->GrayLevel[0],
           GraphicsColor->GrayLevel[0],
           FontSize->14,
           FontColor->GrayLevel[0]], 
          Offset[{0, 2}, {5.055555600213717, 1.4723188823624462}], 
          ImageScaled[{0.5, 0}],
          BaseStyle->"Graphics"]}}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  ImageSize->440,
  PlotLabel->FormBox[
    StyleBox[
    "\"Figure 8. Kolmogorov network, n = 2\"", 14, StripOnInput -> False], 
    TraditionalForm]]], "Output",
 CellChangeTimes->{4.003789574853993*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"53500815-5c03-4555-b300-f5db1655b028"]
}, Open  ]],

Cell["\<\
The catch is that the inner functions are pathological. They are continuous \
but extremely rough, like the Weierstrass and Cantor functions of Figure 9 \
(Appendix A), with fractal-like graphs built from devil's-staircase \
constructions, and the outer functions inherit that roughness. Results going \
back to Vitushkin show that, in general, the representation is impossible \
with smooth inner functions.\
\>", "Text",ExpressionUUID->"5fb610ad-c858-4ce0-90f5-dffade1613a1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Connecting the two theorems", "Section",ExpressionUUID->"38d0c221-cceb-4e14-a26c-7d114af9fe87"],

Cell["\<\
Write Cybenko's sum, Eq. (3), with the inner product spelled out, next to \
Kolmogorov's formula, Eq. (8):\
\>", "Text",ExpressionUUID->"42a38803-2f90-4b9a-b3a5-363967cc702a"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"G", "(", "x", ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "N"], 
       RowBox[{
        SubscriptBox["\[Alpha]", "j"], " ", 
        RowBox[{"\[Sigma]", "(", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"p", "=", "1"}], "n"], 
           RowBox[{
            SubscriptBox["y", 
             RowBox[{"j", "p"}]], 
            SubscriptBox["x", "p"]}]}], "+", 
          SubscriptBox["\[Theta]", "j"]}], ")"}]}]}], "      ", 
      StyleBox[
       RowBox[{"(", "Cybenko", ")"}],
       FontSlant->"Plain"]}]},
    {
     RowBox[{
      RowBox[{"f", "(", "x", ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"q", "=", "0"}], 
        RowBox[{"2", "n"}]], 
       RowBox[{
        SubscriptBox["\[CapitalPhi]", "q"], 
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"p", "=", "1"}], "n"], 
          RowBox[{
           SubscriptBox["\[Psi]", 
            RowBox[{"p", ",", "q"}]], "(", 
           SubscriptBox["x", "p"], ")"}]}], ")"}]}]}], "      ", 
      StyleBox[
       RowBox[{"(", "Kolmogorov", ")"}],
       FontSlant->"Plain"]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1}}}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"2c7c21fd-9753-\
4b37-8d31-d8a411c484db"],

Cell[TextData[{
 "The two sides of Eq. (9) match term by term. Cybenko's network is a \
Kolmogorov representation in which the inner functions are linear, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Psi]", 
      RowBox[{"p", ",", "j"}]], "(", 
     SubscriptBox["x", "p"], ")"}], "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"j", "p"}]], 
     SubscriptBox["x", "p"]}]}], TraditionalForm]],ExpressionUUID->
  "a64e39c3-84ee-43dd-b3b7-6b1477d350b4"],
 ", and every outer function is a scaled and shifted copy of the same \
S-shape, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "j"], "(", "s", ")"}], "=", 
    RowBox[{
     SubscriptBox["\[Alpha]", "j"], 
     RowBox[{"\[Sigma]", "(", 
      RowBox[{"s", "+", 
       SubscriptBox["\[Theta]", "j"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"eb1adaa1-ab5e-49dd-9b4e-cc729480962c"],
 ". In the pictures, Figure 8 becomes Figure 3 when you move the flexibility \
off the node functions and onto weights on the arrows. Trading Kolmogorov's \
wild, special-purpose functions for one simple, smooth, fixed one costs two \
things: the representation is no longer exact, and the number of terms is no \
longer 2n + 1 but N(\[CurlyEpsilon]), which may be enormous."
}], "Text",ExpressionUUID->"01628da3-c314-46f2-9636-c6bbdb2d8b22"],

Cell["Table 5. The two theorems compared.", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"04b63c98-b20b-4949-a066-a64c87cf8e0d"],

Cell[BoxData[GridBox[{
   {
    StyleBox["",
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{
      RowBox[{"Kolmogorov", " ", 
       RowBox[{"(", "1957", ")"}]}], ",", " ", 
      RowBox[{"Eq", ".", " ", 
       RowBox[{"(", "8", ")"}]}]}],
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{
      RowBox[{"Cybenko", " ", 
       RowBox[{"(", "1989", ")"}]}], ",", " ", 
      RowBox[{"Eq", ".", " ", 
       RowBox[{"(", "3", ")"}]}]}],
     FontWeight->"Bold"]},
   {"result", 
    RowBox[{"exact", " ", "representation"}], 
    RowBox[{
    "approximation", " ", "to", " ", "any", " ", "\[CurlyEpsilon]"}]},
   {
    RowBox[{"number", " ", "of", " ", "terms"}], 
    RowBox[{
     RowBox[{
      RowBox[{"2", "n"}], " ", "+", " ", "1"}], ",", " ", "fixed"}], 
    RowBox[{"N", ",", " ", 
     RowBox[{
      RowBox[{"grows", " ", "as", " ", "\[CurlyEpsilon]"}], " ", "\[Rule]", 
      " ", "0"}]}]},
   {
    RowBox[{"inner", " ", "functions"}], 
    RowBox[{"special", ",", " ", 
     RowBox[{"very", " ", "rough"}], ",", " ", 
     RowBox[{"independent", " ", "of", " ", "f"}]}], 
    RowBox[{"linear", ":", " ", 
     RowBox[{
      RowBox[{"y", "\[CenterDot]", "x"}], " ", "+", " ", "\[Theta]"}]}]},
   {
    RowBox[{"outer", " ", "functions"}], 
    RowBox[{
     RowBox[{"depend", " ", "on", " ", "f"}], ",", " ", "rough"}], 
    RowBox[{
     RowBox[{"one", " ", "fixed", " ", "smooth", " ", "\[Sigma]"}], ",", " ", 
     
     RowBox[{"scaled", " ", "by", " ", SubscriptBox["\[Alpha]", "j"]}]}]},
   {
    RowBox[{"arrows", " ", "in", " ", "the", " ", "diagram"}], 
    RowBox[{
     RowBox[{"carry", " ", "values"}], ",", " ", 
     RowBox[{"no", " ", "weights", " ", 
      RowBox[{"(", 
       RowBox[{"Figure", " ", "8"}], ")"}]}]}], 
    RowBox[{"carry", " ", "values", " ", "times", " ", "weights", " ", 
     RowBox[{"(", 
      RowBox[{"Figure", " ", "3"}], ")"}]}]},
   {
    RowBox[{"network", " ", "reading"}], 
    RowBox[{"two", " ", "hidden", " ", "layers", " ", 
     RowBox[{"(", 
      RowBox[{"Hecht", "-", "Nielsen"}], ")"}]}], 
    RowBox[{"one", " ", "hidden", " ", "layer"}]},
   {"proof", 
    RowBox[{"explicit", " ", "construction"}], 
    RowBox[{"existence", " ", 
     RowBox[{"(", 
      RowBox[{"Hahn", "\[Dash]", "Banach", ",", " ", "Riesz"}], ")"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.5}}}]], "Text",
 AutoSpacing->False,
 ShowStringCharacters->False,
 FontFamily->"Source Sans Pro",
 FontSize->10,ExpressionUUID->"db2c775c-a646-49ee-95fb-97a74a4c2f2b"],

Cell["\<\
Cybenko makes the contrast himself. He notes Kolmogorov's exact \
representation, but points out that it uses different nonlinear functions for \
different purposes, while he wants one fixed univariate function, and that \
asking for exact representation is asking too much.\
\>", "Text",ExpressionUUID->"99a3be0e-47db-45e5-a28f-d5f8031bcf10"],

Cell[CellGroupData[{

Cell["The relevance debate", "Subsection",ExpressionUUID->"f6e728f6-822c-4f38-87e6-10a7c60688ca"],

Cell["\<\
Hecht-Nielsen (1987) proposed Kolmogorov's theorem as a foundation for neural \
networks (the \"Kolmogorov mapping neural network existence theorem\").\
\>", "Item",ExpressionUUID->"f093f98f-be84-4546-99e5-5476253f5b85"],

Cell["\<\
Girosi and Poggio (1989) answered with \"Kolmogorov's theorem is \
irrelevant\": the inner functions are far too rough to learn or to generalize \
from, and the outer ones depend on f in an uncontrolled way.\
\>", "Item",ExpressionUUID->"f69fd0f3-c36c-4cd0-834c-08df65631b29"],

Cell["\<\
K\[URing]rkov\[AAcute] (1991, \"Kolmogorov's theorem is relevant\"; 1992) \
replied that you do not need the exact theorem: approximating its ingredients \
with staircases of sigmoids gives universal approximation with two hidden \
layers, together with estimates of how many hidden units are needed.\
\>", "Item",ExpressionUUID->"52153993-238b-425c-9fa8-cd8fd22e4878"],

Cell["\<\
Schmidt-Hieber (2021) revisited the theorem and argued that it is more \
naturally read as a deep network, which deep ReLU networks can approximate \
well.\
\>", "Item",ExpressionUUID->"c78b3bd4-910e-49f1-bb27-a07f0157d7fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["After Cybenko: the S-shape is sufficient but not necessary", \
"Subsection",ExpressionUUID->"5c2a8bc5-e1f5-448d-ae6c-a40688c64a37"],

Cell[TextData[{
 StyleBox["Theorem 6 (Hornik, Stinchcombe and White 1989). ",
  FontWeight->"Bold"],
 "If \[Psi] is any squashing function (nondecreasing, with limits 0 and 1), \
one-hidden-layer networks with activation \[Psi] approximate every continuous \
function on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  ExpressionUUID->"37ca534b-a15a-455d-b41c-e29ba1d83d0e"],
 " uniformly on compact sets, and every Borel measurable function in measure. \
The proof uses the Stone\[Dash]Weierstrass theorem."
}], "Item",ExpressionUUID->"bbaff94b-1130-47da-9c9b-d5510fb20123"],

Cell[TextData[{
 StyleBox["Theorem 7 (Hornik 1991). ",
  FontWeight->"Bold"],
 "If the activation is bounded and nonconstant, one-hidden-layer networks are \
dense in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["L", "p"], TraditionalForm]],ExpressionUUID->
  "67ac1228-b286-4fa0-bb5a-42b50c3175bd"],
 "(\[Mu]) for every finite measure \[Mu] on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  ExpressionUUID->"cb717ba9-a264-4ce6-b825-07e87e127fb5"],
 " and 1 \[LessEqual] p < \[Infinity]. If it is also continuous, they \
approximate every continuous function uniformly on compact sets. The S-shape \
itself is not needed."
}], "Item",ExpressionUUID->"ee89a446-81aa-4f8a-9bb0-d689086ca83b"],

Cell[TextData[{
 StyleBox["Theorem 8 (Leshno, Lin, Pinkus and Schocken 1993). ",
  FontWeight->"Bold"],
 "Let the activation \[Sigma] be locally bounded and piecewise continuous. \
One-hidden-layer networks approximate every continuous function on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "n"], TraditionalForm]],
  ExpressionUUID->"0d89d008-616a-4299-866c-231813de12bc"],
 " uniformly on compact sets if and only if \[Sigma] is not a polynomial. \
This covers ReLU, which is not S-shaped at all."
}], "Item",ExpressionUUID->"dab9d051-8961-4e9e-ac92-bab3216d15e7"],

Cell["\<\
Barron (1993) gave approximation rates for sigmoidal networks that, for a \
suitable class of functions, do not grow exponentially with the dimension.\
\>", "Item",ExpressionUUID->"2fcea2dd-d90c-467e-8723-ae00d4c8aaa7"],

Cell["\<\
Liu et al. (2024), \"KAN: Kolmogorov\[Dash]Arnold Networks\", returned to the \
Kolmogorov form of Figure 8: learnable one-variable functions (splines) on \
the edges and plain addition at the nodes.\
\>", "Item",ExpressionUUID->"924b4ad3-6684-4bb6-8495-140dc6340c06"],

Cell["\<\
So why S-shapes historically? They are the smallest change from the \
biological threshold neuron that makes gradient training possible, and they \
were the setting in which universality was first proved. Their limits at \
\[PlusMinus]\[Infinity], Eq. (1), are exactly what turns a sum of them into a \
staircase that can follow any continuous function.\
\>", "Text",ExpressionUUID->"320db7df-5f6a-4ce1-b20c-b9b8ea7b2adb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Exercises", "Section",ExpressionUUID->"f91374c4-56cc-4bc4-8f7c-35ae77fc9fef"],

Cell["\<\
Repeat the staircase experiment of section 4 (Table 3) with the arctan and \
algebraic sigmoids. Why do you need a larger \[Lambda] for the same error?\
\>", "Item",ExpressionUUID->"a8a06498-81d6-4a42-8225-7cbcf755e37c"],

Cell["\<\
Try a non-monotone function such as \[Sigma](t) + sin(t) exp(-t\.b2). Is it \
sigmoidal in the sense of Eq. (1), and does the staircase still converge?\
\>", "Item",ExpressionUUID->"f50d4e0b-79c4-4487-8462-ecf3178ce9dd"],

Cell["\<\
Try the least-squares fit of section 5 (Table 4) with \[Sigma](t) = t\.b2, a \
polynomial. The error stops improving. Which of Theorems 1\[Dash]8 explains \
this?\
\>", "Item",ExpressionUUID->"13c25190-6682-4a04-b6f3-b26c568f1556"],

Cell["\<\
Write x y z as a superposition in the form of Eq. (8), using one-variable \
functions and addition, valid for positive x, y, z.\
\>", "Item",ExpressionUUID->"5106ab1c-7af0-4220-bd84-e743ed09d317"],

Cell["\<\
Show that one step of BasicRecurrentLayer, tanh(W x + U h + b), is a \
Cybenko-type sum when you take (x, h) as the input. Draw its graph in the \
style of Figure 3. Which arrow would you add to make it recurrent?\
\>", "Item",ExpressionUUID->"9fe08506-1701-4b6a-9cf5-183ed0b93eb1"],

Cell[TextData[{
 "Use Eq. (5) to write \[PartialD]G/\[PartialD]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "761421bc-c41b-4778-9eef-c51f0fc6d393"],
 " and \[PartialD]G/\[PartialD]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "ji"], TraditionalForm]],ExpressionUUID->
  "fe76b678-9eb3-480b-a566-c63510554756"],
 ", and check both against D as in c.7."
}], "Item",ExpressionUUID->"06f7d63e-4b1f-4914-95ac-9dda0ae75601"],

Cell["\<\
Run the staircase of section 4 on x sin(1/x) (with value 0 at 0) and on the \
Cantor staircase of Figure 9. Predict the rate of convergence from the \
modulus of continuity, Eq. (12), before you measure it.\
\>", "Item",ExpressionUUID->"440e532d-f18e-48c4-9fac-760c1e56936f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Appendix A. Continuous functions", "Section",ExpressionUUID->"c5c0f5a5-be54-4076-b3d9-a5dc1894c1b0"],

Cell[TextData[{
 "Both theorems are about continuous functions: Cybenko's approximates every \
function in C(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "n"], TraditionalForm]],ExpressionUUID->
  "ce8cb6d3-c08c-4e4d-8f11-0f88f16bd732"],
 "), and Kolmogorov's represents every continuous function exactly. This \
appendix collects what continuity means, how it differs from uniform \
continuity, and some examples and counterexamples, several of which appear in \
the main text."
}], "Text",ExpressionUUID->"8ec611ab-36f7-424e-aade-54fb41bb0e9c"],

Cell[CellGroupData[{

Cell["A.1 Definition", "Subsection",ExpressionUUID->"51cb2f01-5076-4055-9329-e78c606adf0e"],

Cell["\<\
In everyday terms: f is continuous at a point a if a small change in the \
input near a produces only a small change in the output. On an interval, the \
graph of a continuous function can be drawn without lifting the pen. In \
mathematical terms, f: D \[Rule] \[DoubleStruckCapitalR] is continuous at a \
\[Element] D if\
\>", "Text",ExpressionUUID->"c8b6bd08-8b9f-4608-83f8-ca57c7f2d914"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
     "\[ForAll]", "\[CurlyEpsilon]", ">", "0", "  ", "\[Exists]", "\[Delta]", 
      ">", "0", "  ", "\[ForAll]", 
      RowBox[{"x", "\[Element]", "D"}], ":"}]},
    {
     RowBox[{"    ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"x", "-", "a"}], "\[RightBracketingBar]"}], "<", 
        "\[Delta]"}], "   ", "\[DoubleLongRightArrow]", "   ", 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{
          RowBox[{"f", "(", "x", ")"}], "-", 
          RowBox[{"f", "(", "a", ")"}]}], "\[RightBracketingBar]"}], "<", 
        "\[CurlyEpsilon]"}]}]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1}}}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"9e08cd3a-bce8-\
476b-a3fd-f7b0de6e8d47"],

Cell["f is continuous on D if Eq. (10) holds at every point of D.", "Item",ExpressionUUID->"ecf92a76-b5e6-40a3-b37b-d8e0e655e233"],

Cell[TextData[{
 "Equivalent forms: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["lim", 
    RowBox[{"x", "\[Rule]", "a"}]], TraditionalForm]],ExpressionUUID->
  "7320f7a8-de3a-4bfa-904d-bd1452601579"],
 " f(x) = f(a); or, for every sequence ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "1bcb238b-2c9e-44de-9d5b-5bb4cb9f0233"],
 " \[Rule] a, f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "97963de1-0c1c-4a13-a09d-1edef0bc8253"],
 ") \[Rule] f(a)."
}], "Item",ExpressionUUID->"79ff2638-56f0-4610-ae44-81ff075122f5"],

Cell[TextData[{
 "For functions of several variables, replace |x - a| by the Euclidean \
distance \[LeftDoubleBracketingBar]x - a\[RightDoubleBracketingBar]. This is \
the sense used for C(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "n"], TraditionalForm]],ExpressionUUID->
  "9c6b0ccb-628d-4038-9e80-06b6e49af99a"],
 ")."
}], "Item",ExpressionUUID->"8643597f-8772-4997-a1a5-8ba0f4694ed0"],

Cell["\<\
Sums, products, quotients (where defined) and compositions of continuous \
functions are continuous. That is why every network in Eq. (3), (4) and (7) \
with a continuous \[Sigma] is a continuous function.\
\>", "Item",ExpressionUUID->"a691b7a4-e373-49fa-9397-a93ea0ae74ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A.2 Uniform continuity and the modulus of continuity", "Subsection",ExpressionUUID->"478f125b-6f10-46b4-a805-49f2981d7fd1"],

Cell["\<\
In Eq. (10), \[Delta] may depend on the point a. If one \[Delta] works for \
all points at once, f is uniformly continuous:\
\>", "Text",ExpressionUUID->"9d46ee5f-9715-48b2-a548-90158de69229"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
     "\[ForAll]", "\[CurlyEpsilon]", ">", "0", "  ", "\[Exists]", "\[Delta]", 
      ">", "0", "  ", "\[ForAll]", 
      RowBox[{"x", ",", 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], "\[Element]", "D"}]}], ":"}]},
    {
     RowBox[{"    ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"x", "-", 
          SuperscriptBox["x", "\[Prime]"]}], "\[RightBracketingBar]"}], "<", 
        "\[Delta]"}], "   ", "\[DoubleLongRightArrow]", "   ", 
       RowBox[{
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{
          RowBox[{"f", "(", "x", ")"}], "-", 
          RowBox[{"f", "(", 
           SuperscriptBox["x", "\[Prime]"], ")"}]}], 
         "\[RightBracketingBar]"}], "<", "\[CurlyEpsilon]"}]}]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1}}}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"c59210e8-9284-\
4865-af9c-05ab794d2498"],

Cell["\<\
The modulus of continuity measures the largest change of f over distances up \
to \[Delta]:\
\>", "Text",ExpressionUUID->"d5cbfedd-ba60-4404-9f9c-208c67a1af23"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["\[Omega]", "f"], "(", "\[Delta]", ")"}], "=", 
      RowBox[{
       UnderscriptBox["sup", 
        RowBox[{
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{"x", "-", 
           SuperscriptBox["x", "\[Prime]"]}], "\[RightBracketingBar]"}], "\[LessEqual]",
          "\[Delta]"}]], 
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         RowBox[{"f", "(", "x", ")"}], "-", 
         RowBox[{"f", "(", 
          SuperscriptBox["x", "\[Prime]"], ")"}]}], 
        "\[RightBracketingBar]"}]}]}]},
    {
     RowBox[{"f", " ", 
      StyleBox[
       RowBox[{"uniformly", " ", "continuous"}],
       FontSlant->"Plain"], "   ", "\[DoubleLongLeftRightArrow]", "   ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Omega]", "f"], "(", "\[Delta]", ")"}], "\[Rule]", 
       "0"}], "  ", 
      StyleBox["as",
       FontSlant->"Plain"], "  ", 
      RowBox[{"\[Delta]", "\[Rule]", "0"}]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1}}}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"ba03a9f4-11dd-\
4877-82b2-dbc835ad4d26"],

Cell[TextData[{
 StyleBox["Theorem 9 (Heine\[Dash]Cantor). ",
  FontWeight->"Bold"],
 "A continuous function on a closed, bounded set, such as [0, 1] or the cube ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "n"], TraditionalForm]],ExpressionUUID->
  "35bf43d4-2d39-4907-bba3-535995ead867"],
 ", is uniformly continuous."
}], "Item",ExpressionUUID->"305206b5-a6da-4a11-8f68-95ba5ecd37fa"],

Cell[TextData[{
 StyleBox["Theorem 10 (extreme value theorem). ",
  FontWeight->"Bold"],
 "A continuous function on a closed, bounded set attains its maximum and \
minimum. So the sup norm \[LeftDoubleBracketingBar]f\
\[RightDoubleBracketingBar] = max |f| is finite, and C(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "n"], TraditionalForm]],ExpressionUUID->
  "8e20530f-5595-412f-b4a9-79776185399d"],
 ") with this norm is the space in Theorems 1 and 2."
}], "Item",ExpressionUUID->"5406ef64-9eb1-479c-83dc-280ae96d307c"],

Cell[TextData[{
 "Why it matters here: the staircase error in section 4 is of the order of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "cc6bfb0a-7642-4bb6-9bc8-fd15da5b6858"],
 "(1/N). It goes to 0 for every continuous f on [0, 1] because of Theorem 9, \
and it does not go to 0 for the jump in example E."
}], "Item",ExpressionUUID->"472e2b57-e7de-4d00-81c5-8b7148a1b4e5"],

Cell[TextData[{
 "Table 6. The modulus of continuity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "686c654e-7b0d-4b5c-8827-f97349fda184"],
 "(\[Delta]) of the section 4 examples, computed on a grid. Compare its decay \
with the error columns of Table 3. Rows A\[Dash]E as in Table 3."
}], "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"f27e12e9-6432-4c9b-8730-d6e75e42340b"],

Cell[CellGroupData[{

Cell["(*c.18*)\nomega[fun_, \[Delta]_] := Quiet@Module[\n   {xs = Range[0., 1. - \[Delta], \[Delta]/50]},\n   Max@Table[\n     Max@Abs[fun /@ (x + Range[0., \[Delta], \[Delta]/10]) - fun[x]],\n     {x, xs}]];\ntable[Prepend[\n  KeyValueMap[\n   Prepend[Table[NumberForm[omega[#2, 1./n], 2], {n, {5, 10, 20, 40, 80}}],\n     #1] &,\n   allExamples],\n  {\"\", \"\[Delta] = 1/5\", \"\[Delta] = 1/10\", \"\[Delta] = 1/20\",\n   \"\[Delta] = 1/40\", \"\[Delta] = 1/80\"}], \"Table 6\"]", "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"c2f81166-443e-49bd-b861-2f8403398116"],

