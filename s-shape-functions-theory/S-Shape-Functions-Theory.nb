Cell[CellGroupData[{

Cell["A.4 Counterexamples", "Subsection",ExpressionUUID->"ba8fc7de-8376-491b-9f7f-77a4bdeb4b8e"],

Cell["\<\
The Heaviside step: a jump at 0. Its left limit is 0 and its right limit is \
1, so no value at 0 makes it continuous. Example E of section 4 shows the \
consequence for approximation.\
\>", "Item",ExpressionUUID->"e36fce31-26be-40bf-b934-ad706f71725b"],

Cell["\<\
sin(1/x), with any value at 0: it oscillates between -1 and 1 infinitely \
often near 0, so it has no limit there.\
\>", "Item",ExpressionUUID->"1efd0176-3919-4463-bd8f-7e30a0d9a056"],

Cell["\<\
The Dirichlet function, 1 on the rationals and 0 on the irrationals: \
discontinuous at every point. It cannot be meaningfully plotted.\
\>", "Item",ExpressionUUID->"abeb3a5e-f51d-4f56-b7a9-8b463dd0da12"],

Cell["\<\
Thomae's function, 1/q at x = p/q in lowest terms and 0 at irrationals: \
discontinuous at every rational and continuous at every irrational.\
\>", "Item",ExpressionUUID->"fb6617ca-99fe-440f-b5cf-b487572627c9"],

Cell[TextData[{
 "1/x on (0, 1]: continuous at every point of its domain, but not uniformly \
continuous and not bounded. The domain is not closed, so Theorem 9 does not \
apply. This is why both theorems work on the closed cube ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}], "n"], TraditionalForm]],ExpressionUUID->
  "08f86d46-68aa-4e19-9a51-67f3f73f57c9"],
 "."
}], "Item",ExpressionUUID->"4a4fb413-270a-4767-b544-0b7080c6670d"],

Cell["\<\
x\.b2 on all of \[DoubleStruckCapitalR]: continuous but not uniformly \
continuous, because the domain is unbounded.\
\>", "Item",ExpressionUUID->"fc6359e4-9113-4a0d-a6c8-c9e874c0a44d"],

Cell["\<\
Figure 10. 10a\[Dash]10c are not continuous. 10d is continuous but not \
uniformly continuous.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"5e248343-1a76-4255-af5d-0aabcc9cda48"],

Cell[CellGroupData[{

Cell["(*c.22*)\nLabeled[\n Grid[{\n   {Plot[UnitStep[x], {x, -1, 1}, Exclusions -> {0},\n     ExclusionsStyle -> Dashed,\n     Epilog -> {PointSize[0.04], Point[{0, 1}], EdgeForm[Black], White,\n       Disk[{0, 0}, Offset[4]]},\n     Evaluate@panel[PlotLabel -> \"10a. step: jump\"]],\n    Plot[Sin[1/x], {x, -0.5, 0.5},\n     Evaluate@panel[PlotPoints -> 800, PlotLabel -> \"10b. sin(1/x)\"]]},\n   {ListPlot[\n     DeleteDuplicates@Flatten[Table[{p/q, 1/q}, {q, 1, 60}, {p, 0, q}], 1],\n     Evaluate@panel[PlotRange -> {0, 1.05}, PlotStyle -> PointSize[Tiny],\n       PlotLabel -> \"10c. Thomae\"]],\n    Plot[1/x, {x, 0.01, 1},\n     Evaluate@panel[PlotRange -> {0, 40},\n       PlotLabel -> \"10d. 1/x on (0,1]\"]]}}],\n Style[\"Figure 10\", figFont], Top]", "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"05873383-aae8-4255-92eb-17e2e66a9d24"],

