Cell["\<\
Measure the uniform (sup-norm) error on a fine grid, with steepness \[Lambda] \
= 20N:\
\>", "Text",ExpressionUUID->"a2f35c47-4f6e-4b1c-842d-c592e2564edd"],

Cell[TextData[{
 "Table 2. Sup-norm error of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "5d75f83d-d024-4500-8722-946c5b5f41ac"],
 " for example A: it halves each time N doubles."
}], "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"ef6881fc-cf45-49e7-b505-b452c8a5dccc"],

Cell[CellGroupData[{

Cell["(*c.9*)\nsupErr[fun_, n_] := Quiet@Max@Table[\n    Abs[fun[x] - stair[fun, n, 20 n][x]], {x, 0., 1., 0.0005}];\ntable[Prepend[Table[{n, supErr[f, n]}, {n, {5, 10, 20, 40, 80}}],\n  {\"N\", \"max error\"}], \"Table 2\"]", "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"da6c08b9-2ee4-4b13-85fe-c177edacf034"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"N\"", "\"max error\""}, {"5", "0.4418673063485891`"}, {
      "10", "0.22048265898962874`"}, {"20", "0.1101856867163859`"}, {
      "40", "0.055095367076768875`"}, {"80", "0.02755076500710002`"}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 2\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.003789566280198*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"fbfb7d73-34ab-4449-9605-056b42fb18be"]
}, Open  ]],

Cell["The error goes 0.44, 0.22, 0.11, 0.055, 0.028: it is O(1/N).", "Text",ExpressionUUID->"ab7767e1-8688-43b8-ac69-fb1cfb7b667d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Examples B\[Dash]E: harder functions, and one the theorem does not cover\
\>", "Subsection",ExpressionUUID->"2fc5976d-025a-4ce8-a771-5ec9daeacaa5"],

Cell["\<\
The same construction applied to four more functions on [0, 1]:\
\>", "Text",ExpressionUUID->"0e23e1f0-db81-4e46-afd6-eca655cb1f36"],

Cell["\<\
B: |x - 1/2|, continuous but with a kink (no derivative) at 1/2.\
\>", "Item",ExpressionUUID->"8a2fca52-59b5-4718-800f-19f879617e9d"],

Cell["C: \[Sqrt]x, continuous, but its slope is infinite at 0.", "Item",ExpressionUUID->"119be6e9-1b10-4a37-bfff-d2bba8ccd6d8"],

Cell["\<\
D: exp(-200 (x - 1/2)\.b2), smooth but a narrow bump about 0.1 wide.\
\>", "Item",ExpressionUUID->"4c76d25d-1642-4558-b363-3a6f736ffb47"],

Cell["\<\
E: the step UnitStep[x - 0.3], which jumps at 0.3 and is not continuous. \
Cybenko's theorem says nothing about uniform approximation of such a function.\
\>", "Item",ExpressionUUID->"cbf570e9-b844-4bb3-8531-e1f68e239247"],

Cell[TextData[{
 "Figure 5. Examples B\[Dash]E (blue) and their staircases ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "10"], TraditionalForm]],ExpressionUUID->
  "2de50487-8ffb-4234-bdae-5a27fab3d7e0"],
 " (orange)."
}], "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"54955bf0-ed3b-4ea2-8286-1f2ae78f3c52"],

Cell[CellGroupData[{

Cell["(*c.10*)\nexamples = <|\n   \"B\" -> (Abs[# - 1/2] &),\n   \"C\" -> (Sqrt[#] &),\n   \"D\" -> (Exp[-200 (# - 1/2)^2] &),\n   \"E\" -> (UnitStep[# - 0.3] &)|>;\nexampleNames = <|\"A\" -> \"sin(2\[Pi]x) + x\.b2/2\", \"B\" -> \"|x - 1/2|\",\n   \"C\" -> \"\[Sqrt]x\", \"D\" -> \"narrow bump\", \"E\" -> \"step at 0.3\"|>;\nLabeled[\n Grid[Partition[\n   KeyValueMap[\n    Plot[{#2[x], stair[#2, 10, 200][x]}, {x, 0, 1},\n      PlotRange -> All, Exclusions -> None,\n      PlotLabel -> #1 <> \": \" <> exampleNames[#1],\n      LabelStyle -> figStyle, ImageSize -> wHalf] &,\n    examples], 2]],\n Style[\"Figure 5. Examples B\[Dash]E, N = 10\", figFont], Top]", "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"192524bd-c9c5-4bf9-9891-1ec944ee0cb1"],

