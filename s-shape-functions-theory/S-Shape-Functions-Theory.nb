Cell[CellGroupData[{

Cell["3. Cybenko's theorem (1989)", "Section",ExpressionUUID->"9d99e51b-3338-45a9-8ede-d1e9787fbea2"],

Cell["\<\
G. Cybenko, \"Approximation by superpositions of a sigmoidal function\", \
Mathematics of Control, Signals, and Systems 2 (1989) 303\[Dash]314. The \
question: can finite sums of one fixed S-shaped function, applied to affine \
combinations of the inputs, approximate every continuous function? Such sums \
have the form\
\>", "Text",ExpressionUUID->"0e4f41ca-8c1f-4d0a-8343-06f96dd0c7d4"],

Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{"G", "(", "x", ")"}], "=", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "N"], 
       RowBox[{
        SubscriptBox["\[Alpha]", "j"], " ", 
        RowBox[{"\[Sigma]", "(", 
         RowBox[{
          RowBox[{
           SubsuperscriptBox["y", "j", "\[Transpose]"], "x"}], "+", 
          SubscriptBox["\[Theta]", "j"]}], ")"}]}]}]}]},
    {
     RowBox[{
      StyleBox["where",
       FontSlant->"Plain"], "  ", 
      RowBox[{"x", "\[Element]", 
       RowBox[{
        SubscriptBox["I", "n"], "=", 
        SuperscriptBox[
         RowBox[{"[", 
          RowBox[{"0", ",", "1"}], "]"}], "n"]}]}], ",", "   ", 
      RowBox[{
       SubscriptBox["y", "j"], "\[Element]", 
       SuperscriptBox["\[DoubleStruckCapitalR]", "n"]}], ",", "   ", 
      RowBox[{
       SubscriptBox["\[Alpha]", "j"], ",", 
       SubscriptBox["\[Theta]", "j"], "\[Element]", 
       "\[DoubleStruckCapitalR]"}]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxSpacings->{"Rows" -> {{1}}}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"207cd1fb-f272-\
4eae-acf1-383037c74872"],

Cell[TextData[{
 "Eq. (3) is exactly a neural network with one hidden layer of N units: unit \
j computes \[Sigma](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "38e201ee-536b-43c9-9930-7babcb3ee8b0"],
 "\[CenterDot]x + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "10af9881-f28a-4d47-85f3-dca37b394876"],
 "), and the output is a linear combination of the units. Figure 3 draws it \
for n = 2 inputs and N = 3 hidden units."
}], "Text",ExpressionUUID->"815d600f-603f-4981-a358-d110b3df74b3"],

Cell["\<\
Figure 3. Cybenko's network for n = 2, N = 3. Red labels are the weights \
carried by the arrows.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"33c47af8-31d5-42b0-9a0c-d6469f51ea62"],

Cell[CellGroupData[{

Cell["(*c.6*)\nnH = 3;\ninE = Flatten@Table[DirectedEdge[Subscript[\"x\", i], Subscript[\"h\", j]],\n    {i, 2}, {j, nH}];\noutE = Table[DirectedEdge[Subscript[\"h\", j], \"G\"], {j, nH}];\nedgeLbl = Join[\n   Flatten@Table[DirectedEdge[Subscript[\"x\", i], Subscript[\"h\", j]] ->\n      Placed[Subscript[\"y\", ToString[j] <> ToString[i]], 0.78],\n     {i, 2}, {j, nH}],\n   Table[DirectedEdge[Subscript[\"h\", j], \"G\"] ->\n     Placed[Subscript[\"\[Alpha]\", j], 0.5], {j, nH}]];\ncoords = {Subscript[\"x\", 1] -> {0, 2.2}, Subscript[\"x\", 2] -> {0, 0.8},\n   Subscript[\"h\", 1] -> {3, 3}, Subscript[\"h\", 2] -> {3, 1.5},\n   Subscript[\"h\", 3] -> {3, 0}, \"G\" -> {6, 1.5}};\nGraph[Join[inE, outE], VertexCoordinates -> coords,\n VertexLabels -> Placed[\"Name\", Above],\n VertexLabelStyle -> Directive[Black, figFont],\n EdgeLabels -> edgeLbl,\n EdgeLabelStyle -> Directive[figFont, Darker[Red], Background -> White],\n VertexSize -> 0.25, EdgeStyle -> Arrowheads[0.03], ImageSize -> wFull,\n PlotLabel -> Style[\"Figure 3. One hidden layer, N = 3\", figFont]]", "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"7b15ec47-a76a-41fa-9a0e-2071f68b0fa6"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{
       Subscript["x", 1], 
       Subscript["h", 1], 
       Subscript["h", 2], 
       Subscript["h", 3], 
       Subscript["x", 2], "G"}, {{{1, 2}, {1, 3}, {1, 4}, {5, 2}, {5, 3}, {5, 
       4}, {2, 6}, {3, 6}, {4, 6}}, Null}, {EdgeLabels -> {DirectedEdge[
           Subscript["x", 2], 
           Subscript["h", 1]] -> Placed[
           Subscript["y", "12"], 0.78], DirectedEdge[
           Subscript["x", 1], 
           Subscript["h", 1]] -> Placed[
           Subscript["y", "11"], 0.78], DirectedEdge[
           Subscript["h", 2], "G"] -> Placed[
           Subscript["\[Alpha]", 2], 0.5], DirectedEdge[
           Subscript["x", 2], 
           Subscript["h", 2]] -> Placed[
           Subscript["y", "22"], 0.78], DirectedEdge[
           Subscript["x", 2], 
           Subscript["h", 3]] -> Placed[
           Subscript["y", "32"], 0.78], DirectedEdge[
           Subscript["x", 1], 
           Subscript["h", 2]] -> Placed[
           Subscript["y", "21"], 0.78], DirectedEdge[
           Subscript["h", 3], "G"] -> Placed[
           Subscript["\[Alpha]", 3], 0.5], DirectedEdge[
           Subscript["x", 1], 
           Subscript["h", 3]] -> Placed[
           Subscript["y", "31"], 0.78], DirectedEdge[
           Subscript["h", 1], "G"] -> Placed[
           Subscript["\[Alpha]", 1], 0.5]}, EdgeLabelStyle -> {
         Directive[14, 
          RGBColor[
           Rational[2, 3], 0, 0], Background -> GrayLevel[1]]}, 
       EdgeStyle -> {
         Arrowheads[0.03]}, ImageSize -> 440, PlotLabel -> 
       Style["Figure 3. One hidden layer, N = 3", 14], 
       VertexCoordinates -> {{0, 2.2}, {3, 3}, {3, 1.5}, {3, 0}, {0, 0.8}, {
         6, 1.5}}, VertexLabels -> {
         Placed["Name", Above]}, VertexLabelStyle -> {
         Directive[
          GrayLevel[0], 14]}, VertexSize -> {0.25}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.03], {
         TagBox[
          ArrowBox[{
           DynamicLocation["VertexID$1", Automatic, Center], DynamicLocation[
            "VertexID$2", Automatic, Center]}],
          "DynamicName",
          BoxID -> "EdgeLabelID$1"], InsetBox[
          StyleBox[
           SubscriptBox["\<\"y\"\>", "\<\"11\"\>"],
           StripOnInput->False,
           LineColor->RGBColor[
             Rational[2, 3], 0, 0],
           FrontFaceColor->RGBColor[
             Rational[2, 3], 0, 0],
           BackFaceColor->RGBColor[
             Rational[2, 3], 0, 0],
           GraphicsColor->RGBColor[
             Rational[2, 3], 0, 0],
           FontSize->14,
           FontColor->RGBColor[
             Rational[2, 3], 0, 0],
