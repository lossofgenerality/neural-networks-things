Cell[CellGroupData[{

Cell["1. What is an S-shaped function?", "Section",ExpressionUUID->"00ef4d3c-e613-4efb-a2f2-9e2bed527f1b"],

Cell["\<\
Cybenko (1989) calls a function \[Sigma]: \[DoubleStruckCapitalR] \[Rule] \
\[DoubleStruckCapitalR] sigmoidal if it goes to 0 on the far left and to 1 on \
the far right:\
\>", "Text",ExpressionUUID->"1ed98944-24ed-411f-add8-ccab01e7e407"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"t", "\[Rule]", 
       RowBox[{"-", "\[Infinity]"}]}]], 
     RowBox[{"\[Sigma]", "(", "t", ")"}]}], "=", "0"}], ",", "     ", 
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{"t", "\[Rule]", 
       RowBox[{"+", "\[Infinity]"}]}]], 
     RowBox[{"\[Sigma]", "(", "t", ")"}]}], "=", "1"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"57362637-3de2-\
4e7b-997a-b39b9e49f0ed"],

Cell["\<\
Equation (1) is the whole definition. It does not ask for monotonicity, \
smoothness or even continuity (Appendix A). Continuity is needed only for the \
main theorem in section 3, and boundedness plus measurability for some of its \
variants.\
\>", "Text",ExpressionUUID->"7223f115-c735-4c86-a232-7604aa218b38"],

Cell["\<\
A gallery of S-shapes, each rescaled where necessary so that its limits are 0 \
and 1:\
\>", "Text",ExpressionUUID->"c8612c99-bd1d-432f-ab79-e634f33d042e"],

Cell["\<\
(*c.1*)
sig = <|
   \"logistic\" -> LogisticSigmoid,
   \"(1 + tanh)/2\" -> ((1 + Tanh[#])/2 &),
   \"1/2 + arctan/\[Pi]\" -> (1/2 + ArcTan[#]/Pi &),
   \"(1 + erf)/2\" -> ((1 + Erf[#])/2 &),
   \"algebraic\" -> ((1 + #/Sqrt[1 + #^2])/2 &),
   \"Gudermannian\" -> (1/2 + Gudermannian[#]/Pi &),
   \"Heaviside step\" -> (UnitStep[#] &)|>;\
\>", "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"17447f38-7a95-4f0b-af84-0a3756a0a521"],

Cell["\<\
Table 1. Each function satisfies both limits of Eq. (1), checked symbolically.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"91885520-ede0-44c9-b6f5-e804fc2ff87e"],

Cell[CellGroupData[{

Cell["(*c.2*)\ntable[Prepend[\n  Table[{k, Limit[sig[k][t], t -> -Infinity],\n    Limit[sig[k][t], t -> Infinity]}, {k, Keys[sig]}],\n  {\"function\", \"t \[Rule] -\[Infinity]\", \"t \[Rule] +\[Infinity]\"}],\n \"Table 1\"]", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"9304e136-0e45-467a-b6c3-809a20766b48"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"function\"", "\"t \[Rule] -\[Infinity]\"", 
       "\"t \[Rule] +\[Infinity]\""}, {"\"logistic\"", "0", "1"}, {
      "\"(1 + tanh)/2\"", "0", "1"}, {"\"1/2 + arctan/\[Pi]\"", "0", "1"}, {
      "\"(1 + erf)/2\"", "0", "1"}, {"\"algebraic\"", "0", "1"}, {
      "\"Gudermannian\"", "0", "1"}, {"\"Heaviside step\"", "0", "1"}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 1\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.00378956345673*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"bf7b0dd2-822f-4abf-88cd-401caa716fa1"]
}, Open  ]],

Cell["\<\
Figure 1. A gallery of S-shaped functions. All rise from 0 to 1 but at \
different speeds.\
\>", "Caption",
 FontSize->14,
 FontFamily->"Source Sans Pro",ExpressionUUID->"a1c486b6-361f-44c8-a543-2d1caa16cece"],

