Cell["\<\
Table 6.3. The trained 8-unit network against staircases of Eq. (M7) with 8 \
and 80 units.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"264eecfe-8d96-4e38-a195-89097c954b5f"],

Cell[CellGroupData[{

Cell["\<\
(*c.6.7*)
(* trained weights against the staircase of Eq. (M7), on a fine grid *)
table[{{\"construction\", \"units\", \"max error\"},
  {\"staircase, Eq. (M7)\", 8, NumberForm[supErrS[LogisticSigmoid, f, 8,
     160], 3]},
  {\"staircase, Eq. (M7)\", 80, NumberForm[supErrS[LogisticSigmoid, f,
     80, 1600], 3]},
  {\"trained with Eqs. (6.1)-(6.3)\", 8, NumberForm[
    Max@Abs[netOut[pT, xsFine] - f[xsFine]], 3]}}, \"Table 6.3\"]\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"fbb601df-8271-4f39-97d8-7b9ab0324061"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{"\"construction\"", "\"units\"", "\"max error\""}, {
      "\"staircase, Eq. (M7)\"", "8", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.276\"", ShowStringCharacters -> False], 
         0.2757266156226192, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "\"staircase, Eq. (M7)\"", "80", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.0276\"", ShowStringCharacters -> False], 
         0.027550765007099798`, AutoDelete -> True], NumberForm[#, 3]& ]}, {
      "\"trained with Eqs. (6.1)-(6.3)\"", "8", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.000808\"", ShowStringCharacters -> False], 
         0.0008082325205600593, AutoDelete -> True], NumberForm[#, 3]& ]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
