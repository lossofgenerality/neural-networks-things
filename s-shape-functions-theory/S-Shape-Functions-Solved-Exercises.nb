Cell[TextData[{
 "Figure 5.1. One step of BasicRecurrentLayer drawn like Figure M3, for n = m \
= 2. The four inputs on the left are the components of z = (x, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "old"], TraditionalForm]],ExpressionUUID->
  "56e8019d-248a-4255-b2ff-63332d9580fe"],
 "). The red labels are the weights: 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "ik"], TraditionalForm]],ExpressionUUID->
  "3636b2ba-a708-473c-a72a-3b7b86b7597e"],
 " and 2",
 Cell[BoxData[
