Cell[CellGroupData[{

Cell["Answer", "Subsection",ExpressionUUID->"652c721b-7273-4ccc-8e22-5fe9c7d505f1"],

Cell[TextData[{
 "Yes, \[Sigma](t) + sin(t) exp(-",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "11cc69f7-d01e-4199-a2b2-a5a3501cfc54"],
 ") is sigmoidal: its limits are 0 and 1, and Eq. (M1) asks for nothing else. \
It is not monotone. It overshoots to 1.068 and -0.068. Yes, the staircase \
still converges, at the same rate O(1/N) as the logistic staircase, with an \
error about 1.4 to 1.7 times larger (Table 2.2). Even A = 3 converges. The \
reason is Eq. (2.2): every wiggle is scaled by a jump ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "809298d6-127b-4d33-a474-5983eacd50df"],
 " of f, and the jumps shrink like ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "7e55899d-ce34-4618-ab85-d798951c36d6"],
 "(1/N). This is the content of Cybenko's theorem, which asks for continuity \
and the two limits, and not for monotonicity."
}], "Text",ExpressionUUID->"7969a672-4e08-4f99-a083-4cff9c0a6a12"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Problem 3: the polynomial activation t^2", "Section",ExpressionUUID->"b5f9cf57-a01e-49f7-a10d-00adb5fa6447"],

Cell[TextData[{
 StyleBox["Problem 3. ",
  FontWeight->"Bold"],
 "Try the least-squares fit of section 5 (Table M4) with \[Sigma](t) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "704ec5ad-5833-44ca-8fb2-744b95d2a309"],
 ", a polynomial. The error stops improving. Which of Theorems M1\[Dash]M8 \
explains this?"
}], "Text",ExpressionUUID->"fc775d18-013b-4ca3-a26b-a542cd3b23bb"],

Cell[CellGroupData[{

Cell["The experiment", "Subsection",ExpressionUUID->"7e5af19a-3cce-456a-817f-8882fc7b7ef3"],

Cell[TextData[{
 "Cells c.12\[Dash]c.14 of the main notebook are repeated with the activation \
as a parameter: random inner weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "d6490033-d826-4ad8-bc79-288dc62f8a12"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "6057729f-8d6f-4301-9cfd-3ba5ae73443c"],
 " in [-6, 6], least-squares outer weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "85c3c7dd-ceda-4817-b0a2-91f8ca90be82"],
 ", 2000 training and 2000 test points, target g(x, y) = sin(\[Pi]x) \
cos(\[Pi]y) on [-1, 1]\.b2. Besides ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "3005e656-8e3a-4dde-ac6d-3cfaf0e66931"],
 " we also try ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "a3e35b50-a291-48ce-ba96-b13c4d80d1de"],
 "."
}], "Text",ExpressionUUID->"ce68b190-7213-4e9f-857d-f7ccf368d8c8"],

Cell["\<\
Table 3.1. Maximum and RMS test errors for N hidden units, three activations.\
\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"47d91543-9c3f-4174-916b-ad1201af48ed"],

Cell[CellGroupData[{

Cell["\<\
(*c.3.1*)
(* section 5 of the main notebook (c.12-c.14), with the activation as
   a parameter. PseudoInverse gives the least-squares \[Alpha] even when the
   columns of the hidden matrix are linearly dependent, as for t^2 *)
g[x_, y_] := Sin[Pi x] Cos[Pi y];
SeedRandom[3];
trainPts = RandomReal[{-1, 1}, {2000, 2}];
testPts = RandomReal[{-1, 1}, {2000, 2}];
hiddenA[act_][pts_, Yin_, th_] :=
  act[pts . Transpose[Yin] + ConstantArray[th, Length[pts]]];
fitA[act_, nh_] := Module[
   {Yr = RandomReal[{-6, 6}, {nh, 2}], th = RandomReal[{-6, 6}, nh], a},
   a = PseudoInverse[hiddenA[act][trainPts, Yr, th]] .
     (g @@@ trainPts);
   {Yr, th, a}];
testErr[act_, nh_] := With[{m = fitA[act, nh]}, Module[{r},
    r = hiddenA[act][testPts, m[[1]], m[[2]]] . m[[3]] - g @@@ testPts;
    {Max@Abs[r], Sqrt@Mean[r^2]}]];
acts = <|\"logistic\" -> LogisticSigmoid, \"t\.b2\" -> (#^2 &),
   \"t\.b3\" -> (#^3 &)|>;
nsQ = {2, 4, 6, 10, 20, 50, 100, 200};
SeedRandom[7];
errQ = Association@Table[k -> Table[testErr[acts[k], nh], {nh, nsQ}],
    {k, Keys[acts]}];
table[Prepend[
  Table[Join[{nh}, Flatten@Table[NumberForm[#, 3] & /@
       errQ[k][[Position[nsQ, nh][[1, 1]]]], {k, Keys[acts]}]],
   {nh, nsQ}],
  {\"N\", \"logistic max\", \"logistic RMS\", \"t\.b2 max\", \"t\.b2 RMS\",
   \"t\.b3 max\", \"t\.b3 RMS\"}], \"Table 3.1\"]\
\>", "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"74c90399-80db-4d2b-91d7-5d6201196ffb"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"N\"", "\"logistic max\"", "\"logistic RMS\"", "\"t\.b2 max\"", 
       "\"t\.b2 RMS\"", "\"t\.b3 max\"", "\"t\.b3 RMS\""}, {"2", 
       TagBox[
        InterpretationBox[
         StyleBox["\"1.12\"", ShowStringCharacters -> False], 
