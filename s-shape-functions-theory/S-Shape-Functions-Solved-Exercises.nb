Cell[CellGroupData[{

Cell["Answer", "Subsection",ExpressionUUID->"46a85560-b950-4d18-826e-b6dbb130e6e9"],

Cell[TextData[{
 "With z = (x, h) as the input, component i of tanh(W x + U h + b) equals 2\
\[Sigma](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "54c1250b-4cc7-4a9d-bdc6-1cf121246d51"],
 "\[CenterDot]z + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "i"], TraditionalForm]],ExpressionUUID->
  "d984df4b-c5e9-4c44-a60d-0e0ac06b5c3f"],
 ") - 2\[Sigma](0\[CenterDot]z + 0) with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "fa0ac403-6f1a-42eb-91e5-d1f57392c9f3"],
 " = 2(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "i"], TraditionalForm]],ExpressionUUID->
  "10cd3c55-283c-4f83-b76b-56b2b8ed461f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "i"], TraditionalForm]],ExpressionUUID->
  "25bc4b0f-0a88-4fbc-a76c-5aa4df466ad9"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "i"], TraditionalForm]],ExpressionUUID->
  "021741e9-ac80-4f5d-a475-f6373ff2d1d6"],
 " = 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "i"], TraditionalForm]],ExpressionUUID->
  "57b903fd-f847-4220-bdea-b156328e502a"],
 ", a sum of Eq. (M3), Eq. (5.2). Figure 5.1 draws it in the style of Figure \
M3, and Table 5.1 confirms it against BasicRecurrentLayer. To make it \
recurrent, add arrows from each state output ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "l"], TraditionalForm]],ExpressionUUID->
  "1466d133-60aa-492c-a1ec-66e3f88f766e"],
 " back into each state unit ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],ExpressionUUID->
  "1a071378-682c-4fc5-abe3-dcfd10d138bc"],
 ", carrying ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "il"], TraditionalForm]],ExpressionUUID->
  "62b23397-f4ac-4c04-ab31-95cb3284d1b2"],
 " with a one-step delay (Figure 5.2)."
}], "Text",ExpressionUUID->"f7abadf6-9d21-4ae6-b4e9-c16ef65e4034"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Problem 6: the gradient with respect to the weights", "Section",ExpressionUUID->"28a85bb3-8b5a-49c9-a30f-c79859634b02"],

Cell[TextData[{
 StyleBox["Problem 6. ",
  FontWeight->"Bold"],
 "Use Eq. (M5) to write \[PartialD]G/\[PartialD]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "e1e222f3-3cba-475f-b194-b34e96469694"],
 " and \[PartialD]G/\[PartialD]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "ji"], TraditionalForm]],ExpressionUUID->
  "15510b27-905e-45f9-95dd-ec4fcf4379d9"],
 ", and check both against D as in c.7."
}], "Text",ExpressionUUID->"5a16115a-4f91-4200-b2fd-a9d8ab5ae078"],

Cell[CellGroupData[{

Cell["The path rule for weights", "Subsection",ExpressionUUID->"bdd3823f-5084-45dd-af45-3b5b5316fc0f"],

Cell[TextData[{
 "Eq. (M5) gives the derivative of G with respect to an input as a sum, over \
all paths from that input to G, of the product of the local derivatives along \
the path. The same rule works for a weight. A weight sits on one arrow, so \
the paths start at that arrow. The derivative is the value at the tail of the \
arrow times the product of the local derivatives from its head to G. With ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "j"], TraditionalForm]],ExpressionUUID->
  "b079ac35-e98b-4397-a805-f0a3929895e0"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "3109b24d-21c6-4cb9-a797-7277ad611319"],
 "\[CenterDot]x + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "a8e154fa-48f5-4cb7-873d-1062e3d6bc36"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "8ea1f201-108f-4547-aee2-c5ca073c4a0a"],
 " = \[Sigma](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "j"], TraditionalForm]],ExpressionUUID->
  "8281f3d3-769f-4f3e-8551-26b9ac010f2a"],
 "), as in Eq. (M4):"
}], "Text",ExpressionUUID->"3d36ef4b-e5ea-48f4-80bc-5550dfe57723"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "be7c1d5e-be8e-42ce-a21a-8d286ef63f95"],
 " sits on the arrow ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "57171869-04ac-4aaa-b24e-60f4a4416d4a"],
 " \[RightArrow] G. Its tail carries ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "4b4b14c7-f76d-4917-8d9e-b8aa9c25630a"],
 " = \[Sigma](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "j"], TraditionalForm]],ExpressionUUID->
  "1c78690c-2b74-46c2-9af4-efc28253757d"],
 "), and the head is G itself:"
}], "Item",ExpressionUUID->"958ee394-b987-41ba-bffb-24b40e8f73e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "G"}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[Alpha]", "j"]}]], "=", 
    RowBox[{"\[Sigma]", 
     RowBox[{"(", 
      SubscriptBox["z", "j"], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "6.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"920f57af-bf1b-4529-8b76-353f714e80fa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "e861d414-dd7d-4f9e-bdda-1d83b7618b43"],
 " is the weight of an arrow from a constant input 1 to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "f051c037-1958-448e-9e01-60a00622336c"],
 ". Its tail carries 1; from there the path passes through the node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "e7044b31-6ea9-4f95-a20d-7f9dc3e55af3"],
 " (factor \[Sigma]\[Prime](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "j"], TraditionalForm]],ExpressionUUID->
  "fe3f1b6a-1831-49d8-836d-4166d43f2114"],
 ")) and the arrow ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "3354eb2a-0aad-43f7-84b8-517e7827424f"],
 " \[RightArrow] G (factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "2c1a9c96-9931-4704-946a-46fd72105394"],
 "):"
}], "Item",ExpressionUUID->"43b5c2d7-b569-4769-ac5f-9ccede031c97"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "G"}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["\[Theta]", "j"]}]], "=", 
    RowBox[{
     SubscriptBox["\[Alpha]", "j"], " ", 
     RowBox[{
      SuperscriptBox["\[Sigma]", "\[Prime]"], 
      RowBox[{"(", 
       SubscriptBox["z", "j"], ")"}]}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "6.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"abe5d0c3-3061-477e-b4cc-97de12fe051e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "ji"], TraditionalForm]],ExpressionUUID->
  "6688a4fa-e498-48df-8463-a54f98cd91c7"],
 " sits on the arrow ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "61cf9637-0f5d-46e9-bf80-33565a1981b0"],
 " \[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "j"], TraditionalForm]],ExpressionUUID->
  "19b75735-4b7f-4d9b-bbff-f55116436a0d"],
 ". Its tail carries ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "55c10908-6679-4db1-9266-fd13acf1916c"],
 ", and the path continues exactly as for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "e5abc1b5-3f58-4150-afe4-49a961418cc7"],
 ":"
}], "Item",ExpressionUUID->"9fada2d9-0cd0-4583-b36f-5d1850fdba46"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "G"}], 
     RowBox[{"\[PartialD]", 
      SubscriptBox["y", "ji"]}]], "=", 
    RowBox[{
     SubscriptBox["\[Alpha]", "j"], " ", 
     RowBox[{
      SuperscriptBox["\[Sigma]", "\[Prime]"], 
      RowBox[{"(", 
       SubscriptBox["z", "j"], ")"}]}], " ", 
     SubscriptBox["x", "i"]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "6.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"aa909d02-142d-4a4f-a0ba-290ee1af678b"],

Cell[TextData[{
 "Each weight lies on exactly one path to G, so each sum in Eq. (M5) has a \
single term. Eq. (6.3) is Eq. (6.2) times the input ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "0e765d8b-5e62-4bea-a1c9-26ed2de144f6"],
 ". That is the familiar rule of backpropagation: the gradient of a weight is \
the signal flowing back to its head, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "9d9e5657-f6a3-4d84-b57e-e262aea33c25"],
 " \[Sigma]\[Prime](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "j"], TraditionalForm]],ExpressionUUID->
  "9a145189-dbdc-4e8b-9f9b-d6b9552e2d26"],
 "), times the activity at its tail."
}], "Text",ExpressionUUID->"12831d1f-cf8c-4dd8-97ef-7a397284e71f"],

Cell["\<\
Table 6.1. The three formulas against D, for the random network of c.7 of the \
main notebook at the point x = (0.3, -0.7). Rows of the y matrix are the \
units j, columns the inputs i.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"b9e87a66-86ed-4153-b45a-eda7b61179da"],

Cell[CellGroupData[{

Cell["\<\
(*c.6.1*)
(* Eqs. (6.1)-(6.3) against automatic differentiation, for the same
   random network as c.7 of the main notebook (n = 2, N = 3) *)
Module[{Yw, th, al, x0, yv, tv, av, yy, tt, aa, gNet, rules, auto, z,
  sp, path, fmt},
 SeedRandom[2];
 Yw = RandomReal[{-2, 2}, {3, 2}];   (* weights y_ji *)
 th = RandomReal[{-1, 1}, 3];        (* offsets \[Theta]_j *)
 al = RandomReal[{-1, 1}, 3];        (* output weights \[Alpha]_j *)
 x0 = {0.3, -0.7};
 (* symbolic parameters, so that D can differentiate by them *)
 yv = Array[yy, {3, 2}]; tv = Array[tt, 3]; av = Array[aa, 3];
 gNet = av . LogisticSigmoid[yv . x0 + tv];
 rules = Join[Thread[Flatten[yv] -> Flatten[Yw]], Thread[tv -> th],
   Thread[av -> al]];
 auto = {D[gNet, {av}], D[gNet, {tv}], D[gNet, {yv}]} /. rules;
 (* the path products of Eqs. (6.1)-(6.3) *)
 z = Yw . x0 + th;
 sp = LogisticSigmoid[z] (1 - LogisticSigmoid[z]);   (* \[Sigma]'(z_j) *)
 path = {LogisticSigmoid[z], al sp, Outer[Times, al sp, x0]};
 fmt[v_] := MatrixForm[Map[NumberForm[#, 4] &, v, {-1}]];
 table[Prepend[MapThread[{#1, fmt[#2], fmt[#3],
      sci@Max@Abs@Flatten[#2 - #3]} &,
    {{\"\[PartialD]G/\[PartialD]\[Alpha]\:2c7c, Eq. (6.1)\", \"\[PartialD]G/\
\[PartialD]\[Theta]\:2c7c, Eq. (6.2)\",
      \"\[PartialD]G/\[PartialD]y\:2c7c\:1d62, Eq. (6.3)\"}, auto, path}],
   {\"derivative\", \"D (automatic)\", \"path product\", \"difference\"}],
  \"Table 6.1\"]]\
\>", "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"17a1d659-1e40-4349-98cf-a3dfc502b99d"],

