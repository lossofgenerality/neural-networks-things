Cell[TextData[{
 "Figure 6.3. The trained network taken apart: the eight terms ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "258768bc-7b55-4e59-a136-1169b791298a"],
 " \[Sigma](",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "055950a6-ad43-4813-b0a4-8c28264b66f5"],
 " x + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "03ea0e18-4cbb-4e61-8ff9-4ce2db9f6345"],
 ") (thin) and their sum plus c, which is the fit (thick). The units do not \
look like the steps of a staircase. Training finds large terms that cancel \
and leave a precise curve."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"5c2d5cc0-c2c3-4474-a8da-1339f86c0f64"],

Cell[CellGroupData[{

Cell["\<\
(*c.6.6*)
(* the trained network split into its 8 hidden units \[Alpha]_j \[Sigma](y_j \
x + \[Theta]_j);
   their sum plus the constant c is the fit *)
Module[{y, t, a, c, units},
 {y, t, a, c} = unpack[pT];
 units = Table[a[[j]] LogisticSigmoid[y[[j]] xt + t[[j]]], {j, nU}];
 ListLinePlot[Join[Transpose[{xt, #}] & /@ units,
   {Transpose[{xt, Total[units] + c}]}],
  PlotStyle -> Join[Table[ColorData[97][j], {j, nU}],
    {Directive[Black, Thick]}], PlotRange -> All,
  AxesLabel -> {\"x\", None},
  Epilog -> {Black, Text[Style[\"sum + c = G(x)\", figFont], {0.62, 1.1}]},
  PlotLabel -> \"Figure 6.3. The 8 trained units and their sum\",
  LabelStyle -> figStyle, ImageSize -> wFull]]\
\>", "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"9c91cfc4-e532-4520-95a0-d4e1bf05cd18"],

