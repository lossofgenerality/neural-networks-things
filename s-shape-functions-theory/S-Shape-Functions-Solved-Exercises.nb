Cell[CellGroupData[{

Cell["The measurement", "Subsection",ExpressionUUID->"8802feca-9293-41b4-afd1-e04480ade9b4"],

Cell[TextData[{
 "The staircase of Eq. (M7) with \[Lambda] = 20 N, measured on a grid that \
has a spacing of 2 \[Times] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],ExpressionUUID->
  "f15829a3-4969-4f51-8693-f7c9d889d947"],
 " on [0, 0.3], where x sin(1/x) oscillates fastest. For the Cantor staircase \
we use both N = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", "k"], TraditionalForm]],ExpressionUUID->
  "41428e59-aed7-4f5d-a236-0ca79eeed706"],
 ", which fits its self-similarity, and the values of N used for x sin(1/x)."
}], "Text",ExpressionUUID->"280e8372-d9aa-47a6-a126-eed3f6913063"],

Cell[TextData[{
 "Table 7.2. The prediction ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "3edbbda8-3e92-44a0-924a-ca4cffb6c2d3"],
 "(1/(2N)) of Eq. (7.1) against the measured error. The ratio is never above \
1: Eq. (7.1) is an upper bound that is nearly attained."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"4dad63b1-0732-409c-a814-1b02beefc443"],

Cell[CellGroupData[{

Cell["\<\
(*c.7.4*)
(* the prediction, made before measuring:
   error \[TildeTilde] \[Omega]_f(1/(2N)), Eq. (7.1) *)
nsP = {5, 10, 20, 40, 80, 160, 320, 640};
nsC = 3^Range[6];
predErr[k_, n_] := omegaG[fGrid[k], 1./(2 n)];
(* the measurement: sup error of the staircase of Eq. (M7), \[Lambda] = 20 N,
   on a grid that is dense where x sin(1/x) oscillates *)
xsM = Union[Range[0., 0.3, 2.*^-5], Range[0.3, 1., 2.*^-4]];
fM = #[xsM] & /@ targets;   (* f on that grid, computed once *)
measErr[k_, n_] := Max@Abs[fM[k] - stairOn[LogisticSigmoid,
      targets[k][nodes[n]], 20 n, xsM]];
errTab = <|
   \"x sin(1/x)\" -> Table[{n, predErr[\"x sin(1/x)\", n],
      measErr[\"x sin(1/x)\", n]}, {n, nsP}],
   \"Cantor\" -> Table[{n, predErr[\"Cantor\", n], measErr[\"Cantor\", n]},
     {n, Join[nsC, nsP]}]|>;
table[Prepend[
  Flatten[KeyValueMap[Function[{k, rows},
     Table[{If[i == 1, k, \"\"], rows[[i, 1]], NumberForm[rows[[i, 2]], 3],
       NumberForm[rows[[i, 3]], 3], NumberForm[rows[[i, 3]]/rows[[i, 2]],
        3]}, {i, Length[rows]}]], errTab], 1],
  {\"f\", \"N\", \"predicted \[Omega](1/(2N))\", \"measured error\", \
\"ratio\"}],
 \"Table 7.2\"]\
\>", "Input",
 CellLabel->
  "In[250]:=",ExpressionUUID->"b19e8605-e9fc-43d1-8d49-24663bf04d48"],

