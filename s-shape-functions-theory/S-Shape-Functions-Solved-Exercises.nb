Cell["\<\
Figure 1.3. Leakage against \[Lambda] at N = 20. The logistic plunges, the \
algebraic sigmoid follows slope -2 and the arctan sigmoid slope -1, as Eq. \
(1.4) predicts.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"cc5b158d-682c-41bd-b86f-88ad96572e68"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.6*)
ListLogLogPlot[
 Table[Table[{lam, Max[leak[sig3[k], 20, lam], 10.^-16]},
   {lam, 10^Range[1.6, 5, 0.2]}], {k, Keys[sig3]}],
 Joined -> True, PlotMarkers -> Automatic, PlotRange -> {10^-12, 1},
 AxesLabel -> {\"\[Lambda]\", \"leakage\"},
 Epilog -> {logLine[{{10^2.2, 10^-0.6}, {10^5, 10^-3.4}}],
   logLine[{{10^2.2, 10^-2.6}, {10^4.4, 10^-7.}}],
   logText[\"slope -1\", {10^4.3, 10^-2.}],
   logText[\"slope -2\", {10^3.4, 10^-6.4}]},
 PlotLegends -> Placed[LineLegend[Keys[sig3], LabelStyle -> figStyle],
   Below],
 PlotLabel -> \"Figure 1.3. Leakage against \[Lambda], N = 20\",
 LabelStyle -> figStyle, ImageSize -> wFull]\
\>", "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"e7fd87d3-dfee-44f6-b21e-5d9cb89d35b8"],

