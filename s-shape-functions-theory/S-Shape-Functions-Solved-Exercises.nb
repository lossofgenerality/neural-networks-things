Cell["\<\
Geometrically the inner functions straighten the function. The level sets x y \
z = c are curved surfaces, but in the coordinates (ln x, ln y, ln z) they \
become the parallel planes u + v + w = ln c. After the inner functions, the \
function depends only on the sum of the coordinates, which is exactly what \
Eq. (M8) demands of each branch.\
\>", "Text",ExpressionUUID->"d58a23a7-5878-46ca-9db4-ae8e86c3eb8a"],

Cell["\<\
Figure 4.3. Left: the level sets x y z = 0.02, 0.1, 0.3. Right: the same sets \
after the inner functions, flat parallel planes.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"df3a9d0b-6446-41dc-ace0-0b45602042c1"],

Cell[CellGroupData[{

Cell["\<\
(*c.4.5*)
(* level sets: x y z = c is curved; in the coordinates of the inner
   functions, (ln x, ln y, ln z), it is the flat plane u + v + w = ln c *)
levels = {0.02, 0.1, 0.3};
figure[{{
   ContourPlot3D[x y z, {x, 0.01, 1}, {y, 0.01, 1}, {z, 0.01, 1},
    Contours -> levels, Mesh -> None, ContourStyle -> Opacity[0.7],
    AxesLabel -> {\"x\", \"y\", \"z\"}, Ticks -> {{0, 1}, {0, 1}, {0, 1}},
    ViewPoint -> {2.6, 2.2, 1.6},
    Evaluate@panel[PlotLabel -> \"4.3a. x y z = c\"]],
   ContourPlot3D[u + v + w, {u, -4.6, 0}, {v, -4.6, 0}, {w, -4.6, 0},
    Contours -> Log[levels], Mesh -> None,
    ContourStyle -> Opacity[0.7], AxesLabel -> {\"ln x\", \"ln y\", \"ln \
z\"},
    Ticks -> {{-4, 0}, {-4, 0}, {-4, 0}}, ViewPoint -> {2.6, 2.2, 1.6},
    Evaluate@panel[PlotLabel -> \"4.3b. in ln coordinates\"]]}},
 \"Figure 4.3. The inner functions straighten the level sets\"]\
\>", "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"bf021983-ea43-4664-a6c3-7bd7f5d4e135"],

