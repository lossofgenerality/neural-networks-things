Cell[CellGroupData[{

Cell["The prediction", "Subsection",ExpressionUUID->"033a10da-25f0-4405-a0b8-86ecea7055f0"],

Cell[TextData[{
 "The ideal staircase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]],ExpressionUUID->
  "483e008c-feca-4d8f-b6ee-724145e32508"],
 " of Eq. (1.3) takes at x the value of f at the nearest node, which is at \
most 1/(2N) away. By the definition of the modulus of continuity, Eq. (M12),"
}], "Text",ExpressionUUID->"2db71a4c-76d1-4fdf-a27b-553062df9ded"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"|", 
     RowBox[{
      RowBox[{
       SubscriptBox["S", "N"], 
       RowBox[{"(", "x", ")"}]}], "-", 
      RowBox[{"f", 
       RowBox[{"(", "x", ")"}]}]}], "|"}], "\[LessEqual]", 
    RowBox[{
     SubscriptBox["\[Omega]", "f"], 
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"2", "N"}]], ")"}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     StyleBox["error",
      FontSlant->"Plain"], "\[TildeTilde]", 
     RowBox[{
      SubscriptBox["\[Omega]", "f"], 
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{"2", "N"}]], ")"}]}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "7.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"2357c85f-f339-4f1c-aeb3-f271053c3131"],

Cell[TextData[{
 "With \[Lambda] = 20 N the logistic leakage is negligible (Problem 1), so \
the staircase error should be close to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "b26e923e-9e13-4131-b2ea-8b802d7060c9"],
 "(1/(2N)). Its rate is the rate of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "7f39db84-9cc6-4bad-b637-c40ff11dbdf3"],
 ". We work ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "67e6a00d-ef7a-44fc-a6bd-459bf3121fe1"],
 " out for each target."
}], "Text",ExpressionUUID->"af3d2e6a-5173-4f9b-8e92-c513b68f214f"],

Cell[TextData[{
 "x sin(1/x). Near a point a > 0 the function oscillates with amplitude about \
a, and one half-oscillation, a change of 1/x by \[Pi], takes a change of x by \
about \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "2"], TraditionalForm]],ExpressionUUID->
  "ee162a8e-2887-4132-9eff-7f69f3bb4a80"],
 ". A window of width \[Delta] placed where \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "2"], TraditionalForm]],ExpressionUUID->
  "7e2b8957-10db-4f29-8cbe-2c3ca4ce8b14"],
 " = \[Delta] therefore sees the full swing from +a to -a, and no better \
placement exists: to the left the amplitude is smaller, to the right the \
window covers less than a half-oscillation. So"
}], "Item",ExpressionUUID->"83ac8a36-d0ae-4524-a925-c5ec33f4f949"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Omega]", "f"], 
      RowBox[{"(", "\[Delta]", ")"}]}], "\[TildeTilde]", 
     RowBox[{"2", 
      SqrtBox[
       FractionBox["\[Delta]", "\[Pi]"]]}]}], "    ", 
    StyleBox["for",
     FontSlant->"Plain"], "  ", 
    RowBox[{"f", 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"x", " ", 
     RowBox[{"sin", 
      RowBox[{"(", 
       FractionBox["1", "x"], ")"}]}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "7.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"b6d97d25-ce43-4ad7-ab57-5658b7d9d5c2"],

Cell[TextData[{
 "Rate prediction: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "ae83aaeb-2704-418d-ae63-6ff4c201d09a"],
 "(1/(2N)) \[TildeTilde] 2\[Sqrt](1/(2\[Pi]N)) = 0.80/\[Sqrt]N, so the error \
should fall like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["N", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "5f5b9e67-04be-4839-a2b8-1633fad5344a"],
 ", one factor \[Sqrt]2 for each doubling of N."
}], "Item",ExpressionUUID->"1ae25b6e-4f68-42d8-b536-be18d8f29652"],

Cell[TextData[{
 "Cantor staircase. C satisfies the self-similarity C(x/3) = C(x)/2 and the \
symmetry C(1 - x) = 1 - C(x). An interval of length ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", 
    RowBox[{"-", "k"}]], TraditionalForm]],ExpressionUUID->
  "b2c3be18-da97-4354-87aa-2ac30e788d89"],
 " rises by at most ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{"-", "k"}]], TraditionalForm]],ExpressionUUID->
  "108489bc-7191-475e-8c72-6f1dbf9187a5"],
 ", and the first interval [0, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["3", 
    RowBox[{"-", "k"}]], TraditionalForm]],ExpressionUUID->
  "492afa84-746f-4a6c-89f2-5074ed8b862e"],
 "] rises by exactly that:"
}], "Item",ExpressionUUID->"9001ae9f-b91c-4e9e-8cf3-d1c9e67b6eba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"C", 
      RowBox[{"(", 
       FractionBox["x", "3"], ")"}]}], "=", 
     FractionBox[
      RowBox[{"C", 
       RowBox[{"(", "x", ")"}]}], "2"]}], 
    RowBox[{",", "  "}], 
    RowBox[{
     RowBox[{"C", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}]}], "=", 
     RowBox[{"1", "-", 
      RowBox[{"C", 
       RowBox[{"(", "x", ")"}]}]}]}], "    ", "\[Implies]", "    ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Omega]", "C"], 
      RowBox[{"(", 
       SuperscriptBox["3", 
        RowBox[{"-", "k"}]], ")"}]}], "=", 
     SuperscriptBox["2", 
      RowBox[{"-", "k"}]]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "7.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"96f31a58-94c7-498a-8e4e-bc9fcd220b64"],

Cell[TextData[{
 "In between, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "C"], TraditionalForm]],ExpressionUUID->
  "a7019f65-08de-491b-a0b3-e7600bd0d6bf"],
 "(\[Delta]) stays within a factor 2 of \[Delta] to the power ln 2/ln 3 = \
0.631, so C is H\[ODoubleDot]lder continuous with that exponent and no \
better. Rate prediction:"
}], "Item",ExpressionUUID->"af5c393d-a565-4764-acaa-0449b8a73197"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Omega]", "C"], 
      RowBox[{"(", "\[Delta]", ")"}]}], "\[TildeEqual]", 
     SuperscriptBox["\[Delta]", 
      RowBox[{"ln", " ", 
       RowBox[{"2", "/", 
        RowBox[{"ln", " ", "3"}]}]}]]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     StyleBox["error",
      FontSlant->"Plain"], "\[Tilde]", 
     SuperscriptBox["N", 
      RowBox[{"-", "1", "/", "2"}]]}], 
    StyleBox[
     RowBox[{" ", "and", " "}],
     FontSlant->"Plain"], 
    SuperscriptBox["N", 
     RowBox[{"-", "ln", " ", "2", "/", "ln", " ", "3"}]]}], "        ", 
   StyleBox[
    RowBox[{"(", "7.4", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"a8a71477-3bda-4d6a-ba2b-9049c1ba9282"],

Cell["\<\
The predictions are made. Now the measurements: first the moduli themselves, \
computed on a grid of 100001 points with a sliding maximum and minimum.\
\>", "Text",ExpressionUUID->"64474736-b7ce-4463-b502-628ba93e3d7b"],

Cell[TextData[{
 "Table 7.1. The modulus of continuity ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "9a37a0c9-6243-4366-8ade-5e1bc6411a5a"],
 "(\[Delta]), measured and predicted by Eqs. (7.2) and (7.4)."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"1dfea324-0a76-43f5-9bea-eadcdc03a220"],

Cell[CellGroupData[{

Cell["\<\
(*c.7.2*)
(* modulus of continuity, Eq. (M12), on a grid of step h: the largest
   range max - min of f over a window of width \[Delta] *)
h = 10.^-5; grid = Range[0., 1., h];
fGrid = <|\"x sin(1/x)\" -> xsin[grid], \"Cantor\" -> cantor[grid]|>;
omegaG[vals_, d_] := With[{r = Round[d/(2 h)]},
   Max[MaxFilter[vals, r] - MinFilter[vals, r]]];
(* predictions, Eqs. (7.2) and (7.4) *)
omegaPred = <|\"x sin(1/x)\" -> (2 Sqrt[#/Pi] &),
   \"Cantor\" -> (#^(Log[2]/Log[3]) &)|>;
ds = 1./{5, 10, 20, 40, 80, 160, 320, 640};
table[Prepend[
  Flatten[Table[{
     {k, \"measured\", Sequence @@ (NumberForm[omegaG[fGrid[k], #], 3] &
         /@ ds)},
     {\"\", \"predicted\", Sequence @@ (NumberForm[omegaPred[k][#], 3] &
         /@ ds)}}, {k, Keys[targets]}], 1],
  Join[{\"f\", \"\"}, (\"\[Delta] = 1/\" <> ToString[Round[1/#]] &) /@ ds]],
 \"Table 7.1\"]\
\>", "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"b57b8f55-61e9-4356-9f7a-7bae7a88fceb"],

