          RowBox[{"1", "-", 
            RowBox[{"2", " ", "\[Eta]"}]}], 
          RowBox[{"2", " ", 
            SqrtBox[
             RowBox[{
               RowBox[{"(", 
                 RowBox[{"1", "-", "\[Eta]"}], ")"}], " ", "\[Eta]"}]]}]], 
         TraditionalForm], TraditionalForm, Editable -> True], 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"2.7\"", "\[Times]", 
            SuperscriptBox["10", "\"-11\""]}], ShowStringCharacters -> False],
          2.67554414631584*^-11, AutoDelete -> True], ScientificForm[#, 2]& ], 
       TagBox[
