Cell[CellGroupData[{

Cell["Using the gradient: training", "Subsection",ExpressionUUID->"74d92739-9983-4646-87e6-5c58d1f4e694"],

Cell[TextData[{
 "These formulas are what gradient training needs. Fit G to f on points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "fda704e4-c6f9-4c37-8501-53fa497ed0ea"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "M"], TraditionalForm]],ExpressionUUID->
  "a31d91b5-bb8d-410c-bf9f-f64f7b697cd3"],
 " by least squares; the chain rule applied to the loss gives"
}], "Text",ExpressionUUID->"50fe6bfa-cc8f-4e8c-a02f-2e5fc50a3300"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{"L", "=", 
         RowBox[{
          FractionBox["1", "M"], 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"m", "=", "1"}], "M"], 
           SuperscriptBox[
            SubscriptBox["r", "m"], "2"]}]}]}], 
        RowBox[{",", "  "}], 
        RowBox[{
         SubscriptBox["r", "m"], "=", 
         RowBox[{
          RowBox[{"G", 
           RowBox[{"(", 
            SubscriptBox["x", "m"], ")"}]}], "-", 
          RowBox[{"f", 
           RowBox[{"(", 
            SubscriptBox["x", "m"], ")"}]}]}]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", "L"}], 
         RowBox[{"\[PartialD]", "p"}]], "=", 
        RowBox[{
         FractionBox["2", "M"], 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"m", "=", "1"}], "M"], 
          RowBox[{
           SubscriptBox["r", "m"], " ", 
           RowBox[{
            FractionBox[
             RowBox[{"\[PartialD]", "G"}], 
             RowBox[{"\[PartialD]", "p"}]], 
            RowBox[{"(", 
             SubscriptBox["x", "m"], ")"}]}]}]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "6.4", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"45cd8cdb-aad7-42dc-8fd9-fa944b8f9611"],

Cell["\<\
where \[PartialD]G/\[PartialD]p is Eq. (6.1), (6.2) or (6.3). We train a \
network with one input, N = 8 hidden units and an output offset c on example \
A, f(x) = sin(2\[Pi]x) + x\.b2/2, at M = 200 points. The gradient of Eq. \
(6.4) is first checked against central finite differences of the loss.\
\>", "Text",ExpressionUUID->"6ace8189-57df-492f-b0c6-a1295573532f"],

Cell["\<\
The loss gradient from Eqs. (6.1)\[Dash](6.4) against finite differences, at \
random starting weights.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"8a221901-d63f-4cc8-8b05-3e7cad220830"],

Cell[CellGroupData[{

Cell["\<\
(*c.6.2*)
(* training data: example A of the main notebook on 200 points *)
xt = N@Range[0, 1, 1/199]; ft = f[xt]; nU = 8;
(* parameters in one vector p = (y_1..y_8, \[Theta]_1..\[Theta]_8, \
\[Alpha]_1..\[Alpha]_8, c) *)
unpack[p_] := {p[[1 ;; nU]], p[[nU + 1 ;; 2 nU]],
   p[[2 nU + 1 ;; 3 nU]], p[[-1]]};
netOut[p_, xs_] := Module[{y, t, a, c}, {y, t, a, c} = unpack[p];
   LogisticSigmoid[Outer[Times, xs, y] +
       ConstantArray[t, Length[xs]]] . a + c];
(* the loss of Eq. (6.4) and its gradient from Eqs. (6.1)-(6.3) *)
lossGrad[p_] := Module[{y, t, a, c, s, sa, r},
   {y, t, a, c} = unpack[p];
   s = LogisticSigmoid[Outer[Times, xt, y] + ConstantArray[t, Length[xt]]];
   sa = (s (1 - s)) . DiagonalMatrix[a];   (* \[Alpha]_j \[Sigma]'(z_j) at \
each x *)
   r = s . a + c - ft;                      (* residuals *)
   {Mean[r^2], 2/Length[xt] Join[(r xt) . sa, r . sa, r . s, {Total[r]}]}];
(* check the whole gradient against central finite differences *)
SeedRandom[11];
p0 = Join[RandomReal[{-10, 10}, nU], RandomReal[{-5, 5}, nU],
   RandomReal[{-1, 1}, nU], {0.}];
fd = Table[(First@lossGrad[p0 + 10^-6 UnitVector[3 nU + 1, i]] -
      First@lossGrad[p0 - 10^-6 UnitVector[3 nU + 1, i]])/(2 10^-6),
   {i, 3 nU + 1}];
<|\"largest |gradient - finite difference|\" ->
   Max@Abs[fd - Last@lossGrad[p0]],
  \"largest gradient entry\" -> Max@Abs[Last@lossGrad[p0]]|>\
\>", "Input",
 CellLabel->
  "In[204]:=",ExpressionUUID->"53a2935e-79b8-4cd9-867a-17ee889d1c1e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"largest |gradient - finite difference|\"\>", "\[Rule]", 
    "5.668653762537501`*^-11"}], ",", 
   RowBox[{"\<\"largest gradient entry\"\>", "\[Rule]", 
    "0.5558109988348813`"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0037954241924877`*^9},
 CellLabel->
  "Out[216]=",ExpressionUUID->"5fa4a0c3-3004-4a9d-8c5d-62b378d6b7d8"]
}, Open  ]],

Cell[TextData[{
 "Training uses gradient descent with the Adam update: each step moves the \
weights against a running average of the gradient, scaled by a running \
average of its size. The step size is 0.05/(1 + k/1000) at step k. The \
starting weights are random and far from good: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "j"], TraditionalForm]],ExpressionUUID->
  "b5f4e3a4-fe9b-4aae-babd-26715a6e7f36"],
 " in [-10, 10], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "j"], TraditionalForm]],ExpressionUUID->
  "b457afd5-8560-49bd-8271-85ad6df55446"],
 " in [-5, 5], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "j"], TraditionalForm]],ExpressionUUID->
  "e48d379f-7c15-44e3-b620-300f1c6be8a8"],
 " in [-1, 1]."
}], "Text",ExpressionUUID->"1a37685b-0706-49e0-b784-9132352639d5"],

Cell["Table 6.2. The training history.", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"b4b97aee-f20c-45af-b655-fb2990afc658"],

Cell[CellGroupData[{

Cell["\<\
(*c.6.3*)
(* gradient descent with the Adam update (Kingma and Ba 2015) and a
   slowly decaying step; snapshots of p are kept for Figure 6.2 *)
train[p00_, steps_] := Module[{p = p00, m, v, l, gr, hist = {}, snaps},
   m = v = 0 p00; snaps = <|0 -> p00|>;
   Do[{l, gr} = lossGrad[p]; AppendTo[hist, l];
    m = 0.9 m + 0.1 gr; v = 0.999 v + 0.001 gr^2;
    p -= 0.05/(1 + k/1000.) (m/(1 - 0.9^k))/
       (Sqrt[v/(1 - 0.999^k)] + 10^-8);
    If[MemberQ[{30, 300, 6000}, k], snaps[k] = p], {k, steps}];
   {p, hist, snaps}];
{pT, lossHist, snaps} = train[p0, 6000];
table[Prepend[Table[{k, sci[lossHist[[k]]],
     sci@Sqrt[lossHist[[k]]]}, {k, {1, 10, 100, 1000, 3000, 6000}}],
  {\"step\", \"loss (mean squared error)\", \"RMS error\"}], \"Table 6.2\"]\
\>", "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"71d3385c-406a-4cb2-8cc6-d421746fb17b"],

