Cell[TextData[{
 "Table 3.3. Rank of the hidden matrix. The logistic columns stay \
independent; the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "e2a7788f-9f2b-4db8-b1c5-bd520599508b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "91adb58d-a618-4ff1-935d-8192f9eca3f2"],
 " columns saturate at 6 and 10."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"456478f5-abc2-479f-b2ca-470af702bd1b"],

Cell[CellGroupData[{

Cell["\<\
(*c.3.4*)
(* rank of the 2000 x N hidden matrix: t^2 and t^3 saturate at 6 and 10 *)
SeedRandom[5];
rk[act_, nh_] := MatrixRank[hiddenA[act][trainPts,
    RandomReal[{-6, 6}, {nh, 2}], RandomReal[{-6, 6}, nh]],
   Tolerance -> 10^-9];
table[Prepend[
  Table[{nh, rk[LogisticSigmoid, nh], rk[acts[\"t\.b2\"], nh],
    rk[acts[\"t\.b3\"], nh]}, {nh, {4, 6, 8, 10, 20, 50}}],
  {\"N\", \"rank, logistic\", \"rank, t\.b2\", \"rank, t\.b3\"}], \"Table 3.3\
\"]\
\>", "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"b7045617-a1f8-4dff-919b-a4c758677aa9"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"N\"", "\"rank, logistic\"", "\"rank, t\.b2\"", "\"rank, t\.b3\""}, {
      "4", "4", "4", "4"}, {"6", "6", "6", "6"}, {"8", "8", "6", "8"}, {
      "10", "10", "6", "10"}, {"20", "20", "6", "10"}, {
      "50", "50", "6", "10"}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 3.3\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.003795421887821*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"52407742-3fbc-466c-ac0f-587ceabe486c"]
}, Open  ]],

Cell[TextData[{
 "Figure 3.2. Singular values of the hidden matrix for N = 40, relative to \
the largest. For ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "f5af7ea0-7289-443f-90a2-fa72cb98346e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "56956d37-0ea6-4606-ad5f-4054ec2c7bfb"],
 " they collapse to rounding level after the 6th and the 10th."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"b094abdd-618c-45bb-8045-8cd3cd9a05d4"],

Cell[CellGroupData[{

Cell["\<\
(*c.3.5*)
SeedRandom[5];
svals[act_] := Module[{yr = RandomReal[{-6, 6}, {40, 2}],
    th = RandomReal[{-6, 6}, 40], m},
   m = hiddenA[act][trainPts, yr, th];
   SingularValueList[m, Tolerance -> 0]/First@SingularValueList[m, 1]];
ListLogPlot[Table[Max[#, 10.^-18] & /@ svals[acts[k]], {k, Keys[acts]}],
 Joined -> True, PlotMarkers -> Automatic, PlotRange -> {10^-18, 2},
 AxesLabel -> {\"index\", \"relative singular value\"},
 GridLines -> {{6, 10}, None}, GridLinesStyle -> Directive[Gray, Dashed],
 PlotLegends -> Placed[LineLegend[Keys[acts], LabelStyle -> figStyle,
    LegendLayout -> \"Row\"], Below],
 PlotLabel -> \"Figure 3.2. Singular values, N = 40\",
 LabelStyle -> figStyle, ImageSize -> wFull]\
\>", "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"434c78d4-0794-41d4-ba19-b4d2d3bcdeda"],

