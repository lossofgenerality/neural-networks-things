Cell[TextData[{
 "The logistic error keeps falling, from 0.5 to 2 \[Times] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]], TraditionalForm]],ExpressionUUID->
  "18d23d91-1b97-46c2-9867-a3b40a9f117a"],
 " in RMS. The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "71e7ccaa-73fd-48f1-ad1c-9f3243b398e7"],
 " error is stuck at 0.508 from the start, and the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "fa8c8c19-ad95-4f25-a0bb-8f6e03863ee6"],
 " error drops once, to 0.331, at N = 10, and then stops for good. Adding \
units does nothing."
}], "Text",ExpressionUUID->"4ea671c2-e3c3-47d2-b481-46fba263f072"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Why: the network is a polynomial", "Subsection",ExpressionUUID->"c8091f9d-7f72-405c-b19b-40bab1018662"],

Cell[TextData[{
 "With \[Sigma](t) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "4e23ac4f-7f38-41d5-90de-8fc0a61b6133"],
 " every hidden unit is the square of an affine function, and expanding the \
square gives only the monomials 1, x, y, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "31d43424-984d-4689-a115-d31dd4d1dd7f"],
 ", x y, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "bfdced2e-a3f5-4665-858f-febd1e73a299"],
 ":"
}], "Text",ExpressionUUID->"e8a9eccb-7480-4b1b-92e6-7f1ffdc94c3f"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "1"}], "N"], 
         RowBox[{
          SubscriptBox["\[Alpha]", "j"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SubscriptBox["y", 
               RowBox[{"j", "1"}]], "x"}], "+", 
             RowBox[{
              SubscriptBox["y", 
               RowBox[{"j", "2"}]], "y"}], "+", 
             SubscriptBox["\[Theta]", "j"]}], ")"}], "2"]}]}], "=", 
        RowBox[{
         SubscriptBox["a", "0"], "+", 
         RowBox[{
          SubscriptBox["a", "1"], "x"}], "+", 
         RowBox[{
          SubscriptBox["a", "2"], "y"}], "+", 
         RowBox[{
          SubscriptBox["a", "3"], 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{
          SubscriptBox["a", "4"], "x", "y"}], "+", 
         RowBox[{
          SubscriptBox["a", "5"], 
          SuperscriptBox["y", "2"]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "3.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"34676890-6787-4291-b3ba-ea329cd6fbb6"],

Cell[TextData[{
 "However many units there are, the network is a polynomial of degree at most \
2, an element of a 6-dimensional space. With ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "b63524fc-9bb0-46a7-a862-1d55c92da6c0"],
 " it is a polynomial of degree at most 3. In general the polynomials of \
degree at most k in n variables form a space of dimension"
}], "Text",ExpressionUUID->"f6e2cac7-dea1-46b0-ac27-12105c8eeb8d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"dim", " ", 
     SubscriptBox["P", "k"], 
     RowBox[{"(", 
      SuperscriptBox["\[DoubleStruckCapitalR]", "n"], ")"}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        StyleBox[
         RowBox[{"n", "+", "k"}],
         ScriptLevel->0]},
       {
        StyleBox["k",
         ScriptLevel->0]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}},
      GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], ")"}], 
    RowBox[{",", "    "}], 
    RowBox[{"n", "=", "2"}], 
    RowBox[{":", "  "}], 
    RowBox[{"k", "=", "2"}], "\[Implies]", "6", 
    RowBox[{",", "  "}], 
    RowBox[{"k", "=", "3"}], "\[Implies]", "10"}], "        ", 
   StyleBox[
    RowBox[{"(", "3.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"3bc628b4-dac9-40a9-a96a-947b0b5596dc"],

Cell["\<\
Adding units adds columns to the 2000 \[Times] N hidden matrix, but beyond 6 \
(or 10) columns they are linear combinations of the earlier ones. The rank \
stops growing, Table 3.3, and the singular values beyond the 6th (or 10th) \
are zero up to rounding, Figure 3.2. The least-squares fit can then do no \
better than the best polynomial of that degree. That polynomial can be \
computed exactly by projecting g onto the monomials in the mean square over \
[-1, 1]\.b2:\
\>", "Text",ExpressionUUID->"c121ac34-4660-4668-9812-bd135d3d584a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["p", "2"], "=", "0"}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["p", "3"], "=", 
     FractionBox[
      RowBox[{"45", "x", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"3", 
          SuperscriptBox["y", "2"]}]}], ")"}]}], 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "3"]}]]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "3.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"df0c8b33-82b0-4c8a-bf56-7c75dba2bb9e"],

Cell[TextData[{
 "The best quadratic is zero. g is odd in x and even in y, so the only \
quadratic monomial that could match it is x, and its coefficient contains the \
integral of cos(\[Pi]y) over [-1, 1], which is 0. The RMS error of the zero \
polynomial is the RMS of g itself, 1/2. The cubic picks up x and x ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "8551ba8e-45dc-466a-8dfc-e9ffccf5a38e"],
 ", and its error is 0.331. Both agree with the plateaus of Table 3.1; the \
small differences come from using 2000 sample points instead of the \
integral."
}], "Text",ExpressionUUID->"b11303ca-f5a8-4493-888d-623372f0af73"],

Cell["\<\
Table 3.2. Best polynomial approximations of degree 2 and 3, their RMS \
errors, and the plateaus of Table 3.1.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"6503aeca-a792-435f-bb90-7f87ef2ae225"],

Cell[CellGroupData[{

Cell["\<\
(*c.3.2*)
(* the best polynomial approximations of degree 2 and 3 in L\.b2([-1,1]\.b2),
   computed exactly by projection *)
proj[basis_] := Module[{gram, rhs},
   gram = Outer[Integrate[#1 #2, {x, -1, 1}, {y, -1, 1}] &, basis, basis];
   rhs = Integrate[# g[x, y], {x, -1, 1}, {y, -1, 1}] & /@ basis;
   Simplify[LinearSolve[gram, rhs] . basis]];
poly[k_] := Flatten@Table[x^i y^j, {i, 0, k}, {j, 0, k - i}];
best2 = proj[poly[2]];
best3 = proj[poly[3]];
(* exact RMS error over the square *)
rmsOf[p_] := N@Sqrt[Integrate[Expand[(g[x, y] - p)^2],
      {x, -1, 1}, {y, -1, 1}]/4];
table[{{\"degree\", \"monomials\", \"best polynomial\", \"RMS error\",
   \"plateau of Table 3.1\"},
  {2, Length[poly[2]], TraditionalForm[best2], NumberForm[rmsOf[best2], 4],
   NumberForm[Last[errQ[\"t\.b2\"]][[2]], 4]},
  {3, Length[poly[3]], TraditionalForm[best3], NumberForm[rmsOf[best3], 4],
   NumberForm[Last[errQ[\"t\.b3\"]][[2]], 4]}}, \"Table 3.2\"]\
\>", "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"2aaede02-bc63-4351-8f1e-d2260b7c8593"],

