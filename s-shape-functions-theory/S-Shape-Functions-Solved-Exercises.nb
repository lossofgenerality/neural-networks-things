Cell["\<\
Unrolling removes the cycle again. Following the blue arrows forward in time \
gives a chain of copies of the same step, a deep feedforward network whose \
layers all share W, U and b:\
\>", "Text",ExpressionUUID->"f5953b6a-b673-4914-bde1-64441b9f4a2d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["h", "t"], "=", 
     RowBox[{"F", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["x", "t"], ",", 
        SubscriptBox["h", 
         RowBox[{"t", "-", "1"}]]}], ")"}]}]}], "=", 
    RowBox[{"F", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       RowBox[{"F", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"t", "-", "1"}]], ",", 
          RowBox[{"F", 
           RowBox[{"(", "\[Ellipsis]", ")"}]}]}], ")"}]}]}], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "5.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"04c3ef39-cac7-43ca-a49b-5392fb63d4c6"],

Cell["\<\
Figure 5.3. The recurrent layer unrolled over four time steps. Each blue \
arrow is a copy of the step of Figure 5.1; backpropagation through time \
follows these arrows backwards, as Eq. (M5) follows the arrows of Figure M3.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"95f73c21-8840-4766-94e5-94c95ed1be57"],

Cell[CellGroupData[{

Cell["\<\
(*c.5.5*)
(* unrolled in time the loop disappears: a deep feedforward network in
   which every layer is the same Cybenko-type step, with shared W, U, b *)
T = 4;
unrolled = Join[
   Table[DirectedEdge[Subscript[\"x\", t], Subscript[\"h\", t]], {t, T}],
   Table[DirectedEdge[Subscript[\"h\", t - 1], Subscript[\"h\", t]], {t, \
T}]];
Graph[unrolled,
 VertexCoordinates -> Join[Table[Subscript[\"h\", t] -> {2 t, 0}, {t, 0, T}],
   Table[Subscript[\"x\", t] -> {2 t, -1.6}, {t, T}]],
 VertexLabels -> Placed[\"Name\", Above],
 VertexLabelStyle -> Directive[Black, figFont],
 EdgeLabels -> Join[
   Table[DirectedEdge[Subscript[\"x\", t], Subscript[\"h\", t]] ->
     Placed[\"W\", 0.5], {t, T}],
   Table[DirectedEdge[Subscript[\"h\", t - 1], Subscript[\"h\", t]] ->
     Placed[\"U\", 0.5], {t, T}]],
 EdgeLabelStyle -> Directive[figFont - 2, Darker[Red],
   Background -> White],
 EdgeStyle -> Join[
   Table[DirectedEdge[Subscript[\"h\", t - 1], Subscript[\"h\", t]] ->
     Directive[Blue, Dashed, Arrowheads[0.03]], {t, T}],
   Table[DirectedEdge[Subscript[\"x\", t], Subscript[\"h\", t]] ->
     Directive[Black, Arrowheads[0.03]], {t, T}]],
 VertexSize -> 0.25, ImageSize -> wFull,
 PlotLabel -> Style[\"Figure 5.3. Unrolled over four time steps\",
   figFont]]\
\>", "Input",
 CellLabel->
  "In[194]:=",ExpressionUUID->"5333b906-332e-4848-8808-3a565cf5bd06"],

