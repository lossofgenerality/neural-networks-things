Cell["\<\
(*c.7.6*)
Show[
 ListLogLogPlot[{errTab[\"x sin(1/x)\"][[All, {1, 3}]],
   errTab[\"Cantor\"][[1 ;; 6, {1, 3}]],
   errTab[\"Cantor\"][[7 ;;, {1, 3}]]},
  Joined -> {True, True, False}, PlotMarkers -> Automatic,
  PlotRange -> {{2, 1000}, {0.004, 0.6}},
