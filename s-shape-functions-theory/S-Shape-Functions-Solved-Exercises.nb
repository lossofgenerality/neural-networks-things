Cell[TextData[{
 "Read Figure 5.1 as Figure M3 was read in the main notebook. Information \
flows from left to right, each arrow multiplies by its weight, each hidden \
node adds what arrives and passes it through \[Sigma], and the arrows form a \
directed acyclic graph. Nothing in the picture is recurrent yet: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "old"], TraditionalForm]],ExpressionUUID->
  "56f95cc5-0790-4c51-ad06-17473656c862"],
 " is just two more inputs."
}], "Text",ExpressionUUID->"ceb77800-ab06-4543-b0f0-04db8749f65c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The arrow that makes it recurrent", "Subsection",ExpressionUUID->"363717b3-d1e8-40f6-9b09-22e9f351d866"],

Cell[TextData[{
 "The recurrence is the identification of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "old"], TraditionalForm]],ExpressionUUID->
  "c066df71-afe3-4acc-9c8a-6eb214636794"],
 " at time t with the output h at time t - 1. In the graph this means an \
arrow from each output node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "l"], TraditionalForm]],ExpressionUUID->
  "a997abdd-f822-4228-bcda-fe11ff995e0e"],
 " back to the state units, carrying the weight ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "il"], TraditionalForm]],ExpressionUUID->
  "bebd7d88-139e-45f3-a04c-3a0e4c64c98f"],
 " and crossed with a delay of one time step. These are the dashed blue \
arrows of Figure 5.2, including the self-loops ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "11"], TraditionalForm]],ExpressionUUID->
  "c19d8f3e-ef47-4277-b488-48de89a3e853"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "22"], TraditionalForm]],ExpressionUUID->
  "ee9003b6-36df-46f0-a618-2c46bdf5e835"],
 ". They make the graph cyclic, and this cycle is all that separates a \
recurrent layer from a feedforward one."
}], "Text",ExpressionUUID->"aa1ce6e7-0a87-4555-82b4-1cfa0de91016"],

Cell[TextData[{
 "Figure 5.2. The recurrent layer folded into one picture. Black arrows: the \
input weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", "ik"], TraditionalForm]],ExpressionUUID->
  "bfae6ed5-ee0f-481c-9809-d5e0a9a7e7af"],
 ", as in Figure 5.1. Dashed blue arrows: the new arrows ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "il"], TraditionalForm]],ExpressionUUID->
  "0d855537-ad1e-4113-9b29-6d8b54c7a45f"],
 " from the state back into the state, each crossed one time step later."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"847cdb5d-939d-45f4-a7ed-87687f80e9ca"],

Cell[CellGroupData[{

Cell["\<\
(*c.5.4*)
(* the recurrent layer: the new arrows U_il run from the state units back
   into the state units, and each is crossed one time step later *)
recE = Join[
   Flatten@Table[DirectedEdge[Subscript[\"x\", k], Subscript[\"h\", i]],
     {k, 2}, {i, 2}],
   Flatten@Table[DirectedEdge[Subscript[\"h\", l], Subscript[\"h\", i]],
     {l, 2}, {i, 2}]];
Graph[recE,
 VertexCoordinates -> {Subscript[\"x\", 1] -> {0, 1.5},
   Subscript[\"x\", 2] -> {0, -1.5}, Subscript[\"h\", 1] -> {3.5, 1.5},
   Subscript[\"h\", 2] -> {3.5, -1.5}},
 VertexLabels -> {Subscript[\"x\", 1] -> Placed[Subscript[\"x\", 1], Before],
   Subscript[\"x\", 2] -> Placed[Subscript[\"x\", 2], Before],
   Subscript[\"h\", 1] -> Placed[Subscript[\"h\", 1], Above],
   Subscript[\"h\", 2] -> Placed[Subscript[\"h\", 2], Below]},
 VertexLabelStyle -> Directive[Black, figFont],
 EdgeStyle -> Join[
   Flatten@Table[DirectedEdge[Subscript[\"x\", k], Subscript[\"h\", i]] ->
      Directive[Black, Arrowheads[0.03]], {k, 2}, {i, 2}],
   Flatten@Table[DirectedEdge[Subscript[\"h\", l], Subscript[\"h\", i]] ->
      Directive[Blue, Dashed, Arrowheads[0.03]], {l, 2}, {i, 2}]],
 EdgeLabels -> Join[
   Flatten@Table[DirectedEdge[Subscript[\"x\", k], Subscript[\"h\", i]] ->
      Placed[Subscript[\"W\", 10 i + k], 0.75], {k, 2}, {i, 2}],
   Flatten@Table[DirectedEdge[Subscript[\"h\", l], Subscript[\"h\", i]] ->
      Placed[Subscript[\"U\", 10 i + l], 0.5], {l, 2}, {i, 2}]],
 EdgeLabelStyle -> Directive[figFont - 2, Darker[Red],
   Background -> White],
 VertexSize -> 0.12, ImageSize -> wFull,
 PlotLabel -> Style[\"Figure 5.2. The recurrent arrows (dashed blue)\",
   figFont]]\
\>", "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"70a4f77c-5f03-4b79-87c7-be683aa7346f"],

