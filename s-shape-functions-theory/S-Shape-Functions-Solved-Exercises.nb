Cell[CellGroupData[{

Cell["Does the staircase converge?", "Subsection",ExpressionUUID->"0f67ed6d-f02c-4ea8-8206-e49b92a098a0"],

Cell[TextData[{
 "Build the staircase of Eq. (M7) from s instead of \[Sigma]. Compared with \
the ideal staircase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]],ExpressionUUID->
  "3f423fe5-a952-4f93-9873-9613d1bbaaa8"],
 " of Eq. (1.3), each step now has a wiggle of relative size up to 0.068 on \
either side. Splitting the error as in Problem 1 gives the bound"
}], "Text",ExpressionUUID->"a1f2281c-dea5-496e-b37d-d224b3240af0"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{"|", 
         RowBox[{
          RowBox[{
           SubscriptBox["G", "N"], 
           RowBox[{"(", "x", ")"}]}], "-", 
          RowBox[{"f", 
           RowBox[{"(", "x", ")"}]}]}], "|"}], "\[LessEqual]", 
        RowBox[{
         SubscriptBox["\[Omega]", "f"], 
         RowBox[{"(", 
          FractionBox["1", 
           RowBox[{"2", "N"}]], ")"}]}], "+", 
        RowBox[{
         SubscriptBox["K", "s"], " ", 
         RowBox[{
          SubscriptBox["\[Omega]", "f"], 
          RowBox[{"(", 
           FractionBox["1", "N"], ")"}]}]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        SubscriptBox["K", "s"], "=", 
        RowBox[{
         UnderscriptBox["sup", "x"], " ", 
         RowBox[{
          UnderscriptBox["\[Sum]", "k"], 
          RowBox[{"|", 
           RowBox[{
            RowBox[{"s", 
             RowBox[{"(", 
              RowBox[{"\[Lambda]", 
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 SubscriptBox["c", "k"]}], ")"}]}], ")"}]}], "-", 
            RowBox[{"H", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               SubscriptBox["c", "k"]}], ")"}]}]}], "|"}]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "2.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"ed1cda7f-03ed-48c4-8406-48deebbe1a46"],

Cell[TextData[{
 "The first term is the ideal staircase, Eq. (7.1) below. The second collects \
all the steps, each of height |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "1dc4057d-f5d5-49d7-9d48-cd2080af28f0"],
 "| \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "2460805b-8f79-434a-9129-e1f0e28faec7"],
 "(1/N). With \[Lambda] = c N the constant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "s"], TraditionalForm]],ExpressionUUID->
  "e7e5e6e8-d49c-4c94-977b-b911bd2cef29"],
 " depends only on s and c, not on N, because |s(u) - H(u)| decays fast (here \
like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "u"}]], TraditionalForm]],ExpressionUUID->
  "a55f8ccf-5bd8-4960-883d-4b5d8e378327"],
 "). So the error is O(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "f"], TraditionalForm]],ExpressionUUID->
  "142fd524-0750-4cf8-be88-8d889307833d"],
 "(1/N)), the same order as for the logistic. Only the constant changes."
}], "Text",ExpressionUUID->"13545cf7-6994-4c3f-b085-46f01bce25b6"],

Cell[TextData[{
 "Figure 2.3. Left: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "10"], TraditionalForm]],ExpressionUUID->
  "6035e0d5-c85c-4112-b6fb-bb47066da056"],
 " for example A built from the logistic and from s, with a deliberately soft \
\[Lambda] = 40 so that the wiggles are visible. Right: a zoom."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"475c8a5f-1190-4419-bc48-c1d694d9635e"],

Cell[CellGroupData[{

Cell["\<\
(*c.2.4*)
(* the same function, safe for whole arrays of large arguments *)
s2v = Function[t, LogisticSigmoid[t] + Sin[t] Exp[-Clip[t^2, {0, 700}]]];
gS = stairOn[s2v, f[nodes[10]], 40, xsFine];
gL = stairOn[LogisticSigmoid, f[nodes[10]], 40, xsFine];
figure[{{
   ListLinePlot[{Transpose[{xsFine, f[xsFine]}],
     Transpose[{xsFine, gL}], Transpose[{xsFine, gS}]},
    PlotStyle -> {Directive[Black, Dashed], Automatic, Automatic},
    PlotLegends -> Placed[LineLegend[{\"f\", \"logistic\", \"non-monotone\"},
       LabelStyle -> Directive[figFont - 3]], Below],
    Evaluate@panel[PlotLabel -> \"2.3a. N = 10, \[Lambda] = 40\"]],
   ListLinePlot[{Transpose[{xsFine, f[xsFine]}],
     Transpose[{xsFine, gL}], Transpose[{xsFine, gS}]},
    PlotRange -> {{0.25, 0.65}, All},
    PlotStyle -> {Directive[Black, Dashed], Automatic, Automatic},
    Ticks -> {{0.3, 0.4, 0.5, 0.6}, Automatic},
    Evaluate@panel[PlotLabel -> \"2.3b. zoom on 0.25 \[LessEqual] x \
\[LessEqual] 0.65\"]]}},
 \"Figure 2.3. Staircases from the non-monotone S-shape\"]\
\>", "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"204df257-e6c4-401c-981c-669ecc7454ec"],

