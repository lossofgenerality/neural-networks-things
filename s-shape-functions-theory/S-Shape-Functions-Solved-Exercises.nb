Cell[CellGroupData[{

Cell["The leakage and its formula", "Subsection",ExpressionUUID->"46937d34-b89a-4876-9713-c037382fc863"],

Cell[TextData[{
 "At a node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "8b6d2434-41bc-40f9-9381-d884a6171f33"],
 " every step to its left has risen to 1 - T and every step to its right has \
risen to T. With the symmetry \[Sigma](-u) = 1 - \[Sigma](u), the leakage is \
exactly"
}], "Text",ExpressionUUID->"b5bf5b88-a4da-43e4-82ed-61df8fb74162"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{
         SubscriptBox["G", "N"], 
         RowBox[{"(", 
          SubscriptBox["x", "k"], ")"}]}], "-", 
        RowBox[{"f", 
         RowBox[{"(", 
          SubscriptBox["x", "k"], ")"}]}], "=", 
        RowBox[{"-", 
         RowBox[{
          UnderscriptBox["\[Sum]", "m"], 
          RowBox[{
           RowBox[{"sgn", 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["x", "k"], "-", 
              SubscriptBox["c", "m"]}], ")"}]}], " ", 
           SubscriptBox["\[CapitalDelta]", "m"], " ", 
           RowBox[{"T", 
            RowBox[{"(", 
             RowBox[{"\[Lambda]", 
              RowBox[{"|", 
               RowBox[{
                SubscriptBox["x", "k"], "-", 
                SubscriptBox["c", "m"]}], "|"}]}], ")"}]}]}]}]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        RowBox[{
         RowBox[{"T", 
          RowBox[{"(", "u", ")"}]}], "=", 
         RowBox[{"1", "-", 
          RowBox[{"\[Sigma]", 
           RowBox[{"(", "u", ")"}]}]}], "=", 
         RowBox[{"\[Sigma]", 
          RowBox[{"(", 
           RowBox[{"-", "u"}], ")"}]}]}], 
        RowBox[{",", "  "}], 
        RowBox[{
         SubscriptBox["x", "k"], "=", 
         FractionBox["k", "N"]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "1.4", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"ff7b276f-2b89-4005-87de-ec2a2bd6ad8e"],

Cell[TextData[{
 "Each jump ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "m"], TraditionalForm]],ExpressionUUID->
  "89ea58b3-fbd1-4334-9707-58762e87856f"],
 " of f contributes its height times the tail at the scaled distance from the \
node. Replacing T by its leading term from Eq. (1.1) turns Eq. (1.4) into a \
prediction, without any fitting. For the logistic only the two nearest steps, \
at distance 1/(2N), matter, and the leakage falls like exp(-\[Lambda]/(2N)). \
For the algebraic sigmoid every step contributes and the leakage falls like \
1/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "2"], TraditionalForm]],ExpressionUUID->
  "c36b35c9-5067-4dcd-98e7-cf6efdaba50c"],
 ". For the arctan sigmoid it falls only like 1/\[Lambda], and the sum over \
all steps does not cancel."
}], "Text",ExpressionUUID->"2af0f9df-5de2-4907-a0a4-b6033a275140"],

Cell[TextData[{
 "Table 1.3. Leakage at N = 20, measured and predicted by Eq. (1.4). From \
\[Lambda] = 400 on, the predictions agree with the measurements to two \
digits. The logistic measurement stops at 6 \[Times] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "17"}]], TraditionalForm]],ExpressionUUID->
  "1e5fccf4-68e1-4622-8c58-5451c2dd81b5"],
 ", the rounding level of machine numbers."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"4c4a8f69-1545-41a8-908a-dbe24fd23cda"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.5*)
(* leakage: error at the nodes k/N, where the ideal staircase is exact *)
leakAt[s_, n_, lam_] :=
  stairOn[s, f[nodes[n]], lam, nodes[n]] - f[nodes[n]];
leak[s_, n_, lam_] := Max@Abs@leakAt[s, n, lam];
(* prediction of Eq. (1.4): each tail replaced by its leading term *)
predAt[k_, n_, lam_] := Quiet@Module[
   {d = Differences[f[nodes[n]]], c = N[(Range[n] - 1/2)/n]},
   Table[-Total[Sign[x - c] d (lead[k] /. u -> lam Abs[x - c])],
    {x, nodes[n]}]];
predLeak[k_, n_, lam_] := Max@Abs@predAt[k, n, lam];
lams = {100, 400, 1600, 6400, 25600};
table[Prepend[
  Flatten[Table[{
     {k, \"measured\", Sequence @@ (sci@leak[sig3[k], 20, #] & /@ lams)},
     {\"\", \"Eq. (1.4)\", Sequence @@ (sci@predLeak[k, 20, #] & /@ lams)}},
    {k, Keys[sig3]}], 1],
  Join[{\"\[Sigma]\", \"\"}, (\"\[Lambda] = \" <> ToString[#] &) /@ lams]], \
\"Table 1.3\"]\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"075189c6-865e-4856-84d4-9e47fe38da92"],

