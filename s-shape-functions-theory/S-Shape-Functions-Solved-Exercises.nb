Cell[CellGroupData[{

Cell["Table M3 repeated", "Subsection",ExpressionUUID->"05755f9a-9963-4798-9865-f86940be5280"],

Cell[TextData[{
 "First the experiment as asked: the staircase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "ed97e37a-3acf-4714-936b-c1efb6131306"],
 " of Eq. (M7), with steepness \[Lambda] = 20 N as in Table M3, built from \
each of the three S-shapes, and its largest error on [0, 1] for example A."
}], "Text",ExpressionUUID->"63d14c2a-3a82-40cd-830c-3459b6542061"],

Cell[TextData[{
 "Table 1.2. Sup-norm error of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "1f1fff48-22df-450c-89bc-e29e07ac6691"],
 " for example A with each S-shape, \[Lambda] = 20 N."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"8b516f06-c77c-44b8-b712-6380b2fcd67a"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.3*)
(* Table M3, row A, repeated with each S-shape, \[Lambda] = 20 N *)
table[Prepend[
  Table[Prepend[Table[NumberForm[supErrS[sig3[k], f, n, 20 n], 3],
     {n, {5, 10, 20, 40, 80}}], k], {k, Keys[sig3]}],
  {\"\[Sigma]\", \"N = 5\", \"N = 10\", \"N = 20\", \"N = 40\", \"N = 80\"}], \
\"Table 1.2\"]\
\>", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"b83ca80e-b939-4325-b162-47719225a003"],

