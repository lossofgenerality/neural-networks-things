Cell[TextData[{
 "Figure 3.3. The target g and what the three networks learn with N = 200. \
The logistic network reproduces g; the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "962d7dac-1efc-4135-a566-224a319c6ad1"],
 " network gives a nearly flat surface (the sampled best quadratic, close to \
0); the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "d40478bd-2091-4600-9313-b0ac571b37e4"],
 " network gives the cubic of Eq. (3.3)."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"6b4e60f2-b1d5-4a3a-88e5-ac738a676aba"],

Cell[CellGroupData[{

Cell["\<\
(*c.3.6*)
SeedRandom[8];
surf[fun_, lbl_] := Plot3D[fun[x, y], {x, -1, 1}, {y, -1, 1},
   PlotRange -> {-1.1, 1.1}, ColorFunction -> \"TemperatureMap\",
   PlotPoints -> 25, Ticks -> {{-1, 0, 1}, {-1, 0, 1}, {-1, 0, 1}},
   Evaluate@panel[PlotLabel -> lbl]];
netFun[act_, nh_] := With[{m = fitA[act, nh]},
   Function[{x, y}, First[hiddenA[act][{{x, y}}, m[[1]], m[[2]]] .
      m[[3]]]]];
{fSq, fCu, fLo} = {netFun[acts[\"t\.b2\"], 200], netFun[acts[\"t\.b3\"], \
200],
   netFun[LogisticSigmoid, 200]};
figure[{
  {surf[g, \"3.3a. target g\"], surf[fLo, \"3.3b. logistic, N = 200\"]},
  {surf[fSq, \"3.3c. t\.b2, N = 200\"], surf[fCu, \"3.3d. t\.b3, N = \
200\"]}},
 \"Figure 3.3. What the networks learn\"]\
\>", "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"9c7bbd37-dae6-4edc-a98a-f3daf392fb91"],

