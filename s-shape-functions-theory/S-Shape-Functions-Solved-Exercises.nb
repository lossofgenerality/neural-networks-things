Cell[TextData[{
 "To test how much the wiggle matters, Table 2.2 uses the family \[Sigma](t) \
+ A sin(t) exp(-",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "2"], TraditionalForm]],ExpressionUUID->
  "7dcc09a2-b37b-4715-8066-d87ced6bd414"],
 ") with amplitude A = 0 (the logistic), A = 1 (the function of the problem) \
and A = 3, which overshoots to 1.85 and -0.85."
}], "Text",ExpressionUUID->"fd94f81e-faa6-4a5b-a20c-42e8e6b5e53b"],

Cell[TextData[{
 "Table 2.2. Sup-norm error of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "59e4246a-acd8-47fb-ac4b-35615765dc93"],
 " for example A, \[Lambda] = 20 N, three amplitudes A."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"9d002ead-cb03-4309-bda7-401705e75ac1"],

Cell[CellGroupData[{

Cell["\<\
(*c.2.5*)
(* the family \[Sigma] + A sin(t) exp(-t\.b2): A = 0 is the logistic *)
sA[a_] := Function[t,
   LogisticSigmoid[t] + a Sin[t] Exp[-Clip[t^2, {0, 700}]]];
nsA = {5, 10, 20, 40, 80, 160};
errA = Table[a -> Table[supErrS[sA[a], f, n, 20 n], {n, nsA}],
   {a, {0, 1, 3}}] // Association;
table[Join[{Prepend[(\"N = \" <> ToString[#] &) /@ nsA, \"A\"]},
   Table[Prepend[NumberForm[#, 3] & /@ errA[a], a], {a, {0, 1, 3}}],
   {Prepend[NumberForm[#, 3] & /@ (errA[1]/errA[0]), \"ratio A=1 / A=0\"]}],
 \"Table 2.2\"]\
\>", "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"980dfc47-7005-4e37-ba07-4a02ae28c9f5"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"A\"", "\"N = 5\"", "\"N = 10\"", "\"N = 20\"", "\"N = 40\"", 
       "\"N = 80\"", "\"N = 160\""}, {"0", 
       TagBox[
        InterpretationBox[
         StyleBox["\"0.442\"", ShowStringCharacters -> False], 
         0.4418673063485886, AutoDelete -> True], NumberForm[#, 3]& ], 
