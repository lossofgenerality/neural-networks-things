Cell["\<\
Table 1.1. Each tail divided by its leading term tends to 1, as Eq. (1.1) \
states. The closed forms u(\[Eta]) of Eq. (1.2), a numerical check of them, \
and their values.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"67a37900-4c37-4f1c-b7f6-4605dffd5708"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.2*)
(* leading term of each tail, Eq. (1.1) *)
lead = <|\"logistic\" -> Exp[-u], \"arctan\" -> 1/(Pi u),
   \"algebraic\" -> 1/(4 u^2)|>;
(* the steepness u at which the tail falls to \[Eta], Eq. (1.2) *)
uOf = <|\"logistic\" -> Log[(1 - \[Eta])/\[Eta]], \"arctan\" -> Cot[Pi \[Eta]],
   \"algebraic\" -> (1 - 2 \[Eta])/(2 Sqrt[\[Eta] (1 - \[Eta])])|>;
table[Prepend[
  Table[{k, Limit[tail[k][u]/lead[k], u -> Infinity],
    TraditionalForm[uOf[k]],
    sci@Max@Table[Abs[tail[k][uOf[k]] - \[Eta]]/\[Eta],
      {\[Eta], 10.^-Range[1, 6]}],
    Sequence @@ Table[NumberForm[N[uOf[k] /. \[Eta] -> e], 4],
      {e, {10^-2, 10^-3, 10^-6}}]}, {k, Keys[sig3]}],
  {\"\[Sigma]\", \"tail / lead\", \"u(\[Eta])\", \"check: rel. error\",
   \"\[Eta] = 0.01\", \"\[Eta] = 0.001\", Row[{\"\[Eta] = \", Superscript[10, \
-6]}]}],
 \"Table 1.1\"]\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"395bbdb6-bae5-441e-806a-e5c0b4e2f99c"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"\[Sigma]\"", "\"tail / lead\"", "\"u(\[Eta])\"", 
       "\"check: rel. error\"", "\"\[Eta] = 0.01\"", "\"\[Eta] = 0.001\"", 
       TemplateBox[{"\"\[Eta] = \"", 
         TemplateBox[{"10", 
           RowBox[{"-", "6"}]}, "Superscript", SyntaxForm -> SuperscriptBox]},
         "RowDefault"]}, {"\"logistic\"", "1", 
       TagBox[
        FormBox[
         RowBox[{"log", "(", 
           FractionBox[
            RowBox[{"1", "-", "\[Eta]"}], "\[Eta]"], ")"}], TraditionalForm], 
        TraditionalForm, Editable -> True], 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"8.5\"", "\[Times]", 
            SuperscriptBox["10", "\"-16\""]}], ShowStringCharacters -> False],
          8.470329472543003*^-16, AutoDelete -> True], 
        ScientificForm[#, 2]& ], 
