Cell[TextData[{
 "A surprise: at \[Lambda] = 20 N the three errors are almost the same, and \
the arctan staircase is even slightly better. The sup-norm error here is \
dominated by the coarseness of the staircase, which is O(1/N) whatever the \
S-shape, and a softer step even rounds the corners of the staircase a little. \
To see where the S-shape matters, compare ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "c00c1dde-4d43-49f5-8fe3-d00cfbaad534"],
 " with the ideal staircase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]],ExpressionUUID->
  "4b132386-a21d-4e7d-bca6-5b8c124ab414"],
 " of hard steps, the limit \[Lambda] \[RightArrow] \[Infinity] used in the \
proof of Lemma M1:"
}], "Text",ExpressionUUID->"89ae6eeb-b601-4c6b-b297-c53b2af29f0c"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        RowBox[{
         SubscriptBox["S", "N"], 
         RowBox[{"(", "x", ")"}]}], "=", 
        RowBox[{"f", 
         RowBox[{"(", "0", ")"}]}], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "1"}], "N"], 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "k"], " ", 
          RowBox[{"H", 
           RowBox[{"(", 
            RowBox[{"x", "-", 
             SubscriptBox["c", "k"]}], ")"}]}]}]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "k"], "=", 
         RowBox[{"f", 
          RowBox[{"(", 
           FractionBox["k", "N"], ")"}]}], "-", 
         RowBox[{"f", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"k", "-", "1"}], "N"], ")"}]}]}], 
        RowBox[{",", "  "}], 
        RowBox[{
         SubscriptBox["c", "k"], "=", 
         FractionBox[
          RowBox[{"k", "-", 
           FractionBox["1", "2"]}], "N"]}], 
        RowBox[{",", "  "}], 
        RowBox[{
         RowBox[{
          SubscriptBox["S", "N"], 
          RowBox[{"(", 
           FractionBox["k", "N"], ")"}]}], "=", 
         RowBox[{"f", 
          RowBox[{"(", 
           FractionBox["k", "N"], ")"}]}]}]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "1.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"3b2ad672-6e2f-4bff-af93-220b6b3d77b0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "N"], TraditionalForm]],ExpressionUUID->
  "02573372-3d08-4807-8bd9-34ac9eed32e0"],
 " is exact at the nodes k/N, which lie halfway between two step positions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "k"], TraditionalForm]],ExpressionUUID->
  "a96f1fb4-d2f4-469d-80e7-e075b5b33f9a"],
 ". So any error of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "N"], TraditionalForm]],ExpressionUUID->
  "ec132440-71a5-4dee-b33a-4e381a24ee28"],
 " at a node is caused by the tails of the steps alone. We call it leakage."
}], "Text",ExpressionUUID->"795b08f5-d03e-452d-8f0e-ab761d37e9c8"],

Cell[TextData[{
 "Figure 1.2. Top: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "10"], TraditionalForm]],ExpressionUUID->
  "ca1e9be4-9f1b-4a3d-950f-e3f8b6b42ebd"],
 " with \[Lambda] = 200 for the three S-shapes, nearly indistinguishable. \
Bottom: the distance |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "10"], TraditionalForm]],ExpressionUUID->
  "3d199233-ed93-4e2c-a142-263d49457c45"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "10"], TraditionalForm]],ExpressionUUID->
  "43b199ec-4314-478b-86fe-e7421f626a04"],
 "| on a log scale. At the nodes (grid lines) it falls to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]],ExpressionUUID->
  "94d1f087-4a9a-436e-97e3-c85ce16287b1"],
 " for the logistic and to between ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "4"}]], TraditionalForm]],ExpressionUUID->
  "7f2d3cd7-4627-4b1c-909f-d8a7f65fd6b6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "50a8bc6a-932a-4dbb-99ee-f5780cad5f72"],
 " for the algebraic sigmoid, and stays near ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "2"}]], TraditionalForm]],ExpressionUUID->
  "40fa44bc-6832-4ac0-8a18-1098e9969aeb"],
 " for the arctan sigmoid."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"72c91a8a-5c78-4235-899a-1e7c3971cd3d"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.4*)
(* the ideal staircase S_N of hard steps, Eq. (1.3) *)
stepStair[vals_, xs_] := stairOn[UnitStep, vals, 1, xs];
gAll = Table[stairOn[sig3[k], f[nodes[10]], 200, xsFine],
   {k, Keys[sig3]}];
figure[{{
   ListLinePlot[Prepend[Transpose[{xsFine, #}] & /@ gAll,
     Transpose[{xsFine, f[xsFine]}]],
    PlotStyle -> Prepend[ColorData[97] /@ {1, 2, 3},
      Directive[Black, Dashed]], PlotRange -> All,
    PlotLegends -> Placed[LineLegend[Prepend[Keys[sig3], \"f\"],
       LabelStyle -> Directive[figFont - 3]], Below],
    PlotLabel -> \"1.2a. G for N = 10, \[Lambda] = 200\",
    LabelStyle -> figStyle, ImageSize -> wFull]}, {
   ListLogPlot[Transpose[{xsFine, Abs[# - stepStair[f[nodes[10]],
          xsFine]] + 10.^-16}] & /@ gAll,
    Joined -> True, PlotStyle -> ColorData[97] /@ {1, 2, 3},
    PlotRange -> {10^-10, 1}, GridLines -> {nodes[10], None},
    PlotLegends -> Placed[LineLegend[Keys[sig3],
       LabelStyle -> Directive[figFont - 3]], Below],
    PlotLabel -> \"1.2b. |G - S| on a log scale; grid lines at nodes\",
    LabelStyle -> figStyle, ImageSize -> wFull]}},
 \"Figure 1.2. Staircases with the three S-shapes\"]\
\>", "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"8377fa5e-cdd4-4e5b-a267-9358e51a2a5a"],

