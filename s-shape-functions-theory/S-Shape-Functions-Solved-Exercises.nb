Cell[CellGroupData[{

Cell["How large must \[Lambda] be?", "Subsection",ExpressionUUID->"832a94eb-8de6-40ee-a6d4-2c70764e0de2"],

Cell[TextData[{
 "Setting the leakage equal to a tolerance \[Eta] and solving for \[Lambda] \
gives the answer to the question. Write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "1"], TraditionalForm]],ExpressionUUID->
  "c817dba0-9c5a-467f-90d5-dc936b1adcf0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "2"], TraditionalForm]],ExpressionUUID->
  "7fb5de61-9c89-4bb6-8b22-0d5d9943aaeb"],
 " for the largest leakage of the arctan and algebraic sigmoids at \[Lambda] \
= 1, computed from Eq. (1.4) with the leading terms; then the leakage is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "1"], TraditionalForm]],ExpressionUUID->
  "bd4b057f-fb0c-4ac6-8114-6006fcbb4ccc"],
 "/\[Lambda] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "2"], TraditionalForm]],ExpressionUUID->
  "55cb607e-f665-48ea-886a-9d4e443a23c7"],
 "/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "2"], TraditionalForm]],ExpressionUUID->
  "46936604-a017-4e6b-9dc4-895446649f5c"],
 ", and"
}], "Text",ExpressionUUID->"9b824a53-3e1e-4c41-8cb5-73671130a4be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", 
      StyleBox["logistic",
       FontSlant->"Plain"]], "\[TildeTilde]", 
     RowBox[{"2", "N", " ", 
      RowBox[{"log", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"|", 
          SubscriptBox["\[CapitalDelta]", "N"], "|"}], "\[Eta]"], ")"}]}]}]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["\[Lambda]", 
      StyleBox["arctan",
       FontSlant->"Plain"]], "\[TildeTilde]", 
     FractionBox[
      SubscriptBox["L", "1"], "\[Eta]"]}], 
    RowBox[{",", "    "}], 
    RowBox[{
     SubscriptBox["\[Lambda]", 
      StyleBox["algebraic",
       FontSlant->"Plain"]], "\[TildeTilde]", 
     SqrtBox[
      FractionBox[
       SubscriptBox["L", "2"], "\[Eta]"]]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "1.5", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"6a2cad45-47ae-42cd-8a62-4a390df5a0d0"],

Cell[TextData[{
 "Table 1.4. The \[Lambda] needed for a leakage of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]],ExpressionUUID->
  "c12eb8ea-e33b-4f2a-b2e6-49f948148dda"],
 ", found by root finding, against Eq. (1.5)."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"01819512-d7ca-4214-868f-095c5754fd05"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.7*)
(* the \[Lambda] that brings the leakage down to \[Eta] = 10^-3, measured *)
lamNeed[s_, n_, eta_] := Exp[l /. FindRoot[
     Log[Max[leak[s, n, Exp[l]], 10.^-300]] == Log[eta],
     {l, Log[40. n]}]];
(* and predicted: logistic from the end point, the others from
   Eq. (1.4) scaled by 1/\[Lambda] or 1/\[Lambda]\.b2, Eq. (1.5) *)
lamPred[n_, eta_] := {
   2 n Log[Abs[Last@Differences[f[nodes[n]]]]/eta],
   predLeak[\"arctan\", n, 1]/eta,
   Sqrt[predLeak[\"algebraic\", n, 1]/eta]};
table[Prepend[
  Flatten[Table[{
     {n, \"measured\", Sequence @@ (Round[lamNeed[sig3[#], n, 10.^-3]] &
         /@ Keys[sig3])},
     {\"\", \"Eq. (1.5)\", Sequence @@ Round[lamPred[n, 10.^-3]]}},
    {n, {10, 20, 40}}], 1],
  {\"N\", \"\", \"logistic\", \"arctan\", \"algebraic\"}], \"Table 1.4\"]\
\>", "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"79a96cd9-fdd2-427d-929e-9c678102ad81"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    GridBox[{{
      "\"N\"", "\"\"", "\"logistic\"", "\"arctan\"", "\"algebraic\""}, {
      "10", "\"measured\"", "130", "5790", "268"}, {
      "\"\"", "\"Eq. (1.5)\"", "131", "5790", "268"}, {
      "20", "\"measured\"", "235", "6279", "401"}, {
      "\"\"", "\"Eq. (1.5)\"", "235", "6279", "403"}, {
      "40", "\"measured\"", "415", "7903", "581"}, {
      "\"\"", "\"Eq. (1.5)\"", "416", "7903", "585"}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
     GridBoxBackground -> {
      "Columns" -> {{None}}, "RowsIndexed" -> {1 -> GrayLevel[0.92]}}, 
     GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
     GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings -> {"Columns" -> {{0.8}}, "Rows" -> {{0.5}}}, 
     BaseStyle -> {FontSize -> 10}], "Grid"], 
   StyleBox["\"Table 1.4\"", Bold, FontSize -> 11, StripOnInput -> False]},
  "Labeled",
  DisplayFunction->(GridBox[{{
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}, {
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, 
    GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
    BaselinePosition -> {2, 1}]& ),
  InterpretationFunction->(RowBox[{"Labeled", "[", 
     RowBox[{#, ",", #2, ",", "Top", ",", 
       RowBox[{"{", "}"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.003795418988804*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"7ebbb547-ad93-4d2c-afb2-c589ca6610c7"]
}, Open  ]],

Cell[TextData[{
 "For N = 20 the arctan sigmoid needs \[Lambda] \[TildeTilde] 6300, 27 times \
more than the logistic; the algebraic sigmoid needs 1.7 times more. The \
logistic requirement grows roughly in proportion to N and the arctan \
requirement only logarithmically (through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "1"], TraditionalForm]],ExpressionUUID->
  "8a25ca75-4655-4e73-baa4-819b18f8b83c"],
 "), so the ratio shrinks as N grows, but for any tolerance the order \
logistic < algebraic < arctan holds, and the gap widens as \[Eta] shrinks, \
because of Eq. (1.2)."
}], "Text",ExpressionUUID->"8a19b31a-a0e8-4ae8-9538-06898d17d4d6"],

Cell["\<\
Figure 1.4. The signed leakage at every node, N = 20, \[Lambda] = 400. For \
the logistic and algebraic sigmoids the contributions of neighbouring steps \
cancel in the interior. For the arctan sigmoid they do not: the leakage \
follows the shape of -sin(2\[Pi]x), and Eq. (1.4) (dashed) reproduces it \
point by point.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"089f55ea-8c34-49ea-baf6-8a87a45fff07"],

Cell[CellGroupData[{

Cell["\<\
(*c.1.8*)
(* where the leakage sits: signed error at each node, N = 20, \[Lambda] = \
400;
   dashed: the arctan prediction of Eq. (1.4) *)
Legended[Show[
  ListPlot[Table[Transpose[{nodes[20], leakAt[sig3[k], 20, 400]}],
    {k, Keys[sig3]}], Joined -> True, PlotMarkers -> Automatic,
   PlotStyle -> (ColorData[97] /@ {1, 2, 3}), PlotRange -> All,
   AxesLabel -> {\"x = k/N\", \"G(x) - f(x)\"},
   PlotLabel -> \"Figure 1.4. Leakage at the nodes, N = 20, \[Lambda] = \
400\",
   LabelStyle -> figStyle, ImageSize -> wFull],
  ListLinePlot[Transpose[{nodes[20], predAt[\"arctan\", 20, 400]}],
   PlotStyle -> Directive[Black, Dashed]]],
 Placed[LineLegend[Append[ColorData[97] /@ {1, 2, 3},
    Directive[Black, Dashed]], Append[Keys[sig3], \"arctan, Eq. (1.4)\"],
   LabelStyle -> Directive[figFont - 3], LegendLayout -> \"Row\"], Below]]\
\>", "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"497c8f54-4db1-432a-a408-14c95e0dd519"],

