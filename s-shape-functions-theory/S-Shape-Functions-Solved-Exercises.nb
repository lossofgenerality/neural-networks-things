         StyleBox["\"13.82\"", ShowStringCharacters -> False], 
         13.815509557963773`, AutoDelete -> True], NumberForm[#, 4]& ]}, {
      "\"arctan\"", "1", 
       TagBox[
        FormBox[
         RowBox[{"cot", "(", 
           RowBox[{"\[Pi]", " ", "\[Eta]"}], ")"}], TraditionalForm], 
        TraditionalForm, Editable -> True], 
       TagBox[
        InterpretationBox[
         StyleBox[
          RowBox[{"\"2.7\"", "\[Times]", 
            SuperscriptBox["10", "\"-11\""]}], ShowStringCharacters -> False],
          2.67554414631584*^-11, AutoDelete -> True], ScientificForm[#, 2]& ], 
       TagBox[
        InterpretationBox[
         StyleBox["\"31.82\"", ShowStringCharacters -> False], 
