Cell[CellGroupData[{

Cell["A version without positivity", "Subsection",ExpressionUUID->"c592edcc-83dc-48a5-8637-0bc3aac67b3b"],

Cell["\<\
Using cubes instead of the logarithm gives a superposition valid for all real \
x, y, z, zeros and negatives included:\
\>", "Text",ExpressionUUID->"23e33101-bbd3-4b68-8b4f-80dafe7922ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "y", "z"}], "=", 
    RowBox[{
     FractionBox["1", "24"], 
     RowBox[{"[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "y", "+", "z"}], ")"}], "3"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "y", "-", "z"}], ")"}], "3"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "y", "+", "z"}], ")"}], "3"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "y", "-", "z"}], ")"}], "3"]}], "]"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "4.3", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"25e6a04b-aed4-4e02-8e20-bcf2df1ba16d"],

Cell[TextData[{
 "It uses four branches of Eq. (M8), with linear inner functions \
\[PlusMinus]x, \[PlusMinus]y, \[PlusMinus]z and the outer functions \
\[PlusMinus]s\.b3/24. Since the inner functions are linear, this is also a \
network of the Cybenko form, Eq. (M3), with activation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["t", "3"], TraditionalForm]],ExpressionUUID->
  "216e215a-236f-483f-93a9-10747283e289"],
 " and four units. It is exact for this one product, while Problem 3 shows \
that the same activation cannot approximate functions in general. In the same \
way, the identity x y = ((x + y)^2 - (x - y)^2)/4 of c.16 in the main \
notebook is a two-branch superposition of the product of two variables."
}], "Text",ExpressionUUID->"0187da5c-1a91-4aa2-b959-8e62426790e9"],

Cell["\<\
The four-cube identity on 10000 random points of [-1, 1]\.b3, and at a point \
with a zero coordinate.\
\>", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"628edbb6-2459-421a-ae35-eca5a3ecec28"],

Cell[CellGroupData[{

Cell["\<\
(*c.4.6*)
(* the four-cube form of Eq. (4.3) on [-1, 1]\.b3, zeros included:
   four branches with linear inner functions \[PlusMinus]x and one outer
   function \[CapitalPhi](s) = \[PlusMinus] s\.b3/24 *)
cubeBranches[{x_, y_, z_}] := {(x + y + z)^3, -(x + y - z)^3,
    -(x - y + z)^3, (x - y - z)^3}/24;
SeedRandom[6];
pts3 = RandomReal[{-1, 1}, {10000, 3}];
<|\"largest error on 10000 points of [-1, 1]\.b3\" ->
   Max@Abs[(Total@*cubeBranches /@ pts3) - (Times @@@ pts3)],
  \"at a point with a zero coordinate\" ->
   Total@cubeBranches[{0., 0.7, -0.3}]|>\
\>", "Input",
 CellLabel->
  "In[157]:=",ExpressionUUID->"1b0e14ee-4d5e-4eac-afb5-dd67ed163009"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"largest error on 10000 points of [-1, 1]\.b3\"\>", "\[Rule]", 
    "3.3306690738754696`*^-16"}], ",", 
   RowBox[{"\<\"at a point with a zero coordinate\"\>", "\[Rule]", "0.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0037954228556643`*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"ee177351-adca-4645-8e91-5bee5c0f47e5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Answer", "Subsection",ExpressionUUID->"ba883a51-7bd0-4d17-92d0-74699335e735"],

Cell[TextData[{
 "For positive x, y, z: x y z = exp(ln x + ln y + ln z), Eq. (4.1). In the \
form of Eq. (M8) with n = 3 this is the branch q = 0 with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", 
    RowBox[{"p", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "f20b3ee3-e983-4ff9-a1e1-6caa526f399b"],
 " = ln and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", "0"], TraditionalForm]],ExpressionUUID->
  "6fc1b447-d617-4dff-942f-298063681444"],
 " = exp; the other six branches have ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", "q"], TraditionalForm]],ExpressionUUID->
  "d19b3d47-0d0e-45fe-a275-4d1c0aa06e69"],
 " = 0, Eq. (4.2). For all real inputs, the four-cube identity Eq. (4.3) does \
the same with linear inner functions."
}], "Text",ExpressionUUID->"0129a417-77bd-4d86-bf09-f36cb245f736"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Problem 5: BasicRecurrentLayer as a Cybenko sum", "Section",ExpressionUUID->"015d435b-ca03-4484-94fb-7a1bf51ffe55"],

Cell[TextData[{
 StyleBox["Problem 5. ",
  FontWeight->"Bold"],
 "Show that one step of BasicRecurrentLayer, tanh(W x + U h + b), is a \
Cybenko-type sum when you take (x, h) as the input. Draw its graph in the \
style of Figure M3. Which arrow would you add to make it recurrent?"
}], "Text",ExpressionUUID->"be4ea8e6-7129-45e0-8298-a55bd4f24525"],

Cell[CellGroupData[{

Cell["One step is a Cybenko sum", "Subsection",ExpressionUUID->"c1f11c4a-2f32-479c-b428-e2bfa8723bd5"],

Cell["\<\
BasicRecurrentLayer with input size n and state size m computes, at each time \
t,\
\>", "Text",ExpressionUUID->"1eec35fb-b181-4192-bfba-0d67519439dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["h", "t"], "=", 
    RowBox[{"tanh", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"W", " ", 
        SubscriptBox["x", "t"]}], "+", 
       RowBox[{"U", " ", 
        SubscriptBox["h", 
         RowBox[{"t", "-", "1"}]]}], "+", "b"}], ")"}]}]}], "        ", 
   StyleBox[
    RowBox[{"(", "5.1", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"e1375ed5-514c-432b-99d1-c9433f422a99"],

Cell[TextData[{
 "with an m \[Times] n matrix W, an m \[Times] m matrix U and a bias vector \
b. Two facts turn this into Eq. (M3). First, tanh is a rescaled logistic, \
tanh s = 2\[Sigma](2s) - 1, Eq. (M2). Second, a constant is itself a hidden \
unit: -1 = -2\[Sigma](0\[CenterDot]z + 0). Join the input and the old state \
into one vector z = (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "7382ee82-ba62-447c-9215-1a26c9338689"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    RowBox[{"t", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "bc067c61-7ffe-4d4b-a561-5d3945b21c5e"],
 ") of length n + m. Then component i of the new state is"
}], "Text",ExpressionUUID->"9c76fbc8-fc84-4ebe-9d90-7f7cc7950098"],

Cell[BoxData[
 FormBox[
  RowBox[{GridBox[{
     {
      StyleBox[
       RowBox[{
        SubscriptBox["h", 
         RowBox[{"t", ",", "i"}]], "=", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"\[Sigma]", 
           RowBox[{"(", 
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                UnderscriptBox["\[Sum]", "k"], 
                RowBox[{
                 SubscriptBox["W", "ik"], 
                 SubscriptBox["x", 
                  RowBox[{"t", ",", "k"}]]}]}], "+", 
               RowBox[{
                UnderscriptBox["\[Sum]", "l"], 
                RowBox[{
                 SubscriptBox["U", "il"], 
                 SubscriptBox["h", 
                  RowBox[{"t", "-", "1", ",", "l"}]]}]}], "+", 
               SubscriptBox["b", "i"]}], ")"}]}], ")"}]}]}], "-", 
         RowBox[{"2", 
          RowBox[{"\[Sigma]", 
           RowBox[{"(", "0", ")"}]}]}]}]}],
       ScriptLevel->0]},
     {
      StyleBox[
       RowBox[{"=", 
        RowBox[{
         UnderscriptBox["\[Sum]", "j"], 
         RowBox[{
          SubscriptBox["\[Alpha]", "ij"], " ", 
          RowBox[{"\[Sigma]", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["y", "j"], "\[CenterDot]", "z", "+", 
             SubscriptBox["\[Theta]", "j"]}], ")"}]}]}]}], 
        RowBox[{",", "  "}], 
        RowBox[{"z", "=", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["x", "t"], ",", 
           SubscriptBox["h", 
            RowBox[{"t", "-", "1"}]]}], ")"}]}], "\[Element]", 
        SuperscriptBox["\[DoubleStruckCapitalR]", 
         RowBox[{"n", "+", "m"}]]}],
       ScriptLevel->0]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.8}}}], "        ", 
   StyleBox[
    RowBox[{"(", "5.2", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"b0d985b9-2e7c-4750-afe2-29e76a4b9c0e"],

Cell[TextData[{
 "Each component is a sum of Eq. (M3) on the cube of inputs z. It uses two \
units: unit i, with inner weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "29562942-40f5-4e70-bebb-3c2eef204e2b"],
 " = 2(row i of W, row i of U), offset ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "i"], TraditionalForm]],ExpressionUUID->
  "d5878c9a-ca58-490b-8bda-8d48c6be71da"],
 " = 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "i"], TraditionalForm]],ExpressionUUID->
  "2858fbb7-b711-49ab-a034-071a11ff1668"],
 " and outer weight 2, and a constant unit with y = 0, \[Theta] = 0 and outer \
weight -2. The whole new state is such a sum for each i, with the same hidden \
units shared and the outer weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "ij"], TraditionalForm]],ExpressionUUID->
  "a20b80db-8509-42b7-9696-afce3330df74"],
 " = 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "ij"], TraditionalForm]],ExpressionUUID->
  "04817ec3-ef94-4d51-ad78-090447034631"],
 ". The step is a one-hidden-layer network in which the hidden layer and the \
output layer have the same size m. So by Theorem M2 a single step can be \
approximated in the other direction too: with enough units, a sum of this \
form can follow any continuous update rule for the state."
}], "Text",ExpressionUUID->"1b6406e8-de60-4e65-bf8f-5e18fc44bd7d"],

Cell["Both facts, checked symbolically.", "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"4ba07235-e356-49f9-bd2d-c5a7f024484c"],

Cell[CellGroupData[{

Cell["\<\
(*c.5.1*)
(* the two facts used in Eq. (5.2): tanh is a rescaled logistic, and a
   constant is itself one hidden unit with zero input weights *)
<|\"tanh s - (2 \[Sigma](2 s) - 1)\" -> FullSimplify[
    TrigToExp[Tanh[s] - (2 LogisticSigmoid[2 s] - 1)]],
  \"-1 = -2 \[Sigma](0 \[CenterDot] z + 0)\" -> (-1 == -2 \
LogisticSigmoid[0])|>\
\>", "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"e0ca5f05-68a3-4b99-8a23-aa8162cd8555"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"tanh s - (2 \[Sigma](2 s) - 1)\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"-1 = -2 \[Sigma](0 \[CenterDot] z + 0)\"\>", "\[Rule]", 
    "True"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.003795422862761*^9},
 CellLabel->
  "Out[165]=",ExpressionUUID->"71b94570-6270-40a8-8826-77b664285901"]
}, Open  ]],

Cell["\<\
A numerical check against the real layer. BasicRecurrentLayer is initialized \
with random weights, its biases are set to nonzero values, and it is run on a \
sequence of 40 inputs in three ways: by the layer itself, by the tanh \
recursion Eq. (5.1), and by the Cybenko sums Eq. (5.2).\
\>", "Text",ExpressionUUID->"5d22dc98-fad4-4417-b41a-ff92628fbd3d"],

Cell[TextData[{
 "Table 5.1. The weights of the layer and the agreement of the three \
computations. The layer computes in single precision, so it agrees with the \
other two to about ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]],ExpressionUUID->
  "b86ed53c-665c-4fd2-8712-83dde2645cd1"],
 "; the tanh recursion and the Cybenko sums agree to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "16"}]], TraditionalForm]],ExpressionUUID->
  "606e3562-0f92-4d92-b46d-a5ec2e97957d"],
 "."
}], "Caption",
 FontFamily->"Source Sans Pro",
 FontSize->14,ExpressionUUID->"6c70878b-b355-4399-bb15-32c35d4f7072"],

Cell[CellGroupData[{

Cell["\<\
(*c.5.2*)
(* a real BasicRecurrentLayer with input size n = 2 and state size m = 2;
   its weights, then three ways to run it on the same sequence *)
(* the initializer sets the biases to 0; give them nonzero values *)
rnn = NetReplacePart[
   NetInitialize[BasicRecurrentLayer[2, \"Input\" -> {\"Varying\", 2}],
    RandomSeeding -> 5], \"Biases\" -> {0.3, -0.4}];
{W, U, b} = Normal@NetExtract[rnn, #] & /@
   {\"InputWeights\", \"StateWeights\", \"Biases\"};
seq = Table[{Sin[t/3.], Cos[t/5.]}, {t, 40}];
(* 1: the layer itself *)
hLayer = rnn[seq];
(* 2: the recursion h_t = tanh(W x_t + U h_{t-1} + b), h_0 = 0 *)
hTanh = Rest@FoldList[Tanh[W . #2 + U . #1 + b] &, {0., 0.}, seq];
(* 3: the same step as a Cybenko sum of Eq. (5.2), input z = (x, h) *)
Yc = 2 Join[W, U, 2]; thc = 2 b;
cybenkoStep[h_, x_] := 2 LogisticSigmoid[Yc . Join[x, h] + thc] -
   2 LogisticSigmoid[0. Yc . Join[x, h]];
hCyb = Rest@FoldList[cybenkoStep, {0., 0.}, seq];
mat[m_] := MatrixForm[Map[NumberForm[#, 3] &, m, {-1}]];
table[{{\"quantity\", \"value\"},
  {\"W (input weights)\", mat[W]},
  {\"U (state weights)\", mat[U]},
  {\"b (biases)\", NumberForm[b, 3]},
  {\"max |layer - tanh recursion|\", sci@Max@Abs[hLayer - hTanh]},
  {\"max |layer - Cybenko sums|\", sci@Max@Abs[hLayer - hCyb]},
  {\"max |tanh recursion - Cybenko sums|\", sci@Max@Abs[hTanh - hCyb]}},
 \"Table 5.1\"]\
\>", "Input",
 CellLabel->
  "In[166]:=",ExpressionUUID->"de8f392a-6ed7-4c71-a4c2-06de9ebdeea5"],

